{# Une offre d'emploi PUBLIQUE (/emplois/{id}) et son formulaire de candidature, piloté par assets/job-application.js
   (POST /emplois/{id}/candidater, multipart). Le script ne fait qu'un contrôle de confort (poids des fichiers) : le SERVEUR contrôle
   tout (type réel des fichiers lu dans leur contenu, doublon, nombre d'envois par heure, offre encore ouverte).
   Le champ « website » est un piège à robots : invisible pour une personne, il doit rester vide.
   Textes : translations/recruitment.<langue>.yaml (FR / EN / ES). #}
{% extends 'base.html.twig' %}
{% trans_default_domain 'recruitment' %}
{% block title %}{{ offer.title }} — {{ 'jobs.page_title'|trans }}{% endblock %}

{% block body %}
{% set field = 'w-full rounded-xl border border-slate-200 px-3 py-2 text-xs focus:border-black focus:outline-none' %}
{% set fileField = 'block w-full text-xs text-slate-600 file:mr-3 file:rounded-xl file:border-0 file:bg-slate-900 file:px-3 file:py-2 file:text-xs file:font-semibold file:text-white' %}

<div data-job-apply data-endpoint="{{ path('app_job_apply', {id: offer.id.toRfc4122}) }}" data-max-file-mb="{{ limits.fileMb }}" data-max-total-mb="{{ limits.totalMb }}"
     class="mx-auto max-w-3xl space-y-6 p-4 pb-20 sm:p-8">

    <div class="space-y-3 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
        <a href="{{ path('app_jobs') }}" class="text-[11px] font-semibold text-slate-500 hover:text-black">← {{ 'jobs.back'|trans }}</a>
        <div class="flex flex-wrap items-start justify-between gap-2">
            <h1 class="text-2xl font-black text-slate-950">{{ offer.title }}</h1>
            <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold text-slate-700">{{ ('contract.' ~ offer.contractType.value)|trans }}</span>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-slate-500">
            {% if offer.location %}<span class="inline-flex items-center gap-1">{{ ux_icon('tabler:map-pin', {class: 'h-3.5 w-3.5'}) }}{{ offer.location }}</span>{% endif %}
            {% if offer.department %}<span class="inline-flex items-center gap-1">{{ ux_icon('tabler:building', {class: 'h-3.5 w-3.5'}) }}{{ offer.department }}</span>{% endif %}
            {% if offer.closingDate %}<span class="inline-flex items-center gap-1">{{ ux_icon('tabler:calendar-event', {class: 'h-3.5 w-3.5'}) }}{{ 'jobs.closing_on'|trans({'%date%': offer.closingDate|format_date('long', locale: app.request.locale, timezone: offer.closingDate.getTimezone().getName())}) }}</span>{% endif %}
        </div>

        <h2 class="pt-2 text-sm font-bold text-slate-900">{{ 'jobs.description'|trans }}</h2>
        <p class="whitespace-pre-line text-sm leading-relaxed text-slate-700">{{ offer.description }}</p>

        {% if offer.profile %}
            <h2 class="pt-2 text-sm font-bold text-slate-900">{{ 'jobs.profile'|trans }}</h2>
            <p class="whitespace-pre-line text-sm leading-relaxed text-slate-700">{{ offer.profile }}</p>
        {% endif %}
    </div>

    <div data-job-sent role="status" class="hidden items-start gap-3 rounded-3xl border border-emerald-200 bg-emerald-50 p-6 text-sm text-emerald-900">
        {{ ux_icon('tabler:circle-check', {class: 'mt-0.5 h-5 w-5 shrink-0'}) }}
        <div class="space-y-1">
            <p class="font-bold">{{ 'apply.sent_title'|trans }}</p>
            <p class="text-xs leading-relaxed">{{ 'apply.sent'|trans }}</p>
            <a href="{{ path('app_jobs') }}" class="inline-block pt-1 text-xs font-bold underline underline-offset-4">{{ 'jobs.back'|trans }}</a>
        </div>
    </div>

    <form data-job-form method="post" action="{{ path('app_job_apply', {id: offer.id.toRfc4122}) }}" enctype="multipart/form-data" novalidate class="space-y-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
        <div>
            <h2 class="text-lg font-black text-slate-950">{{ 'apply.title'|trans }}</h2>
            <p class="text-xs text-slate-500">{{ 'apply.intro'|trans }}</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label for="job-name" class="mb-1 block text-[11px] font-bold text-slate-600">{{ 'apply.name'|trans }}</label>
                <input id="job-name" name="name" type="text" required maxlength="120" autocomplete="name" class="{{ field }}">
            </div>
            <div>
                <label for="job-email" class="mb-1 block text-[11px] font-bold text-slate-600">{{ 'apply.email'|trans }}</label>
                <input id="job-email" name="email" type="email" required maxlength="180" autocomplete="email" class="{{ field }}">
            </div>
        </div>
        <div>
            <label for="job-phone" class="mb-1 block text-[11px] font-bold text-slate-600">{{ 'apply.phone'|trans }}</label>
            <input id="job-phone" name="phone" type="tel" required maxlength="32" autocomplete="tel" placeholder="034 12 345 67" class="{{ field }}">
            <p class="mt-1 text-[11px] text-slate-500">{{ 'apply.phone_help'|trans }}</p>
        </div>
        <div>
            <label for="job-message" class="mb-1 block text-[11px] font-bold text-slate-600">{{ 'apply.message'|trans }}</label>
            <textarea id="job-message" name="message" rows="5" maxlength="{{ limits.messageMax }}" class="{{ field }}"></textarea>
            <p class="mt-1 text-[11px] text-slate-500">{{ 'apply.message_help'|trans({'%max%': limits.messageMax}) }}</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label for="job-cv" class="mb-1 block text-[11px] font-bold text-slate-600">{{ 'apply.cv'|trans }}</label>
                <input id="job-cv" name="cv" type="file" required accept="application/pdf,image/jpeg,image/png,.pdf,.jpg,.jpeg,.png" class="{{ fileField }}">
            </div>
            <div>
                <label for="job-letter" class="mb-1 block text-[11px] font-bold text-slate-600">{{ 'apply.letter'|trans }}</label>
                <input id="job-letter" name="letter" type="file" accept="application/pdf,image/jpeg,image/png,.pdf,.jpg,.jpeg,.png" class="{{ fileField }}">
            </div>
        </div>
        <p class="text-[11px] text-slate-500">{{ 'apply.files_help'|trans({'%mb%': limits.fileMb, '%total%': limits.totalMb}) }}</p>

        {# Piège à robots : hors écran (style en ligne : il ne dépend pas de la compilation de Tailwind), ignoré des lecteurs d'écran et du clavier. Une personne ne le remplit jamais. #}
        <div style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden" aria-hidden="true">
            <label for="job-website">Website</label>
            <input id="job-website" name="website" type="text" tabindex="-1" autocomplete="off">
        </div>

        <p data-form-message role="alert" class="hidden rounded-xl px-3 py-2 text-xs font-semibold"></p>
        <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="max-w-md text-[11px] leading-relaxed text-slate-500">{{ 'apply.privacy'|trans }}</p>
            <button type="submit" class="rounded-2xl bg-black px-6 py-2.5 text-xs font-bold text-white transition-colors hover:bg-neutral-800 disabled:opacity-60">{{ 'apply.send'|trans }}</button>
        </div>
    </form>
</div>
{% endblock %}
