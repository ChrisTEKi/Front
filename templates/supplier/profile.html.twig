{% extends 'supplier/_layout.html.twig' %}
{% import 'macros/forms.html.twig' as f %}
{% block title %}{{ 'Profil & versements — Espace fournisseur — GoBuy'|trans }}{% endblock %}

{% block supplier_content %}
<div class="grid gap-6 lg:grid-cols-3">
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'space-y-5 lg:col-span-2'}}) }}
        <section class="space-y-4 rounded-3xl border border-slate-200 bg-white p-5 shadow-xs sm:p-6">
            <h2 class="text-sm font-black text-slate-950">{{ 'Ma boutique'|trans }}</h2>
            {{ f.field(form.shopName) }}
            {{ f.field(form.description) }}
            <div class="grid gap-4 sm:grid-cols-2">
                {{ f.field(form.contactRole) }}
                {{ f.field(form.businessEmail) }}
                {{ f.field(form.phone) }}
                {{ f.field(form.city) }}
            </div>
            {{ f.field(form.address) }}
        </section>
        <section class="space-y-4 rounded-3xl border border-slate-200 bg-white p-5 shadow-xs sm:p-6">
            <h2 class="text-sm font-black text-slate-950">{{ 'Versement de mes ventes'|trans }}</h2>
            <div class="grid gap-4 sm:grid-cols-2">
                {{ f.field(form.payoutMethod) }}
                {{ f.field(form.payoutAccount) }}
            </div>
        </section>
        <button type="submit" class="rounded-2xl bg-emerald-600 px-6 py-3 text-xs font-bold text-white shadow-md shadow-emerald-600/25 hover:bg-emerald-700">{{ 'Enregistrer'|trans }}</button>
    {{ form_end(form) }}

    <aside class="space-y-5">
        <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs">
            <h2 class="mb-3 text-sm font-black text-slate-950">{{ 'Mon contrat'|trans }}</h2>
            <dl class="space-y-2 text-xs">
                <div class="flex justify-between"><dt class="text-slate-500">{{ 'Formule'|trans }}</dt><dd class="font-bold">{{ supplier.plan.label|trans }}</dd></div>
                <div class="flex justify-between"><dt class="text-slate-500">{{ 'Loyer mensuel'|trans }}</dt><dd class="font-bold">{{ supplier.plan.monthlyRent|ar }}</dd></div>
                <div class="flex justify-between"><dt class="text-slate-500">{{ 'Rayon principal'|trans }}</dt><dd class="font-bold">{{ category_name(supplier.mainCategory) }}</dd></div>
                <div class="flex justify-between"><dt class="text-slate-500">{{ 'Inscrit le'|trans }}</dt><dd class="font-bold">{{ supplier.createdAt|date('d/m/Y') }}</dd></div>
                {% if supplier.reviewedAt %}<div class="flex justify-between"><dt class="text-slate-500">{{ 'Dernière décision'|trans }}</dt><dd class="font-bold">{{ supplier.reviewedAt|date('d/m/Y') }}</dd></div>{% endif %}
            </dl>
            <p class="mt-3 text-[11px] text-slate-400">{{ 'Pour changer de formule, contactez le support : la modification est effectuée par notre équipe.'|trans }}</p>
        </section>
    </aside>
</div>
{% endblock %}
