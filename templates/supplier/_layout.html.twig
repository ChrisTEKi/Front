{% extends 'base.html.twig' %}
{# Shared frame of the supplier space: identity, validation status banner and navigation.
   Children set `section` (dashboard|products|orders|customers|profile) and fill `supplier_content`. #}
{% block title %}{{ 'Espace fournisseur — GoBuy'|trans }}{% endblock %}

{% block body %}
{% set nav = [
    {id: 'dashboard', label: 'Vue d\'ensemble'|trans, route: 'app_supplier_dashboard', icon: 'tabler:chart-bar'},
    {id: 'products', label: 'Mes produits'|trans, route: 'app_supplier_products', icon: 'tabler:package'},
    {id: 'orders', label: 'Commandes'|trans, route: 'app_supplier_orders', icon: 'tabler:receipt'},
    {id: 'customers', label: 'Clients'|trans, route: 'app_supplier_customers', icon: 'tabler:users'},
    {id: 'profile', label: 'Profil & versements'|trans, route: 'app_supplier_profile', icon: 'tabler:building-store'},
] %}
<div class="mx-auto w-full max-w-[1400px] space-y-6 p-4 pb-16 sm:p-8 lg:p-10">

    <header class="flex flex-col justify-between gap-4 rounded-3xl border border-slate-200 bg-white p-5 shadow-xs sm:flex-row sm:items-center sm:p-6">
        <div class="flex items-center gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-slate-950 text-lg font-black text-emerald-400">{{ supplier.shopName|first|upper }}</span>
            <div class="min-w-0">
                <h1 class="truncate text-lg font-black text-slate-950">{{ supplier.shopName }}</h1>
                <p class="text-xs text-slate-500">{{ '%1% · %2% · Formule %3%'|trans({'%1%': (supplier.city), '%2%': (category_name(supplier.mainCategory)), '%3%': (supplier.plan.label|trans)}) }}</p>
            </div>
        </div>
        <span class="inline-flex w-fit items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold {{ supplier.status.badgeClasses }}">{{ supplier.status.label|trans }}</span>
    </header>

    {% if supplier.status.value == 'pending' %}
        <div class="flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-xs text-amber-900">
            {{ ux_icon('tabler:clock', {class: 'mt-0.5 h-5 w-5 shrink-0 text-amber-600'}) }}
            <div><p class="font-bold">{{ 'Dossier en cours de validation'|trans }}</p><p class="mt-0.5 text-amber-800">{{ 'Notre équipe examine votre candidature (48h ouvrées en moyenne). Vous recevrez un e-mail dès la décision ; vous pourrez alors publier vos produits. En attendant, vous pouvez compléter votre profil et vos informations de versement.'|trans }}</p></div>
        </div>
    {% elseif supplier.status.value == 'rejected' %}
        <div class="flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 p-4 text-xs text-red-800">
            {{ ux_icon('tabler:alert-circle', {class: 'mt-0.5 h-5 w-5 shrink-0 text-red-600'}) }}
            <div><p class="font-bold">{{ 'Dossier refusé'|trans }}</p><p class="mt-0.5">{{ 'Motif : %1%. Répondez à l\'e-mail reçu pour compléter votre dossier et demander un nouvel examen.'|trans({'%1%': (supplier.statusReason ?: 'non précisé'|trans)}) }}</p></div>
        </div>
    {% elseif supplier.status.value == 'suspended' %}
        <div class="flex items-start gap-3 rounded-2xl border border-slate-300 bg-slate-100 p-4 text-xs text-slate-800">
            {{ ux_icon('tabler:alert-circle', {class: 'mt-0.5 h-5 w-5 shrink-0 text-slate-600'}) }}
            <div><p class="font-bold">{{ 'Boutique suspendue'|trans }}</p><p class="mt-0.5">{{ 'Vos produits ne sont plus visibles. Motif : %1%. Contactez notre support pour la réactiver.'|trans({'%1%': (supplier.statusReason ?: 'non précisé'|trans)}) }}</p></div>
        </div>
    {% endif %}

    <nav aria-label="{{ 'Espace fournisseur'|trans }}" class="flex gap-1 overflow-x-auto rounded-2xl bg-slate-100 p-1">
        {% for item in nav %}
            <a href="{{ path(item.route) }}" {{ section == item.id ? 'aria-current="page"' : '' }}
               class="flex shrink-0 items-center gap-2 rounded-xl px-4 py-2 text-xs font-bold transition-colors {{ section == item.id ? 'bg-white text-slate-950 shadow-xs' : 'text-slate-600 hover:bg-white/60' }}">
                {{ ux_icon(item.icon, {class: 'h-4 w-4'}) }}{{ item.label }}
            </a>
        {% endfor %}
    </nav>

    {% block supplier_content %}{% endblock %}
</div>
{% endblock %}
