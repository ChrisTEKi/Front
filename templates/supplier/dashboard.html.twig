{# Espace Fournisseur (/fournisseur) : données RÉELLES lues en base par App\Supplier\SupplierDashboardProvider (variable `d`).
   Tous les textes viennent de translations/messages.<langue>.yaml (clés « supplier.* ») : FR / EN / ES.
   Ce qui n'existe pas encore (catalogue de produits, reversements) est annoncé clairement, sans faux boutons. #}
{% extends 'base.html.twig' %}
{% block title %}{{ 'supplier.page_title'|trans }}{% endblock %}

{% block body %}
{% set d = dashboard %}
{% set tones = {pending: 'border-amber-200 bg-amber-50 text-amber-900', approved: 'border-emerald-200 bg-emerald-50 text-emerald-900', rejected: 'border-rose-200 bg-rose-50 text-rose-900', suspended: 'border-rose-200 bg-rose-50 text-rose-900'} %}
{% set icons = {pending: 'tabler:alert-circle', approved: 'tabler:circle-check', rejected: 'tabler:alert-circle', suspended: 'tabler:alert-circle'} %}

<div data-supplier-dashboard class="mx-auto max-w-4xl space-y-6 p-4 sm:p-6">

    <div class="flex flex-col justify-between gap-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs sm:flex-row sm:items-center">
        <div>
            <span class="rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 font-mono text-[11px] font-bold uppercase tracking-wider text-slate-800">{{ 'supplier.badge'|trans }}</span>
            <h1 class="mt-2 text-xl font-black text-slate-950">{{ 'supplier.hello'|trans({'%company%': d.companyName}) }}</h1>
            <p class="text-xs text-slate-500">{{ 'supplier.subtitle'|trans }}</p>
        </div>
        {# Pas de catalogue de produits en base pour l'instant : le bouton est volontairement inactif (pas de formulaire qui perdrait la saisie). #}
        <button type="button" disabled title="{{ 'supplier.products.soon'|trans }}" class="flex cursor-not-allowed items-center gap-2 rounded-2xl bg-slate-200 px-4 py-2.5 text-xs font-bold text-slate-500">{{ ux_icon('tabler:plus', {class:'h-4 w-4'}) }}<span>{{ 'supplier.add_product'|trans }}</span><span class="rounded-full bg-white px-1.5 py-0.5 text-[9px] font-black uppercase text-slate-500">{{ 'supplier.add_product_soon'|trans }}</span></button>
    </div>

    {# Statut du dossier, décidé par un administrateur (pending | approved | rejected | suspended). #}
    <div data-supplier-status="{{ d.status }}" class="flex items-start gap-3 rounded-2xl border p-4 text-xs {{ tones[d.status]|default(tones.pending) }}">
        {{ ux_icon(icons[d.status]|default(icons.pending), {class: 'mt-0.5 h-4 w-4 shrink-0'}) }}
        <div class="space-y-0.5">
            <p class="font-bold">{{ ('supplier.status.' ~ d.status ~ '.title')|trans }}</p>
            {% if d.status in ['rejected', 'suspended'] %}
                <p>{{ d.rejectionReason ? 'supplier.status.reason'|trans({'%reason%': d.rejectionReason}) : 'supplier.status.no_reason'|trans }}</p>
            {% else %}
                <p>{{ ('supplier.status.' ~ d.status ~ '.text')|trans }}</p>
            {% endif %}
        </div>
    </div>

    <div data-supplier-tabs class="flex items-center gap-2 overflow-x-auto border-b border-slate-200 pb-2 text-xs font-semibold">
        {% for tab in [
            {id: 'dashboard', label: 'supplier.tab.dashboard'|trans},
            {id: 'products', label: 'supplier.tab.products'|trans({'%count%': 0})},
            {id: 'orders', label: 'supplier.tab.orders'|trans({'%count%': d.stats.orders})},
            {id: 'finances', label: 'supplier.tab.finances'|trans, icon: 'tabler:currency-dollar'},
            {id: 'profile', label: 'supplier.tab.profile'|trans}
        ] %}
            <button type="button" data-supplier-tab="{{ tab.id }}" class="flex shrink-0 items-center gap-1.5 rounded-xl px-3 py-1.5 text-slate-600 transition-colors hover:bg-slate-100">
                {% if tab.icon is defined %}{{ ux_icon(tab.icon, {class:'h-3.5 w-3.5'}) }}{% endif %}<span>{{ tab.label }}</span>
            </button>
        {% endfor %}
    </div>

    {# Lignes de commande (tableau réutilisé : vue d'ensemble = 5 dernières, onglet Commandes = toutes). #}
    {% macro orderRows(orders) %}
        <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left text-xs">
                <thead><tr class="border-b border-slate-200 text-[10px] font-bold uppercase text-slate-400">
                    <th class="px-3 py-2.5">{{ 'supplier.orders.col_number'|trans }}</th><th class="px-3 py-2.5">{{ 'supplier.orders.col_date'|trans }}</th><th class="px-3 py-2.5">{{ 'supplier.orders.col_items'|trans }}</th><th class="px-3 py-2.5 text-right">{{ 'supplier.orders.col_total'|trans }}</th><th class="px-3 py-2.5">{{ 'supplier.orders.col_status'|trans }}</th>
                </tr></thead>
                <tbody class="divide-y divide-slate-100">
                    {% for o in orders %}
                        <tr>
                            <td class="px-3 py-2.5 font-mono font-semibold text-slate-900">{{ o.number }}</td>
                            <td class="whitespace-nowrap px-3 py-2.5 text-slate-500">{{ o.createdAt|format_datetime('short', 'short', locale: app.request.locale) }}</td>
                            <td class="px-3 py-2.5 text-slate-600">{% for line in o.lines %}<div>{{ line }}</div>{% endfor %}</td>
                            <td class="whitespace-nowrap px-3 py-2.5 text-right font-mono font-bold text-slate-900">{{ o.total|format_number(locale: app.request.locale) }} Ar</td>
                            <td class="px-3 py-2.5"><span class="inline-flex whitespace-nowrap rounded-full px-2 py-0.5 text-[10px] font-bold {{ o.status == 'delivered' ? 'bg-emerald-100 text-emerald-800' : (o.status == 'cancelled' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800') }}">{{ ('status.' ~ o.status)|trans({}, 'orders') }}</span></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endmacro %}
    {% import _self as ui %}

    {# ---- VUE D'ENSEMBLE ---- #}
    <div data-supplier-panel="dashboard" class="hidden space-y-6">
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs"><span class="text-xs font-medium text-slate-500">{{ 'supplier.stat.products'|trans }}</span><div class="mt-1 text-2xl font-black text-slate-950">0</div></div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs"><span class="text-xs font-medium text-slate-500">{{ 'supplier.stat.orders'|trans }}</span><div class="mt-1 text-2xl font-black text-slate-950">{{ d.stats.orders }}</div></div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs"><span class="text-xs font-medium text-slate-500">{{ 'supplier.stat.preparing'|trans }}</span><div class="mt-1 text-2xl font-black text-amber-600">{{ d.stats.preparing }}</div></div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs"><span class="text-xs font-medium text-slate-500">{{ 'supplier.stat.delivered'|trans }}</span><div class="mt-1 text-2xl font-black text-slate-950">{{ d.stats.delivered }}</div></div>
        </div>

        <div class="space-y-4 rounded-3xl border border-slate-200 bg-white p-5 shadow-xs sm:p-6">
            <div class="flex flex-col justify-between gap-3 border-b border-slate-100 pb-2 sm:flex-row sm:items-center">
                <div>
                    <div class="flex items-center gap-2"><span class="rounded-lg bg-slate-100 p-1.5 text-slate-900">{{ ux_icon('tabler:trending-up', {class:'h-4 w-4'}) }}</span>
                        <h3 class="text-sm font-black text-slate-950">{{ 'supplier.chart.title'|trans }}</h3></div>
                    <p class="mt-1 text-[11px] text-slate-500">{{ 'supplier.chart.subtitle'|trans }}</p>
                </div>
                <div class="inline-flex rounded-xl border border-slate-200 bg-slate-100 p-1 text-xs">
                    <button type="button" data-chart-metric="sales" class="rounded-lg bg-white px-3 py-1 text-[11px] font-black text-slate-950 shadow-xs">{{ 'supplier.chart.sales'|trans }}</button>
                    <button type="button" data-chart-metric="orders" class="rounded-lg px-3 py-1 text-[11px] font-bold text-slate-600 hover:text-slate-950">{{ 'supplier.chart.orders'|trans }}</button>
                </div>
            </div>
            <div class="grid grid-cols-3 gap-3 rounded-2xl border border-slate-200/80 bg-slate-50 p-3.5 text-xs">
                <div><span class="block text-[11px] text-slate-500">{{ 'supplier.chart.total'|trans }}</span><span class="font-mono text-sm font-black text-slate-950">{{ d.chart.totalSales|format_number(locale: app.request.locale) }} Ar</span></div>
                <div><span class="block text-[11px] text-slate-500">{{ 'supplier.chart.average'|trans }}</span><span class="font-mono text-sm font-bold text-slate-950">{{ d.chart.averageSales|format_number(locale: app.request.locale) }} Ar</span></div>
                <div><span class="block text-[11px] text-slate-500">{{ 'supplier.chart.peak'|trans }}</span><span class="block truncate font-mono text-sm font-bold text-slate-950">{{ d.chart.peak ? d.chart.peak|format_date('medium', locale: app.request.locale) : '—' }}</span></div>
            </div>
            {% if d.chart.totalSales > 0 or d.stats.orders > 0 %}
                {# Histogramme en HTML/CSS pur : une colonne par jour, hauteur proportionnelle au maximum de la période. #}
                {% for metric in ['sales', 'orders'] %}
                    <div data-chart-series="{{ metric }}" class="{{ metric == 'sales' ? 'flex' : 'hidden' }} h-56 items-end gap-2 rounded-2xl border border-slate-200/80 bg-slate-50/60 p-4">
                        {% for day in d.chart.days %}
                            {% set pct = metric == 'sales' ? day.salesPct : day.ordersPct %}
                            {% set tip = metric == 'sales'
                                ? 'supplier.chart.tip_sales'|trans({'%date%': day.date|format_date('medium', locale: app.request.locale), '%amount%': day.sales|format_number(locale: app.request.locale)})
                                : 'supplier.chart.tip_orders'|trans({'%date%': day.date|format_date('medium', locale: app.request.locale), '%count%': day.orders}) %}
                            <div class="flex h-full flex-1 flex-col items-center justify-end gap-1" title="{{ tip }}">
                                <div class="w-full rounded-t-lg {{ metric == 'sales' ? 'bg-emerald-500' : 'bg-slate-800' }}" style="height: {{ pct }}%"></div>
                                <span class="text-[10px] font-semibold text-slate-500">{{ day.date|format_date(pattern: 'EEE', locale: app.request.locale) }}</span>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
            {% else %}
                <div class="flex h-56 flex-col items-center justify-center gap-2 rounded-2xl border border-dashed border-slate-300 bg-slate-50/60 text-center">
                    {{ ux_icon('tabler:chart-line', {class:'h-8 w-8 text-slate-300'}) }}
                    <p class="text-xs font-semibold text-slate-500">{{ 'supplier.chart.empty_title'|trans }}</p>
                    <p class="max-w-xs text-[11px] text-slate-400">{{ 'supplier.chart.empty_text'|trans }}</p>
                </div>
            {% endif %}
        </div>

        <div class="space-y-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs">
            <div class="flex items-center justify-between"><h3 class="text-sm font-bold text-slate-900">{{ 'supplier.orders.recent'|trans }}</h3><button type="button" data-supplier-tab="orders" class="text-xs font-semibold text-slate-700 hover:text-slate-950 hover:underline">{{ 'supplier.orders.see_all'|trans }}</button></div>
            {% if d.recentOrders is empty %}
                <div class="rounded-2xl bg-slate-50 p-8 text-center text-xs text-slate-400">{{ 'supplier.orders.none'|trans }}</div>
            {% else %}
                {{ ui.orderRows(d.recentOrders) }}
            {% endif %}
        </div>
    </div>

    {# ---- PRODUITS : pas encore de catalogue fournisseur en base ---- #}
    <div data-supplier-panel="products" class="hidden">
        <div class="rounded-3xl border border-slate-200 bg-white p-10 text-center text-xs text-slate-400">
            {{ ux_icon('tabler:package', {class:'mx-auto mb-2 h-10 w-10 text-slate-300'}) }}
            <p class="font-semibold text-slate-500">{{ 'supplier.products.none'|trans }}</p>
            <p class="mt-1">{{ 'supplier.products.soon'|trans }}</p>
        </div>
    </div>

    {# ---- COMMANDES REÇUES ---- #}
    <div data-supplier-panel="orders" class="hidden space-y-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs">
        <h3 class="text-sm font-bold text-slate-900">{{ 'supplier.orders.title'|trans }}</h3>
        {% if d.orders is empty %}
            <div class="rounded-2xl bg-slate-50 p-8 text-center text-xs text-slate-400">{{ 'supplier.orders.none'|trans }}</div>
        {% else %}
            {{ ui.orderRows(d.orders) }}
            <p class="text-[11px] text-slate-400">{{ 'supplier.orders.privacy'|trans }}</p>
        {% endif %}
    </div>

    {# ---- PROFIL BOUTIQUE ---- #}
    <div data-supplier-panel="profile" class="hidden space-y-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs">
        <div class="relative flex h-36 items-center justify-center overflow-hidden rounded-2xl bg-slate-800">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
            <div class="absolute bottom-4 left-4 flex items-center gap-3">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white p-1 shadow-lg"><span class="flex h-full w-full items-center justify-center rounded-xl bg-slate-100 text-slate-400">{{ ux_icon('tabler:building-store', {class:'h-6 w-6'}) }}</span></div>
                <div class="text-white"><div class="flex items-center gap-1.5"><h3 class="text-base font-bold">{{ d.companyName }}</h3></div><p class="text-[11px] text-slate-300">{{ ('supplier.status.' ~ d.status ~ '.title')|trans }}</p></div>
            </div>
        </div>
        <div class="space-y-2 rounded-2xl border border-slate-100 bg-slate-50 p-4 text-xs">
            <div class="flex items-center gap-2 text-slate-700">{{ ux_icon('tabler:phone', {class:'h-4 w-4 text-emerald-600'}) }}<span>{{ d.phone ?? 'supplier.profile.no_phone'|trans }}{% if d.phone %} · {{ (d.phoneVerified ? 'supplier.profile.phone_verified' : 'supplier.profile.phone_unverified')|trans }}{% endif %}</span></div>
            <div class="flex items-center gap-2 text-slate-700">{{ ux_icon('tabler:mail', {class:'h-4 w-4 text-emerald-600'}) }}<span>{{ d.email }}</span></div>
            <div class="flex items-center gap-2 text-slate-700">{{ ux_icon('tabler:map-pin', {class:'h-4 w-4 text-emerald-600'}) }}<span>{{ d.companyAddress ?? 'supplier.profile.no_address'|trans }}</span></div>
        </div>
        <p class="whitespace-pre-line break-words text-xs leading-relaxed text-slate-600">{{ d.description ?? 'supplier.profile.no_description'|trans }}</p>
        <div class="flex items-center justify-around rounded-2xl border border-emerald-100 bg-emerald-50/50 p-4 text-center">
            <div><span class="text-[11px] text-slate-500">{{ 'supplier.profile.catalog'|trans }}</span><p class="text-base font-bold text-slate-900">0</p></div>
            <div class="h-8 w-px bg-emerald-200"></div>
            <div><span class="text-[11px] text-slate-500">{{ 'supplier.profile.fulfilled'|trans }}</span><p class="text-base font-bold text-slate-900">{{ d.stats.delivered }}</p></div>
            <div class="h-8 w-px bg-emerald-200"></div>
            <div><span class="text-[11px] text-slate-500">{{ 'supplier.profile.rating'|trans }}</span><p class="text-base font-bold text-emerald-700">—</p></div>
        </div>
    </div>

    {# ---- FINANCES : reversements pas encore automatisés, on ne simule rien ---- #}
    <div data-supplier-panel="finances" class="hidden space-y-6">
        <div class="flex flex-col justify-between gap-2 rounded-3xl border border-slate-200 bg-white p-6 text-slate-800 shadow-xs">
            <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[10px] font-black uppercase text-slate-700">{{ ('supplier.finance.plan_' ~ d.plan)|trans }}</span>
                <span class="text-xs text-slate-400">{{ d.plan == 'pro' ? 'supplier.finance.rent_pro'|trans({'%amount%': d.proRent|format_number(locale: app.request.locale)}) : 'supplier.finance.rent_standard'|trans }}</span>
            </div>
            <h3 class="text-sm font-bold">{{ 'supplier.finance.plan_requested'|trans }}</h3>
            <p class="max-w-xl text-xs text-slate-500">{{ 'supplier.finance.plan_note'|trans }}</p>
        </div>

        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
            <div class="space-y-1 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs"><span class="text-[11px] font-medium text-slate-500">{{ 'supplier.finance.sales_total'|trans }}</span><div class="font-mono text-xl font-black text-emerald-600">{{ d.stats.salesTotal|format_number(locale: app.request.locale) }} Ar</div><span class="text-[10px] font-medium text-emerald-700">{{ 'supplier.finance.sales_total_note'|trans }}</span></div>
            <div class="space-y-1 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs"><span class="text-[11px] font-medium text-slate-500">{{ 'supplier.finance.next_transfer'|trans }}</span><div class="text-sm font-bold text-slate-900">—</div><span class="text-[10px] text-slate-400">{{ 'supplier.finance.next_transfer_note'|trans }}</span></div>
            <div class="space-y-1 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs"><span class="text-[11px] font-medium text-slate-500">{{ 'supplier.finance.rate'|trans }}</span><div data-commission-rate class="font-mono text-xl font-black text-slate-900">{{ d.commissionRate is null ? '—' : 'supplier.finance.rate_value'|trans({'%rate%': d.commissionRate}) }}</div><span class="text-[10px] text-slate-400">{{ 'supplier.finance.rate_note'|trans }}</span></div>
            <div class="space-y-1 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs"><span class="text-[11px] font-medium text-slate-500">{{ 'supplier.finance.paid'|trans }}</span><div class="font-mono text-xl font-black text-slate-900">0 Ar</div><span class="text-[10px] text-slate-400">{{ 'supplier.finance.paid_note'|trans }}</span></div>
        </div>

        <div class="space-y-3 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs">
            <h3 class="text-sm font-bold text-slate-900">{{ 'supplier.finance.payout_title'|trans }}</h3>
            <p class="text-xs text-slate-500">{{ 'supplier.finance.payout_text'|trans }}</p>
        </div>

        <div class="space-y-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs">
            <h3 class="text-sm font-bold text-slate-900">{{ 'supplier.finance.history'|trans }}</h3>
            <div class="rounded-2xl bg-slate-50 p-8 text-center text-xs text-slate-400">{{ 'supplier.finance.history_none'|trans }}</div>
        </div>
    </div>
</div>
{% endblock %}
