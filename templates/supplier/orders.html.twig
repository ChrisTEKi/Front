{% extends 'supplier/_layout.html.twig' %}
{% import 'macros/forms.html.twig' as f %}
{% block title %}{{ 'Commandes — Espace fournisseur — GoBuy'|trans }}{% endblock %}

{% block supplier_content %}
<section class="space-y-5">
    <div class="flex flex-wrap gap-1 rounded-xl bg-slate-100 p-1 text-xs font-bold" role="group" aria-label="{{ 'Filtrer par statut'|trans }}">
        <a href="{{ path('app_supplier_orders') }}" class="rounded-lg px-3 py-1.5 {{ currentStatus is null ? 'bg-white text-slate-950 shadow-xs' : 'text-slate-500' }}">{{ 'Toutes'|trans }}</a>
        {% for status in statuses %}
            <a href="{{ path('app_supplier_orders', {statut: status.value}) }}" class="rounded-lg px-3 py-1.5 {{ currentStatus and currentStatus == status ? 'bg-white text-slate-950 shadow-xs' : 'text-slate-500' }}">{{ status.label|trans }} ({{ counts[status.value] }})</a>
        {% endfor %}
    </div>

    {% if orders is empty %}
        <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-12 text-center">
            <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-slate-400">{{ ux_icon('tabler:receipt', {class: 'h-7 w-7'}) }}</span>
            <p class="mt-3 text-sm font-bold text-slate-800">{% if currentStatus %}{{ 'Aucune commande « %status% » pour le moment.'|trans({'%status%': currentStatus.label|trans|lower}) }}{% else %}{{ 'Aucune commande pour le moment.'|trans }}{% endif %}</p>
        </div>
    {% else %}
        <div class="space-y-4">
            {% for row in orders %}
                {% set order = row.order %}
                <article class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <p class="font-mono text-xs font-bold text-slate-950">{{ order.number }}</p>
                            <p class="text-[11px] text-slate-500">{{ order.createdAt|date('d/m/Y à H:i') }}</p>
                        </div>
                        <span class="rounded-full border px-2.5 py-1 text-[10px] font-bold {{ row.status.badgeClasses }}">{{ row.status.label|trans }}</span>
                    </div>

                    <div class="mt-4 grid gap-4 sm:grid-cols-2">
                        <div class="text-xs">
                            <p class="font-bold text-slate-900">{{ order.shippingName }}</p>
                            <p class="text-slate-500">{{ order.shippingAddress }}, {{ order.shippingCity }}</p>
                            <a href="tel:{{ order.shippingPhone|replace({' ': ''}) }}" class="mt-1 inline-flex items-center gap-1 font-semibold text-emerald-700 hover:underline">{{ ux_icon('tabler:phone', {class: 'h-3.5 w-3.5'}) }}{{ order.shippingPhone }}</a>
                            <p class="mt-1 text-[10px] text-slate-400">{{ 'Coordonnées transmises pour la livraison uniquement.'|trans }}</p>
                        </div>
                        <ul class="space-y-1.5 text-xs">
                            {% for item in row.items %}
                                <li class="flex justify-between gap-3"><span class="truncate text-slate-700">{{ item.quantity }} × {{ item.productName }}</span><span class="shrink-0 font-bold text-slate-900">{{ item.lineTotal|ar }}</span></li>
                            {% endfor %}
                            <li class="flex justify-between border-t border-slate-100 pt-1.5 font-black text-slate-950"><span>Total</span><span>{{ row.total|ar }}</span></li>
                        </ul>
                    </div>

                    {% if row.status.allowedNext is not empty %}
                        <div class="mt-4 flex flex-wrap gap-2 border-t border-slate-100 pt-4">
                            {% for next in row.status.allowedNext %}
                                <form method="post" action="{{ path('app_supplier_order_status', {id: order.id}) }}" {% if next.value == 'cancelled' %}data-turbo-confirm="{{ 'Annuler cette commande ? Le stock sera remis à jour.'|trans }}"{% endif %}>
                                    {{ f.csrf() }}
                                    <input type="hidden" name="status" value="{{ next.value }}">
                                    <button type="submit" class="rounded-xl px-4 py-2 text-xs font-bold {{ next.value == 'cancelled' ? 'border border-red-200 text-red-600 hover:bg-red-50' : 'bg-slate-950 text-white hover:bg-slate-800' }}">{{ next.actionLabel|trans }}</button>
                                </form>
                            {% endfor %}
                        </div>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
