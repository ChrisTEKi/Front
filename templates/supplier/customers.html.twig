{% extends 'supplier/_layout.html.twig' %}
{% block title %}{{ 'Clients — Espace fournisseur — GoBuy'|trans }}{% endblock %}

{% macro customerRows(rows, showLast = true) %}
    <ul class="divide-y divide-slate-100">
        {% for c in rows %}
            <li class="flex items-center justify-between gap-3 py-2.5 text-xs">
                <span class="min-w-0"><span class="block truncate font-semibold text-slate-800">{{ c.name }}</span><span class="text-[10px] text-slate-400">{{ '%count% commande|%count% commandes'|trans({'%count%': c.orders}) }}{% if showLast %} · {{ 'dernière le %date%'|trans({'%date%': c.lastOrder|date('d/m/Y')}) }}{% endif %}</span></span>
                <span class="shrink-0 font-bold text-slate-950">{{ c.spent|ar }}</span>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% block supplier_content %}
{% import _self as m %}
<section class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-sm font-black text-slate-950">{{ 'Suivi de ma clientèle'|trans }}</h2>
        {% if customers.total > 0 %}
            <a href="{{ path('app_supplier_customers_export') }}" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50" download>{{ ux_icon('tabler:download', {class: 'h-4 w-4'}) }}{{ 'Exporter (CSV)'|trans }}</a>
        {% endif %}
    </div>

    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs"><p class="text-xs font-medium text-slate-500">{{ 'Clients'|trans }}</p><p class="mt-1 text-xl font-black text-slate-950">{{ customers.total }}</p></div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs"><p class="text-xs font-medium text-slate-500">{{ 'Nouveaux (30 jours)'|trans }}</p><p class="mt-1 text-xl font-black text-emerald-700">{{ customers.newCustomers }}</p></div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs"><p class="text-xs font-medium text-slate-500">{{ 'Taux de réachat'|trans }}</p><p class="mt-1 text-xl font-black text-slate-950">{{ customers.repeatRate }}%</p><p class="mt-1 text-[10px] text-slate-400">{{ '%count% client fidèle (2 commandes ou +)|%count% clients fidèles (2 commandes ou +)'|trans({'%count%': customers.returning}) }}</p></div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs"><p class="text-xs font-medium text-slate-500">{{ 'Dépense moyenne / client'|trans }}</p><p class="mt-1 text-xl font-black text-slate-950">{{ customers.averageSpent|ar }}</p></div>
    </div>

    {% if customers.total == 0 %}
        <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-12 text-center">
            <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-slate-400">{{ ux_icon('tabler:users', {class: 'h-7 w-7'}) }}</span>
            <p class="mt-3 text-sm font-bold text-slate-800">{{ 'Vos premiers clients apparaîtront ici dès la première commande.'|trans }}</p>
        </div>
    {% else %}
        <div class="grid gap-6 lg:grid-cols-2">
            <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs sm:p-6"><h3 class="mb-2 text-sm font-bold text-slate-950">{{ 'Meilleurs clients'|trans }}</h3>{{ m.customerRows(customers.top) }}</section>
            <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs sm:p-6"><h3 class="mb-2 text-sm font-bold text-slate-950">{{ 'Derniers acheteurs'|trans }}</h3>{{ m.customerRows(customers.recent) }}</section>
            <section class="rounded-3xl border border-amber-200 bg-amber-50/40 p-5 shadow-xs sm:p-6">
                <h3 class="text-sm font-bold text-slate-950">{{ 'Clients à relancer'|trans }}</h3>
                <p class="mb-2 text-[11px] text-slate-500">{{ 'Sans commande depuis plus de 45 jours, classés par montant dépensé.'|trans }}</p>
                {% if customers.toWinBack is empty %}<p class="py-4 text-center text-xs text-slate-400">{{ 'Aucun client inactif : bravo !'|trans }}</p>{% else %}{{ m.customerRows(customers.toWinBack) }}{% endif %}
            </section>
            <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xs sm:p-6">
                <h3 class="mb-3 text-sm font-bold text-slate-950">{{ 'Répartition par ville'|trans }}</h3>
                <table class="w-full text-left text-xs">
                    <thead><tr class="text-[10px] font-bold uppercase text-slate-400"><th class="pb-2">{{ 'Ville'|trans }}</th><th class="pb-2 text-right">{{ 'Clients'|trans }}</th><th class="pb-2 text-right">{{ 'Commandes'|trans }}</th><th class="pb-2 text-right">CA</th></tr></thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for c in customers.cities %}
                            <tr><td class="py-2 font-semibold text-slate-800">{{ c.city }}</td><td class="py-2 text-right">{{ c.customers }}</td><td class="py-2 text-right">{{ c.orders }}</td><td class="py-2 text-right font-bold text-slate-950">{{ c.revenue|ar }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </section>
        </div>
    {% endif %}
</section>
{% endblock %}
