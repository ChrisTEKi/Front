{# Carte de connexion / inscription : login, register, register_supplier, verify_email, verify_sms, two_factor, restore_account,
   forgot_password, reset_password.
   Le SERVEUR décide de l'étape (voir App\Auth\LoginFlow) ; assets/auth.js affiche le bon panneau et appelle l'API /auth/*.
   Tous les textes viennent de translations/messages.<langue>.yaml (clés « auth.* »). #}
{% set initialMode = initialMode|default('login') %}
{% set endpoints = {
    state: path('auth_state'), login: path('auth_login'), registerClient: path('auth_register_client'),
    registerSupplier: path('auth_register_supplier'), verify: path('auth_verify'), resend: path('auth_resend'),
    skip: path('auth_skip'), restore: path('auth_restore'), cancel: path('auth_cancel'),
    forgot: path('auth_forgot'), reset: path('auth_reset')
} %}
<div data-auth data-auth-initial="{{ initialMode }}" data-auth-endpoints="{{ endpoints|json_encode }}"
     {% if resume|default(false) %}data-auth-resume="1"{% endif %}
     {% if flashError|default(null) %}data-auth-flash-error="{{ flashError }}"{% endif %}
     class="relative flex max-h-[92vh] w-full max-w-md flex-col overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-2xl">

    <div class="flex items-center justify-between border-b border-slate-100 p-4">
        <div class="flex items-center gap-2">
            <button type="button" data-auth-back aria-label="{{ 'common.back'|trans }}" class="hidden rounded-lg p-1 text-slate-500 hover:bg-slate-100">{{ ux_icon('tabler:arrow-left', { class: 'h-4 w-4' }) }}</button>
            <h2 data-auth-title class="text-sm font-bold text-slate-900">{{ 'auth.title.login'|trans }}</h2>
        </div>
        <button type="button" data-modal-close aria-label="{{ 'common.close'|trans }}" class="rounded-full p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700">{{ ux_icon('tabler:x', { class: 'h-5 w-5' }) }}</button>
    </div>

    <div class="space-y-4 overflow-y-auto p-6">
        <div data-auth-error role="alert" class="hidden items-center gap-2 rounded-2xl border border-red-200 bg-red-50 p-3 text-xs text-red-700">{{ ux_icon('tabler:alert-circle', { class: 'h-4 w-4 shrink-0' }) }}<span data-auth-error-text></span></div>
        <div data-auth-success role="status" class="hidden items-center gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800">{{ ux_icon('tabler:circle-check', { class: 'h-4 w-4 shrink-0 text-emerald-600' }) }}<span data-auth-success-text></span></div>

        {# ---- LOGIN ---- #}
        <div data-auth-panel="login" data-title="{{ 'auth.title.login'|trans }}" class="space-y-4">
            <div class="space-y-2">
                <a href="{{ path('social_start', {provider: 'google'}) }}" class="flex w-full items-center justify-center gap-2.5 rounded-xl border border-slate-200 px-4 py-2.5 text-xs font-semibold text-slate-700 shadow-2xs transition-colors hover:bg-slate-50">
                    <svg class="h-4 w-4" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
                    <span>{{ 'auth.google'|trans }}</span>
                </a>
                <a href="{{ path('social_start', {provider: 'apple'}) }}" class="flex w-full items-center justify-center gap-2.5 rounded-xl bg-black px-4 py-2.5 text-xs font-semibold text-white shadow-2xs transition-colors hover:bg-slate-900">
                    {{ ux_icon('tabler:brand-apple', { class: 'h-4 w-4' }) }}<span>{{ 'auth.apple'|trans }}</span>
                </a>
            </div>
            <div class="relative flex items-center justify-center"><div class="w-full border-t border-slate-200"></div><span class="bg-white px-2 text-[10px] font-bold uppercase text-slate-400 absolute">{{ 'auth.or_email'|trans }}</span></div>
            <form data-auth-form="login" class="space-y-3" novalidate>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.email'|trans }}</label>
                    <div class="relative">{{ ux_icon('tabler:mail', { class: 'absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400' }) }}
                        <input type="email" name="email" required autocomplete="email" placeholder="{{ 'auth.email_placeholder'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-xs"></div>
                    <p data-field-error="email" class="mt-1 hidden text-[11px] text-red-600"></p></div>
                <div><div class="mb-1 flex items-center justify-between"><label class="text-xs font-semibold text-slate-700">{{ 'auth.password'|trans }}</label>
                        <button type="button" data-auth-switch="forgot_password" class="text-[11px] text-emerald-600 hover:underline">{{ 'auth.forgot_link'|trans }}</button></div>
                    <div class="relative">{{ ux_icon('tabler:lock', { class: 'absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400' }) }}
                        <input type="password" name="password" required autocomplete="current-password" placeholder="••••••••" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-xs"></div></div>
                <button type="submit" class="mt-2 w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md shadow-emerald-600/25 transition-all hover:bg-emerald-700 disabled:opacity-60">{{ 'auth.login_submit'|trans }}</button>
            </form>
            <div class="space-y-2 pt-2 text-center text-xs text-slate-500">
                <p>{{ 'auth.no_account'|trans }} <button type="button" data-auth-switch="register" class="font-bold text-emerald-600 hover:underline">{{ 'auth.create_client'|trans }}</button></p>
                <div class="border-t border-slate-100 pt-2">
                    <button type="button" data-auth-switch="register_supplier" class="mx-auto flex items-center justify-center gap-1.5 font-semibold text-slate-700 hover:text-emerald-700">
                        {{ ux_icon('tabler:building', { class: 'h-3.5 w-3.5 text-emerald-600' }) }}<span>{{ 'auth.supplier_cta'|trans }}</span></button>
                </div>
            </div>
        </div>

        {# ---- REGISTER CLIENT ---- #}
        <form data-auth-panel="register" data-auth-form="register_client" data-title="{{ 'auth.title.register'|trans }}" class="hidden space-y-3" novalidate>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.full_name'|trans }}</label>
                <div class="relative">{{ ux_icon('tabler:user', { class: 'absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400' }) }}
                    <input type="text" name="fullName" required autocomplete="name" placeholder="{{ 'auth.full_name_placeholder'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-xs"></div>
                <p data-field-error="fullName" class="mt-1 hidden text-[11px] text-red-600"></p></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.email_required'|trans }}</label>
                <div class="relative">{{ ux_icon('tabler:mail', { class: 'absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400' }) }}
                    <input type="email" name="email" required autocomplete="email" placeholder="{{ 'auth.email_placeholder_client'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-xs"></div>
                <p data-field-error="email" class="mt-1 hidden text-[11px] text-red-600"></p></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.phone_optional'|trans }}</label>
                <div class="relative">{{ ux_icon('tabler:phone', { class: 'absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400' }) }}
                    <input type="tel" name="phone" autocomplete="tel" placeholder="{{ 'auth.phone_placeholder_client'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-xs"></div>
                <p data-field-error="phone" class="mt-1 hidden text-[11px] text-red-600"></p>
                <p class="mt-1 text-[10px] text-slate-400">{{ 'auth.phone_hint'|trans }}</p></div>
            {# Adresse de livraison FACULTATIVE : elle devient l'adresse par défaut de la première commande (voir RegisterClientData). #}
            <details class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <summary class="cursor-pointer text-xs font-semibold text-slate-700">{{ 'auth.address_optional'|trans }}</summary>
                <p class="mt-1 text-[10px] text-slate-400">{{ 'auth.address_hint'|trans }}</p>
                <div class="mt-3 space-y-3">
                    <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.address_street'|trans }}</label>
                        <input type="text" name="street" maxlength="255" autocomplete="street-address" placeholder="{{ 'checkout.f_street_ph'|trans }}" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs">
                        <p data-field-error="street" class="mt-1 hidden text-[11px] text-red-600"></p></div>
                    <div class="grid grid-cols-2 gap-2">
                        <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'checkout.f_city'|trans }}</label>
                            <input type="text" name="city" maxlength="100" autocomplete="address-level2" placeholder="Antananarivo" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs">
                            <p data-field-error="city" class="mt-1 hidden text-[11px] text-red-600"></p></div>
                        <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'checkout.f_postal'|trans }}</label>
                            <input type="text" name="postalCode" maxlength="10" autocomplete="postal-code" placeholder="101" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs">
                            <p data-field-error="postalCode" class="mt-1 hidden text-[11px] text-red-600"></p></div>
                    </div>
                </div>
            </details>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.password_required'|trans }}</label>
                <div class="relative">{{ ux_icon('tabler:lock', { class: 'absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400' }) }}
                    <input type="password" name="password" required autocomplete="new-password" placeholder="{{ 'auth.password_placeholder_new'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-xs"></div>
                <p data-field-error="password" class="mt-1 hidden text-[11px] text-red-600"></p></div>
            <div class="flex items-start gap-2 rounded-xl border border-emerald-100 bg-emerald-50 p-3 text-[11px] text-emerald-800">{{ ux_icon('tabler:shield-check', { class: 'mt-0.5 h-4 w-4 shrink-0 text-emerald-600' }) }}<span>{{ 'auth.register_notice'|trans }}</span></div>
            <button type="submit" class="w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md shadow-emerald-600/25 transition-all hover:bg-emerald-700 disabled:opacity-60">{{ 'auth.register_submit'|trans }}</button>
            <p class="pt-2 text-center text-xs text-slate-500">{{ 'auth.already_registered'|trans }} <button type="button" data-auth-switch="login" class="font-bold text-emerald-600 hover:underline">{{ 'auth.login_submit'|trans }}</button></p>
        </form>

        {# ---- REGISTER SUPPLIER ---- #}
        <form data-auth-panel="register_supplier" data-auth-form="register_supplier" data-title="{{ 'auth.title.register_supplier'|trans }}" class="hidden space-y-3" novalidate>
            <div class="flex items-start gap-2 rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-amber-800">{{ ux_icon('tabler:alert-circle', { class: 'mt-0.5 h-4 w-4 shrink-0 text-amber-600' }) }}<span>{{ 'auth.supplier_notice'|trans|raw }}</span></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.company_name'|trans }}</label>
                <div class="relative">{{ ux_icon('tabler:building', { class: 'absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400' }) }}
                    <input type="text" name="companyName" required autocomplete="organization" placeholder="{{ 'auth.company_name_placeholder'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-xs"></div>
                <p data-field-error="companyName" class="mt-1 hidden text-[11px] text-red-600"></p></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.manager_name'|trans }}</label>
                <input type="text" name="fullName" required autocomplete="name" placeholder="{{ 'auth.manager_name_placeholder'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs">
                <p data-field-error="fullName" class="mt-1 hidden text-[11px] text-red-600"></p></div>
            <div class="grid grid-cols-2 gap-2">
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.business_email'|trans }}</label>
                    <input type="email" name="email" required autocomplete="email" placeholder="{{ 'auth.business_email_placeholder'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs">
                    <p data-field-error="email" class="mt-1 hidden text-[11px] text-red-600"></p></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.mobile_required'|trans }}</label>
                    <input type="tel" name="phone" required autocomplete="tel" placeholder="{{ 'auth.phone_placeholder'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs">
                    <p data-field-error="phone" class="mt-1 hidden text-[11px] text-red-600"></p></div>
            </div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.password_required'|trans }}</label>
                <input type="password" name="password" required autocomplete="new-password" placeholder="{{ 'auth.password_placeholder_new'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs">
                <p data-field-error="password" class="mt-1 hidden text-[11px] text-red-600"></p></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.company_address'|trans }}</label>
                <input type="text" name="companyAddress" required autocomplete="street-address" placeholder="{{ 'auth.company_address_placeholder'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs">
                <p data-field-error="companyAddress" class="mt-1 hidden text-[11px] text-red-600"></p></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.company_description'|trans }}</label>
                <textarea rows="2" name="companyDescription" placeholder="{{ 'auth.company_description_placeholder'|trans }}" class="w-full resize-none rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></textarea>
                <p data-field-error="companyDescription" class="mt-1 hidden text-[11px] text-red-600"></p></div>
            <button type="submit" class="w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md shadow-emerald-600/25 transition-all hover:bg-emerald-700 disabled:opacity-60">{{ 'auth.supplier_submit'|trans }}</button>
            <p class="pt-2 text-center text-xs text-slate-500">{{ 'auth.already_registered'|trans }} <button type="button" data-auth-switch="login" class="font-bold text-emerald-600 hover:underline">{{ 'auth.login_submit'|trans }}</button></p>
        </form>

        {# ---- VERIFY EMAIL ---- #}
        <div data-auth-panel="verify_email" data-title="{{ 'auth.title.verify_email'|trans }}" class="hidden space-y-4 text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">{{ ux_icon('tabler:mail', { class: 'h-7 w-7' }) }}</div>
            <div><h3 class="text-sm font-bold text-slate-900">{{ 'auth.verify_email.heading'|trans }}</h3>
                <p class="mt-1 text-xs text-slate-500">{{ 'auth.verify_email.sent_to'|trans }} <strong data-auth-target></strong>. {{ 'auth.verify_email.enter_below'|trans }}</p></div>
            <input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" data-auth-otp placeholder="••••••" aria-label="{{ 'auth.reset.code'|trans }}" class="mx-auto w-48 rounded-2xl border-2 border-emerald-500 bg-slate-50 py-2.5 text-center font-mono text-xl font-bold tracking-widest text-slate-900 focus:outline-none">
            <div class="space-y-2">
                <button type="button" data-auth-verify class="w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md transition-all hover:bg-emerald-700 disabled:opacity-60">{{ 'auth.verify_email.submit'|trans }}</button>
                <button type="button" data-auth-resend class="w-full py-2 text-xs text-slate-500 hover:text-slate-800 disabled:opacity-60">{{ 'auth.resend'|trans }}</button>
            </div>
        </div>

        {# ---- VERIFY SMS ---- #}
        <div data-auth-panel="verify_sms" data-title="{{ 'auth.title.verify_sms'|trans }}" class="hidden space-y-4 text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">{{ ux_icon('tabler:phone', { class: 'h-7 w-7' }) }}</div>
            <div><h3 class="text-sm font-bold text-slate-900">{{ 'auth.verify_sms.heading'|trans }}</h3>
                <p class="mt-1 text-xs text-slate-500">{{ 'auth.verify_sms.sent_to'|trans }} <strong data-auth-target></strong>. {{ 'auth.verify_sms.enter_below'|trans }}</p></div>
            <input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" data-auth-otp placeholder="••••••" aria-label="{{ 'auth.reset.code'|trans }}" class="mx-auto w-48 rounded-2xl border-2 border-emerald-500 bg-slate-50 py-2.5 text-center font-mono text-xl font-bold tracking-widest text-slate-900 focus:outline-none">
            <div class="space-y-2">
                <button type="button" data-auth-verify class="w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md transition-all hover:bg-emerald-700 disabled:opacity-60">{{ 'auth.verify_sms.submit'|trans }}</button>
                <button type="button" data-auth-resend class="w-full py-2 text-xs text-slate-500 hover:text-slate-800 disabled:opacity-60">{{ 'auth.resend'|trans }}</button>
                <button type="button" data-auth-skip class="w-full py-2.5 text-xs text-slate-500 hover:text-slate-800">{{ 'auth.verify_sms.skip'|trans }}</button>
            </div>
        </div>

        {# ---- 2FA ---- #}
        <div data-auth-panel="two_factor" data-title="{{ 'auth.title.two_factor'|trans }}" class="hidden space-y-4 text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-indigo-100 text-indigo-700">{{ ux_icon('tabler:key', { class: 'h-7 w-7' }) }}</div>
            <div><h3 class="text-sm font-bold text-slate-900">{{ 'auth.two_factor.heading'|trans }}</h3>
                <p class="mt-1 text-xs text-slate-500">{{ 'auth.two_factor.intro'|trans }}</p>
                <p class="mt-1 text-xs text-slate-500">{{ 'auth.two_factor.sent_to'|trans }} <strong data-auth-target></strong></p></div>
            <input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" data-auth-otp placeholder="••••••" aria-label="{{ 'auth.reset.code'|trans }}" class="mx-auto w-48 rounded-2xl border-2 border-indigo-500 bg-slate-50 py-2.5 text-center font-mono text-xl font-bold tracking-widest text-slate-900 focus:outline-none">
            <div class="space-y-2">
                <button type="button" data-auth-verify class="w-full rounded-2xl bg-indigo-600 py-3 text-xs font-semibold text-white shadow-md transition-all hover:bg-indigo-700 disabled:opacity-60">{{ 'auth.two_factor.submit'|trans }}</button>
                <button type="button" data-auth-resend class="w-full py-2 text-xs text-slate-500 hover:text-slate-800 disabled:opacity-60">{{ 'auth.resend'|trans }}</button>
                <div data-auth-channels class="hidden space-y-1">
                    <button type="button" data-auth-channel="email" class="w-full py-1.5 text-xs font-semibold text-indigo-700 hover:underline">{{ 'auth.two_factor.by_email'|trans }}</button>
                    <button type="button" data-auth-channel="sms" class="w-full py-1.5 text-xs font-semibold text-indigo-700 hover:underline">{{ 'auth.two_factor.by_sms'|trans }}</button>
                </div>
            </div>
        </div>

        {# ---- RESTORE ACCOUNT (compte en cours de suppression) ---- #}
        <div data-auth-panel="restore_account" data-title="{{ 'auth.title.restore_account'|trans }}" class="hidden space-y-4 text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-amber-100 text-amber-700">{{ ux_icon('tabler:refresh', { class: 'h-7 w-7' }) }}</div>
            <div><h3 class="text-sm font-bold text-slate-900">{{ 'auth.restore.heading'|trans }}</h3>
                <p class="mt-1 text-xs text-slate-500">{{ 'auth.restore.intro'|trans }}</p></div>
            <div class="space-y-2">
                <button type="button" data-auth-restore class="w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md transition-all hover:bg-emerald-700 disabled:opacity-60">{{ 'auth.restore.submit'|trans }}</button>
                <button type="button" data-auth-restore-decline class="w-full py-2.5 text-xs text-slate-500 hover:text-slate-800">{{ 'auth.restore.decline'|trans }}</button>
            </div>
        </div>

        {# ---- FORGOT PASSWORD ---- #}
        <form data-auth-panel="forgot_password" data-auth-form="forgot" data-title="{{ 'auth.title.forgot_password'|trans }}" class="hidden space-y-4" novalidate>
            <div class="text-center"><div class="mx-auto mb-2 flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-700">{{ ux_icon('tabler:key', { class: 'h-6 w-6' }) }}</div>
                <h3 class="text-sm font-bold text-slate-900">{{ 'auth.forgot.heading'|trans }}</h3>
                <p class="mt-1 text-xs text-slate-500">{{ 'auth.forgot.intro'|trans }}</p></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.forgot.email'|trans }}</label>
                <input type="email" name="email" required autocomplete="email" placeholder="{{ 'auth.email_placeholder'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></div>
            <button type="submit" class="w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md transition-all hover:bg-emerald-700 disabled:opacity-60">{{ 'auth.forgot.submit'|trans }}</button>
        </form>

        {# ---- RESET PASSWORD ---- #}
        <form data-auth-panel="reset_password" data-auth-form="reset" data-title="{{ 'auth.title.reset_password'|trans }}" class="hidden space-y-4" novalidate>
            <div class="text-center"><h3 class="text-sm font-bold text-slate-900">{{ 'auth.reset.heading'|trans }}</h3><p class="mt-1 text-xs text-slate-500">{{ 'auth.reset.intro'|trans }}</p></div>
            <input type="hidden" name="email">
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.reset.code'|trans }}</label>
                <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required placeholder="123456" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-center font-mono text-xs tracking-wider"></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'auth.reset.password'|trans }}</label>
                <input type="password" name="password" required autocomplete="new-password" placeholder="••••••••" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs">
                <p data-field-error="password" class="mt-1 hidden text-[11px] text-red-600"></p></div>
            <button type="submit" class="w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md transition-all hover:bg-emerald-700 disabled:opacity-60">{{ 'auth.reset.submit'|trans }}</button>
        </form>
    </div>
</div>
