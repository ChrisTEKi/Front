{# Auth card: login / register / register_supplier / verify_email / verify_sms / two_factor / forgot_password / reset_password.
   Mode switching is pure JS (see assets/app.js -> initAuth). Forms are not wired to a back-end yet. #}
{% set initialMode = initialMode|default('login') %}
<div data-auth data-auth-initial="{{ initialMode }}" class="relative flex max-h-[92vh] w-full max-w-md flex-col overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-2xl">

    <div class="flex items-center justify-between border-b border-slate-100 p-4">
        <div class="flex items-center gap-2">
            <button type="button" data-auth-back class="hidden rounded-lg p-1 text-slate-500 hover:bg-slate-100">{{ ux_icon('tabler:arrow-left', { class: 'h-4 w-4' }) }}</button>
            <h2 data-auth-title class="text-sm font-bold text-slate-900">Connexion GoBuy</h2>
        </div>
        <button type="button" data-modal-close class="rounded-full p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700">{{ ux_icon('tabler:x', { class: 'h-5 w-5' }) }}</button>
    </div>

    <div class="space-y-4 overflow-y-auto p-6">
        <div data-auth-error class="hidden items-center gap-2 rounded-2xl border border-red-200 bg-red-50 p-3 text-xs text-red-700">{{ ux_icon('tabler:alert-circle', { class: 'h-4 w-4 shrink-0' }) }}<span data-auth-error-text></span></div>
        <div data-auth-success class="hidden items-center gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800">{{ ux_icon('tabler:circle-check', { class: 'h-4 w-4 shrink-0 text-emerald-600' }) }}<span data-auth-success-text></span></div>

        {# ---- LOGIN ---- #}
        <div data-auth-panel="login" data-title="Connexion GoBuy" class="space-y-4">
            <div class="space-y-2">
                <button type="button" data-auth-social="google" class="flex w-full items-center justify-center gap-2.5 rounded-xl border border-slate-200 px-4 py-2.5 text-xs font-semibold text-slate-700 shadow-2xs transition-colors hover:bg-slate-50">
                    <svg class="h-4 w-4" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
                    <span>Continuer avec Google</span>
                </button>
                <button type="button" data-auth-social="apple" class="flex w-full items-center justify-center gap-2.5 rounded-xl bg-black px-4 py-2.5 text-xs font-semibold text-white shadow-2xs transition-colors hover:bg-slate-900">
                    {{ ux_icon('tabler:brand-apple', { class: 'h-4 w-4' }) }}<span>Continuer avec Apple ID</span>
                </button>
            </div>
            <div class="relative flex items-center justify-center"><div class="w-full border-t border-slate-200"></div><span class="bg-white px-2 text-[10px] font-bold uppercase text-slate-400 absolute">ou avec email</span></div>
            <form method="post" action="{{ path('app_login') }}" data-auth-form="login" class="space-y-3">
                {% if authenticationError|default(false) %}
                    <p role="alert" class="rounded-xl border border-red-200 bg-red-50 p-3 text-xs text-red-700">Adresse e-mail ou mot de passe incorrect.</p>
                {% endif %}
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Adresse E-mail</label>
                    <div class="relative">{{ ux_icon('tabler:mail', { class: 'absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400' }) }}
                        <input type="email" name="_username" value="{{ lastUsername|default('') }}" autocomplete="username" required placeholder="votre.email@exemple.com" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-xs"></div></div>
                <div><div class="mb-1 flex items-center justify-between"><label class="text-xs font-semibold text-slate-700">Mot de passe</label>
                        <button type="button" data-auth-switch="forgot_password" class="text-[11px] text-emerald-600 hover:underline">Mot de passe oublié ?</button></div>
                    <div class="relative">{{ ux_icon('tabler:lock', { class: 'absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400' }) }}
                        <input type="password" name="_password" autocomplete="current-password" required placeholder="••••••••" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-xs"></div></div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="mt-2 w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md shadow-emerald-600/25 transition-all hover:bg-emerald-700">Se connecter</button>
            </form>
            <div class="space-y-2 pt-2 text-center text-xs text-slate-500">
                <p>Pas encore de compte ? <button type="button" data-auth-switch="register" class="font-bold text-emerald-600 hover:underline">Créer un compte client</button></p>
                <div class="border-t border-slate-100 pt-2">
                    <button type="button" data-auth-switch="register_supplier" class="mx-auto flex items-center justify-center gap-1.5 font-semibold text-slate-700 hover:text-emerald-700">
                        {{ ux_icon('tabler:building', { class: 'h-3.5 w-3.5 text-emerald-600' }) }}<span>Vous êtes vendeur ou fournisseur ? Cliquez ici</span></button>
                </div>
            </div>
        </div>

        {# ---- REGISTER CLIENT ---- #}
        <form data-auth-panel="register" data-auth-form="register" data-title="Créer un compte Client" class="hidden space-y-3" novalidate>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">Nom complet *</label>
                <div class="relative">{{ ux_icon('tabler:user', { class: 'absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400' }) }}
                    <input type="text" name="fullName" required placeholder="Ex: Ranaivo Andriamihaja" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-xs"></div></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">Adresse E-mail * (Validation requise)</label>
                <div class="relative">{{ ux_icon('tabler:mail', { class: 'absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400' }) }}
                    <input type="email" name="email" required placeholder="ranaivo@gmail.com" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-xs"></div></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">Téléphone mobile (Optionnel à l'inscription)</label>
                <div class="relative">{{ ux_icon('tabler:phone', { class: 'absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400' }) }}
                    <input type="tel" name="phone" placeholder="034 56 789 01" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-xs"></div>
                <p class="mt-1 text-[10px] text-slate-400">Si renseigné, un code SMS sera envoyé. Obligatoire avant le premier achat.</p></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">Mot de passe *</label>
                <div class="relative">{{ ux_icon('tabler:lock', { class: 'absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400' }) }}
                    <input type="password" name="password" required placeholder="Au moins 6 caractères" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-xs"></div></div>
            <div class="flex items-start gap-2 rounded-xl border border-emerald-100 bg-emerald-50 p-3 text-[11px] text-emerald-800">{{ ux_icon('tabler:shield-check', { class: 'mt-0.5 h-4 w-4 shrink-0 text-emerald-600' }) }}<span>Un code de vérification à 6 chiffres vous sera envoyé par e-mail immédiatement pour activer votre espace client.</span></div>
            <button type="submit" class="w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md shadow-emerald-600/25 transition-all hover:bg-emerald-700">Créer mon compte</button>
            <p class="pt-2 text-center text-xs text-slate-500">Déjà inscrit ? <button type="button" data-auth-switch="login" class="font-bold text-emerald-600 hover:underline">Se connecter</button></p>
        </form>

        {# ---- REGISTER SUPPLIER ---- #}
        <form data-auth-panel="register_supplier" data-auth-form="register" data-title="Inscription Fournisseur & Vendeur" class="hidden space-y-3" novalidate>
            <div class="flex items-start gap-2 rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-amber-800">{{ ux_icon('tabler:alert-circle', { class: 'mt-0.5 h-4 w-4 shrink-0 text-amber-600' }) }}<span>L'inscription fournisseur nécessite une vérification e-mail &amp; téléphone, ainsi qu'une <strong>approbation préalable par l'administrateur</strong> avant de pouvoir publier des produits.</span></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">Nom de l'entreprise / Marque *</label>
                <div class="relative">{{ ux_icon('tabler:building', { class: 'absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400' }) }}
                    <input type="text" name="companyName" required placeholder="Ex: StylePro Madagascar" class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-xs"></div></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">Nom du gérant / contact *</label>
                <input type="text" name="fullName" required placeholder="Ex: RAKOTOMALALA Jean" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></div>
            <div class="grid grid-cols-2 gap-2">
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Email professionnel *</label>
                    <input type="email" name="email" required placeholder="contact@stylepro.mg" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Téléphone mobile *</label>
                    <input type="tel" name="phone" required placeholder="034 12 345 67" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></div>
            </div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">Adresse de l'entrepôt / magasin *</label>
                <input type="text" name="companyAddress" required placeholder="Lot II A 124, Ankadifotsy, Antananarivo" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">Présentation de vos produits</label>
                <textarea rows="2" name="companyDescription" placeholder="Types de produits, marques, garanties offertes..." class="w-full resize-none rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></textarea></div>
            <button type="submit" class="w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md shadow-emerald-600/25 transition-all hover:bg-emerald-700">Soumettre mon dossier fournisseur</button>
        </form>

        {# ---- VERIFY EMAIL ---- #}
        <div data-auth-panel="verify_email" data-title="Vérification de votre E-mail" class="hidden space-y-4 text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">{{ ux_icon('tabler:mail', { class: 'h-7 w-7' }) }}</div>
            <div><h3 class="text-sm font-bold text-slate-900">Vérification de l'adresse e-mail</h3>
                <p class="mt-1 text-xs text-slate-500">Un code à 6 chiffres a été envoyé à <strong data-auth-email></strong>. Entrez-le ci-dessous pour activer votre compte.</p></div>
            <input type="text" maxlength="6" data-auth-otp placeholder="••••••" class="mx-auto w-48 rounded-2xl border-2 border-emerald-500 bg-slate-50 py-2.5 text-center font-mono text-xl font-bold tracking-widest text-slate-900 focus:outline-none">
            <button type="button" data-auth-verify="email" class="w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md transition-all hover:bg-emerald-700">Confirmer l'adresse e-mail</button>
        </div>

        {# ---- VERIFY SMS ---- #}
        <div data-auth-panel="verify_sms" data-title="Vérification par SMS (Optionnel)" class="hidden space-y-4 text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">{{ ux_icon('tabler:phone', { class: 'h-7 w-7' }) }}</div>
            <div><h3 class="text-sm font-bold text-slate-900">Confirmation SMS (Optionnel)</h3>
                <p class="mt-1 text-xs text-slate-500">Code SMS envoyé au <strong data-auth-phone></strong>. Vous pouvez le valider maintenant ou plus tard lors de votre première commande.</p></div>
            <input type="text" maxlength="6" placeholder="••••••" class="mx-auto w-48 rounded-2xl border-2 border-emerald-500 bg-slate-50 py-2.5 text-center font-mono text-xl font-bold tracking-widest text-slate-900 focus:outline-none">
            <div class="space-y-2">
                <button type="button" data-auth-verify="sms" class="w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md transition-all hover:bg-emerald-700">Valider le numéro mobile</button>
                <button type="button" data-auth-verify="sms-skip" class="w-full py-2.5 text-xs text-slate-500 hover:text-slate-800">Passer cette étape (je validerai avant ma commande)</button>
            </div>
        </div>

        {# ---- 2FA ---- #}
        <div data-auth-panel="two_factor" data-title="Double Authentification (2FA)" class="hidden space-y-4 text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-indigo-100 text-indigo-700">{{ ux_icon('tabler:key', { class: 'h-7 w-7' }) }}</div>
            <div><h3 class="text-sm font-bold text-slate-900">Authentification à deux facteurs</h3>
                <p class="mt-1 text-xs text-slate-500">Votre compte est protégé par la 2FA. Veuillez entrer le code de sécurité envoyé.</p></div>
            <input type="text" maxlength="6" placeholder="••••••" class="mx-auto w-48 rounded-2xl border-2 border-indigo-500 bg-slate-50 py-2.5 text-center font-mono text-xl font-bold tracking-widest text-slate-900 focus:outline-none">
            <button type="button" class="w-full rounded-2xl bg-indigo-600 py-3 text-xs font-semibold text-white shadow-md transition-all hover:bg-indigo-700">Vérifier et me connecter</button>
        </div>

        {# ---- FORGOT PASSWORD ---- #}
        <form data-auth-panel="forgot_password" data-auth-form="forgot" data-title="Mot de passe oublié" class="hidden space-y-4" novalidate>
            <div class="text-center"><div class="mx-auto mb-2 flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-700">{{ ux_icon('tabler:key', { class: 'h-6 w-6' }) }}</div>
                <h3 class="text-sm font-bold text-slate-900">Récupération de mot de passe</h3>
                <p class="mt-1 text-xs text-slate-500">Saisissez l'e-mail lié à votre compte. Vous recevrez un code sécurisé pour créer un nouveau mot de passe.</p></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">Votre E-mail</label>
                <input type="email" name="email" required placeholder="votre.email@exemple.com" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></div>
            <button type="submit" class="w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md transition-all hover:bg-emerald-700">Envoyer le code de réinitialisation</button>
        </form>

        {# ---- RESET PASSWORD ---- #}
        <form data-auth-panel="reset_password" data-auth-form="reset" data-title="Nouveau mot de passe" class="hidden space-y-4" novalidate>
            <div class="text-center"><h3 class="text-sm font-bold text-slate-900">Nouveau mot de passe</h3><p class="mt-1 text-xs text-slate-500">Entrez le code reçu et définissez votre nouveau mot de passe.</p></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">Code à 6 chiffres</label>
                <input type="text" maxlength="6" required placeholder="123456" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-center font-mono text-xs tracking-wider"></div>
            <div><label class="mb-1 block text-xs font-semibold text-slate-700">Nouveau mot de passe</label>
                <input type="password" required placeholder="••••••••" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></div>
            <button type="submit" class="w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md transition-all hover:bg-emerald-700">Enregistrer le mot de passe</button>
        </form>
    </div>
</div>
