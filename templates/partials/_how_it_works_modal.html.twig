<div data-modal="how-it-works" class="pointer-events-none fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 p-4 backdrop-blur-xs">
    <div class="pointer-events-auto flex max-h-[90vh] w-full max-w-3xl flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl">
        <div class="relative flex items-center justify-between bg-black p-6 text-white">
            <div class="space-y-1">
                <span class="rounded-full border border-gobuy-green/30 bg-neutral-900 px-2.5 py-0.5 text-[11px] font-black uppercase tracking-wider text-gobuy-green">{{ 'modal.how.badge'|trans }}</span>
                <h3 class="text-xl font-black tracking-tight sm:text-2xl">{{ 'modal.how.title'|trans }}</h3>
                <p class="text-xs font-medium text-neutral-300">{{ 'modal.how.subtitle'|trans }}</p>
            </div>
            <button type="button" data-modal-close class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20">{{ ux_icon('tabler:x', { class: 'h-5 w-5' }) }}</button>
        </div>
        <div class="space-y-6 overflow-y-auto p-6 text-xs text-slate-800 sm:text-sm">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                {% for n in 1..4 %}
                    <div class="space-y-2 rounded-2xl border border-neutral-200/80 bg-neutral-50 p-4">
                        <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-black text-sm font-black text-gobuy-green">{{ n }}</div>
                        <h4 class="text-sm font-black text-black">{{ ('modal.how.s' ~ n ~ '_t')|trans }}</h4>
                        <p class="text-xs leading-relaxed text-neutral-600">{{ ('modal.how.s' ~ n ~ '_d')|trans }}</p>
                    </div>
                {% endfor %}
            </div>
            <div class="space-y-3 rounded-2xl border border-neutral-200 bg-neutral-50 p-4">
                <h4 class="flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-black">{{ ux_icon('tabler:shield-check', { class: 'h-4 w-4 text-gobuy-green' }) }}{{ 'modal.how.included'|trans }}</h4>
                <div class="grid grid-cols-1 gap-2 text-xs text-neutral-700 sm:grid-cols-2">
                    {% for n in 1..4 %}
                        <div class="flex items-center gap-2">{{ ux_icon('tabler:circle-check', { class: 'h-4 w-4 shrink-0 text-gobuy-green' }) }}<span>{{ ('modal.how.i' ~ n)|trans }}</span></div>
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="flex items-center justify-between gap-4 border-t border-neutral-200 bg-neutral-50 p-4">
            <button type="button" data-modal-close class="px-4 py-2 text-xs font-bold text-neutral-600 hover:text-black">{{ 'modal.how.close'|trans }}</button>
            <a href="{{ path('app_home') }}#catalog-section" data-modal-close class="rounded-full bg-black px-6 py-2.5 text-xs font-bold text-white shadow-xs transition-colors hover:bg-neutral-800">{{ 'modal.how.start_shopping'|trans }}</a>
        </div>
    </div>
</div>
