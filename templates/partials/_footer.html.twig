{# ============================================================
   Footer — brand column + app badges, 2 nav columns, socials,
   language/currency selectors, legal links, payment badges.
   Faithful port of Footer.tsx.
============================================================ #}
<footer class="w-full border-t border-neutral-200 bg-white pb-12 pt-16 font-sans text-neutral-800">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-8 lg:px-12">

        <div class="grid grid-cols-1 gap-12 border-b border-neutral-200 pb-14 lg:grid-cols-12 lg:gap-8">
            <div class="space-y-6 lg:col-span-5">
                <div class="flex select-none items-center gap-2">
                    <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-black text-white shadow-xs">
                        <span class="text-2xl font-black tracking-tighter text-gobuy-green">G</span><span class="text-base font-black">B</span>
                    </div>
                    <span class="text-2xl font-black tracking-tight text-black sm:text-3xl">Go<span class="text-gobuy-green">Buy</span></span>
                </div>

                <p class="max-w-sm text-sm leading-relaxed text-neutral-600">
                    La plateforme de livraison ultra-rapide à Madagascar. Courses du quotidien, repas savoureux, électronique et commerces de quartier livrés chez vous en 20 à 45 minutes.
                </p>

                <div class="flex flex-wrap items-center gap-3 pt-2">
                    <button type="button" data-alert="L'application mobile iOS GoBuy sera disponible très prochainement sur l'App Store."
                            class="group flex h-11 select-none items-center gap-3 rounded-xl bg-black px-4 text-white shadow-xs transition-colors hover:bg-neutral-800">
                        {{ ux_icon('tabler:brand-apple', { class: 'h-5 w-5 transition-transform group-hover:scale-105' }) }}
                        <span class="text-left leading-tight">
                            <span class="block text-[9px] font-medium text-neutral-300">Télécharger dans l'</span>
                            <span class="block text-xs font-bold tracking-wide">App Store</span>
                        </span>
                    </button>
                    <button type="button" data-alert="L'application mobile Android GoBuy sera disponible très prochainement sur Google Play."
                            class="group flex h-11 select-none items-center gap-3 rounded-xl bg-black px-4 text-white shadow-xs transition-colors hover:bg-neutral-800">
                        {{ ux_icon('tabler:brand-google-play', { class: 'h-5 w-5 transition-transform group-hover:scale-105' }) }}
                        <span class="text-left leading-tight">
                            <span class="block text-[8px] font-semibold uppercase tracking-wider text-neutral-300">Disponible sur</span>
                            <span class="block text-xs font-bold tracking-wide">Google Play</span>
                        </span>
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-10 lg:col-span-7">
                <ul class="space-y-3.5 text-sm font-medium text-neutral-800">
                    <li><button type="button" data-open-modal="company-info" data-info-section="faq" class="text-left hover:text-black hover:underline">Obtenir de l'aide</button></li>
                    <li>
                        <a href="{{ path('app_become_vendor') }}" class="group flex items-center gap-2 hover:text-black hover:underline">
                            <span>Ajoutez votre restaurant ou boutique</span>
                            <span class="rounded-full bg-gobuy-green px-2 py-0.5 text-[10px] font-black text-white">0 Ar</span>
                        </a>
                    </li>
                    <li><button type="button" data-open-modal="company-info" data-info-section="recruitment" class="text-left hover:text-black hover:underline">Inscrivez-vous pour livrer (Coursiers)</button></li>
                    <li><a href="{{ path('app_auth') }}?mode=register_supplier" class="hover:text-black hover:underline">Créez un compte professionnel</a></li>
                    <li><button type="button" data-open-modal="company-info" data-info-section="promotions" class="text-left font-bold text-gobuy-green hover:underline">Économisez sur votre première commande</button></li>
                    <li><button type="button" data-open-modal="company-info" data-info-section="promotions" class="text-left hover:text-black hover:underline">Cartes-cadeaux &amp; GoBuy Pass</button></li>
                </ul>

                <ul class="space-y-3.5 text-sm font-medium text-neutral-800">
                    <li><button type="button" data-open-modal="company-info" data-info-section="delivery_zones" class="text-left hover:text-black hover:underline">Boutiques et restaurants à proximité</button></li>
                    <li><button type="button" data-open-modal="company-info" data-info-section="delivery_zones" class="text-left hover:text-black hover:underline">Afficher toutes les villes à Madagascar</button></li>
                    <li><button type="button" data-open-modal="company-info" data-info-section="delivery_zones" class="text-left text-xs text-neutral-500 hover:text-black hover:underline">Antananarivo • Tamatave • Majunga • Antsirabe</button></li>
                    <li><button type="button" data-open-modal="company-info" data-info-section="about" class="text-left hover:text-black hover:underline">À propos de GoBuy</button></li>
                    <li><button type="button" data-open-modal="company-info" data-info-section="about" class="text-left hover:text-black hover:underline">En savoir plus sur nos engagements RSE</button></li>
                    <li><button type="button" data-open-modal="company-info" data-info-section="claims" class="text-left hover:text-black hover:underline">Centre de réclamations &amp; SAV</button></li>
                </ul>
            </div>
        </div>

        <div class="flex flex-col items-center justify-between gap-6 border-b border-neutral-200 py-8 sm:flex-row">
            <div class="flex items-center gap-4">
                {% for social in [
                    {href: 'https://facebook.com', label: 'f', title: 'Facebook GoBuy'},
                    {href: 'https://instagram.com', icon: 'tabler:brand-instagram', title: 'Instagram GoBuy'},
                    {href: 'https://linkedin.com', label: 'in', title: 'LinkedIn GoBuy SARL'},
                    {href: 'https://wa.me/261340000000', icon: 'tabler:brand-whatsapp', title: 'Support WhatsApp GoBuy'}
                ] %}
                    <a href="{{ social.href }}" target="_blank" rel="noreferrer" title="{{ social.title }}"
                       class="flex h-9 w-9 items-center justify-center rounded-full bg-neutral-100 text-neutral-700 shadow-2xs transition-all hover:bg-black hover:text-white">
                        {% if social.icon is defined %}{{ ux_icon(social.icon, {class: 'h-4 w-4'}) }}{% else %}<span class="text-sm font-black">{{ social.label }}</span>{% endif %}
                    </a>
                {% endfor %}
                <a href="https://twitter.com" target="_blank" rel="noreferrer" title="X GoBuy"
                   class="flex h-9 w-9 items-center justify-center rounded-full bg-neutral-100 text-neutral-700 shadow-2xs transition-all hover:bg-black hover:text-white">
                    {{ ux_icon('tabler:brand-x', {class: 'h-4 w-4'}) }}
                </a>
            </div>

            <div class="flex flex-wrap items-center gap-4">
                <div class="relative">
                    <button type="button" data-dropdown-toggle="lang-menu" aria-expanded="false"
                            class="flex items-center gap-2 rounded-full border border-neutral-300 px-3.5 py-2 text-xs font-bold text-neutral-800 transition-colors hover:border-black">
                        {{ ux_icon('tabler:world', { class: 'h-4 w-4 text-neutral-600' }) }}
                        <span data-lang-label>Français</span>
                        {{ ux_icon('tabler:chevron-down', { class: 'h-3.5 w-3.5 text-neutral-500' }) }}
                    </button>
                    <div id="lang-menu" class="hidden absolute bottom-full right-0 z-50 mb-2 w-44 rounded-2xl border border-neutral-200 bg-white py-1.5 shadow-xl">
                        {% for lang in [{code:'fr', label:'Français', flag:'🇫🇷'}, {code:'en', label:'English', flag:'🇬🇧'}, {code:'es', label:'Español', flag:'🇪🇸'}] %}
                            <button type="button" data-lang-option="{{ lang.label }}" class="flex w-full items-center justify-between px-4 py-2 text-left text-xs text-neutral-700 hover:bg-neutral-50">
                                <span class="flex items-center gap-2"><span>{{ lang.flag }}</span><span>{{ lang.label }}</span></span>
                            </button>
                        {% endfor %}
                    </div>
                </div>

                <div class="relative">
                    <button type="button" data-dropdown-toggle="currency-menu" aria-expanded="false"
                            class="flex items-center gap-2 rounded-full border border-neutral-300 px-3.5 py-2 text-xs font-bold text-neutral-800 transition-colors hover:border-black">
                        <span>🇲🇬</span><span data-currency-label>Ariary (MGA)</span>
                        {{ ux_icon('tabler:chevron-down', { class: 'h-3.5 w-3.5 text-neutral-500' }) }}
                    </button>
                    <div id="currency-menu" class="hidden absolute bottom-full right-0 z-50 mb-2 w-48 rounded-2xl border border-neutral-200 bg-white py-1.5 shadow-xl">
                        {% for curr in [{label:'Ariary (MGA)', flag:'🇲🇬'}, {label:'Euro (€ EUR)', flag:'🇪🇺'}, {label:'US Dollar ($ USD)', flag:'🇺🇸'}] %}
                            <button type="button" data-currency-option="{{ curr.label }}" class="flex w-full items-center justify-between px-4 py-2 text-left text-xs text-neutral-700 hover:bg-neutral-50">
                                <span class="flex items-center gap-2"><span>{{ curr.flag }}</span><span>{{ curr.label }}</span></span>
                            </button>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-6 pt-8">
            <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
                <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-medium text-neutral-600">
                    <button type="button" data-open-modal="company-info" data-info-section="legal" class="hover:text-black hover:underline">Politique de confidentialité</button>
                    <button type="button" data-open-modal="company-info" data-info-section="cgu" class="hover:text-black hover:underline">Conditions d'utilisation</button>
                    <button type="button" data-open-modal="company-info" data-info-section="cgv" class="hover:text-black hover:underline">Conditions générales de vente</button>
                    <button type="button" data-open-modal="company-info" data-info-section="promotions" class="hover:text-black hover:underline">Tarifs et frais de livraison</button>
                    <button type="button" data-open-modal="company-info" data-info-section="legal" class="text-neutral-500 hover:text-black hover:underline">Ne vendez pas et ne partagez pas mes informations personnelles</button>
                </div>
                <div class="shrink-0 text-xs text-neutral-500">© {{ 'now'|date('Y') }} GoBuy Technologies Inc. / GoBuy SARL.</div>
            </div>

            <div class="flex flex-col items-center justify-between gap-4 border-t border-neutral-100 pt-4 text-[11px] text-neutral-400 sm:flex-row">
                <p class="text-center sm:text-left">Ce site est protégé par reCAPTCHA. La Politique de confidentialité et les Conditions d'utilisation de Google s'appliquent.</p>

                <div class="flex flex-wrap items-center justify-center gap-2 sm:justify-end">
                    <div title="MVola Telma Madagascar" class="flex h-6 select-none items-center gap-1 rounded-md bg-mvola px-2 text-white shadow-2xs">
                        <span class="h-1.5 w-1.5 rounded-full bg-amber-300"></span><span class="text-[9px] font-black tracking-tight">MVola</span>
                    </div>
                    <div title="Orange Money Madagascar" class="flex h-6 select-none items-center gap-1 rounded-md bg-black px-2 text-white shadow-2xs">
                        <span class="h-2 w-2 rounded-xs bg-orange-money"></span><span class="text-[9px] font-bold">orange <span class="text-orange-money">money</span></span>
                    </div>
                    <div title="Airtel Money Madagascar" class="flex h-6 select-none items-center gap-1 rounded-md bg-airtel px-2 text-white shadow-2xs">
                        <span class="text-[9px] font-black italic">airtel</span>
                    </div>
                    <div title="Carte Bancaire VISA" class="flex h-6 select-none items-center justify-center rounded-md bg-visa px-2 text-white shadow-2xs">
                        <span class="text-[9px] font-black italic tracking-wider">VISA</span>
                    </div>
                    <div title="Mastercard International" class="flex h-6 select-none items-center gap-0.5 rounded-md border border-neutral-300 bg-white px-2 shadow-2xs">
                        <span class="flex items-center -space-x-1">
                            <span class="inline-block h-2.5 w-2.5 rounded-full bg-mastercard"></span>
                            <span class="inline-block h-2.5 w-2.5 rounded-full bg-amber-400/90"></span>
                        </span>
                        <span class="text-[8px] font-bold tracking-tight text-neutral-800">mastercard</span>
                    </div>
                    <button type="button" data-open-modal="symfony-inspector"
                            class="ml-2 flex items-center gap-1 text-neutral-500 transition-colors hover:text-black" title="Inspecteur Backend Symfony 8.2 / PHP 8.4">
                        {{ ux_icon('tabler:server', { class: 'h-3 w-3 text-gobuy-green' }) }}
                        <span>Symfony 8.2 • PHP 8.4</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</footer>
