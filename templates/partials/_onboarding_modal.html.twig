{# First-visit onboarding carousel (splash + 2 steps). Shown once, tracked in localStorage. #}
<div data-modal="onboarding" data-onboarding class="pointer-events-none fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/70 p-4 backdrop-blur-xs">
    <div class="pointer-events-auto relative flex min-h-[580px] w-full max-w-sm flex-col justify-between overflow-hidden rounded-3xl border border-slate-100 bg-white p-6 text-center shadow-2xl">
        <button type="button" data-modal-close title="Passer" class="absolute right-4 top-4 rounded-full p-2 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700">{{ ux_icon('tabler:x', { class: 'h-5 w-5' }) }}</button>

        <div data-onb-step="0" class="flex flex-1 flex-col items-center justify-center pt-8">
            <div class="mb-6 flex h-24 w-24 items-center justify-center rounded-3xl bg-black shadow-xl">
                <span class="text-5xl font-black tracking-tighter text-gobuy-green">G</span><span class="text-2xl font-black text-white">B</span>
            </div>
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Go<span class="text-gobuy-green">Buy</span></h1>
            <p class="mt-2 max-w-xs text-sm leading-relaxed text-slate-500">Vos produits préférés, au bout des doigts</p>
            <div class="mt-10 flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-emerald-600"></span><span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span><span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span></div>
            <div class="mt-10 w-full space-y-3">
                <button type="button" data-onb-next class="w-full rounded-2xl bg-emerald-600 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-emerald-600/25 transition-all hover:bg-emerald-700">Commencer</button>
                <p class="text-xs text-slate-500">Déjà un compte ? <button type="button" data-modal-close data-open-modal="auth" data-auth-mode="login" class="font-semibold text-emerald-600 hover:underline">Se connecter</button></p>
            </div>
        </div>

        <div data-onb-step="1" class="hidden flex-1 flex-col items-center justify-between pt-6">
            <div class="relative mb-4 flex h-48 w-48 items-center justify-center overflow-hidden rounded-2xl bg-emerald-50 p-4">
                <div class="absolute inset-0 bg-gradient-to-tr from-emerald-100/60 to-transparent"></div>
                <div class="relative z-10 flex h-36 w-24 flex-col items-center justify-between rounded-2xl border-2 border-emerald-500/20 bg-white p-2 shadow-lg">
                    <div class="mt-1 h-1 w-8 rounded-full bg-slate-200"></div>{{ ux_icon('tabler:shopping-bag', { class: 'h-10 w-10 text-emerald-600' }) }}<div class="mb-1 h-2 w-12 rounded-full bg-emerald-100"></div>
                </div>
            </div>
            <div class="space-y-2"><h2 class="text-xl font-bold leading-snug text-slate-900">Découvrez des milliers de produits</h2>
                <p class="max-w-xs text-xs leading-relaxed text-slate-500">Des produits de qualité, sélectionnés par des fournisseurs de confiance près de chez vous.</p></div>
            <div class="my-6 flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span><span class="h-2 w-2 rounded-full bg-emerald-600"></span><span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span></div>
            <button type="button" data-onb-next class="flex w-full items-center justify-center gap-1.5 rounded-2xl bg-emerald-600 px-6 py-3.5 text-sm font-semibold text-white shadow-md shadow-emerald-600/20 transition-all hover:bg-emerald-700"><span>Suivant</span>{{ ux_icon('tabler:chevron-right', { class: 'h-4 w-4' }) }}</button>
        </div>

        <div data-onb-step="2" class="hidden flex-1 flex-col items-center justify-between pt-6">
            <div class="relative mb-4 flex h-48 w-48 items-center justify-center overflow-hidden rounded-2xl bg-emerald-50 p-4">
                <div class="absolute inset-0 bg-gradient-to-tr from-emerald-100/60 to-transparent"></div>
                <div class="relative z-10 flex h-24 w-24 items-center justify-center rounded-full border-2 border-emerald-500/30 bg-white shadow-lg">{{ ux_icon('tabler:shield-check', { class: 'h-12 w-12 text-emerald-600' }) }}</div>
            </div>
            <div class="space-y-2"><h2 class="text-xl font-bold leading-snug text-slate-900">Commandez en toute sécurité</h2>
                <p class="max-w-xs text-xs leading-relaxed text-slate-500">Un processus simple et sécurisé pour une expérience d’achat sereine.</p></div>
            <div class="my-6 flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span><span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span><span class="h-2 w-2 rounded-full bg-emerald-600"></span></div>
            <button type="button" data-modal-close class="w-full rounded-2xl bg-emerald-600 px-6 py-3.5 text-sm font-semibold text-white shadow-md shadow-emerald-600/20 transition-all hover:bg-emerald-700">Commencer</button>
        </div>
    </div>
</div>
