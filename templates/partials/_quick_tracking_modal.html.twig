<div data-modal="quick-tracking" class="pointer-events-none fixed inset-0 z-[60] hidden items-center justify-center overflow-y-auto bg-slate-950/70 p-3 backdrop-blur-xs sm:p-4">
    <div class="pointer-events-auto my-auto flex w-full max-w-md flex-col overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50 p-4">
            <div class="flex items-center gap-2">
                <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">{{ ux_icon('tabler:package', { class: 'h-4 w-4' }) }}</span>
                <div><h3 class="text-sm font-bold text-slate-900">Suivi direct de commande</h3><p class="text-[11px] text-slate-500">Localisez votre colis en temps réel</p></div>
            </div>
            <button type="button" data-modal-close class="rounded-full p-1.5 text-slate-500 transition-colors hover:bg-slate-200">{{ ux_icon('tabler:x', { class: 'h-5 w-5' }) }}</button>
        </div>
        <div class="space-y-4 p-5">
            <form data-quick-tracking action="{{ path('app_order_tracking') }}" class="space-y-3">
                <div>
                    <label class="mb-1.5 block text-xs font-bold text-slate-800">Numéro de commande</label>
                    <div class="relative">
                        <input type="text" name="number" placeholder="Ex: MK123456 ou 123456" autocomplete="off" class="w-full rounded-2xl border border-slate-200 bg-slate-50 py-2.5 pl-3.5 pr-10 font-mono text-xs text-slate-900 focus:border-emerald-500 focus:outline-none">
                        <button type="submit" aria-label="Rechercher" class="absolute right-1.5 top-1.5 rounded-xl bg-emerald-600 p-1.5 text-white transition-colors hover:bg-emerald-700">{{ ux_icon('tabler:search', { class: 'h-4 w-4' }) }}</button>
                    </div>
                </div>
            </form>
            <div class="space-y-2 border-t border-slate-100 pt-2">
                <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-500">Commandes enregistrées récentes (0)</span>
                <p class="rounded-xl bg-slate-50 p-3 text-center text-[11px] text-slate-400">Aucune commande enregistrée pour le moment.</p>
            </div>
        </div>
    </div>
</div>
