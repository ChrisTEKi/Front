{# ============================================================
   Centre d'information GoBuy (port de CompanyInfoModal.tsx).
   Seuls 5 onglets sont visibles (à propos, recrutement, retours, promotions, contact) ; les autres sections
   (mentions légales, CGV, CGU, zones de livraison, FAQ, réclamations) s'ouvrent par les liens du pied de page
   (attribut data-info-section), comme dans la maquette. Tous les textes sont des clés de traduction (info.*).

   Règles « pas de données inventées » :
     - les formulaires (contact, réclamation, candidature) n'apparaissent que si l'adresse du support est configurée
       (GOBUY_SUPPORT_EMAIL) : ils envoient un VRAI e-mail via POST /support/message (voir SupportApiController) ;
     - téléphone / WhatsApp, e-mail, adresse, NIF, STAT et RCS viennent de la configuration (.env) et sont masqués
       s'ils sont vides ;
     - aucun code promo n'est affiché tant qu'il n'existe pas de système de codes promo.
============================================================ #}
{% set support_mail = support_email() %}
{% set has_whatsapp = support_whatsapp matches '/^\\+?[0-9]{8,15}$/' %}
{% set has_company = company.address or company.nif or company.stat or company.rcs %}
<div data-modal="company-info" class="pointer-events-none fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto bg-slate-950/60 p-2 backdrop-blur-xs sm:p-4">
    <div data-info class="pointer-events-auto my-auto flex max-h-[90vh] w-full max-w-2xl flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl">

        <div class="flex items-center justify-between border-b border-slate-100 p-4">
            <div class="flex items-center gap-2">
                <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">{{ ux_icon('tabler:building', { class: 'h-4 w-4' }) }}</span>
                <h2 class="text-sm font-bold text-slate-900">{{ 'info.title'|trans }}</h2>
            </div>
            <button type="button" data-modal-close aria-label="{{ 'modal.how.close'|trans }}" class="rounded-full p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700">{{ ux_icon('tabler:x', { class: 'h-5 w-5' }) }}</button>
        </div>

        {# Onglets : exactement 5, comme dans la maquette #}
        <div class="scrollbar-none flex items-center gap-1.5 overflow-x-auto border-b border-slate-200 bg-slate-100/70 px-4 py-2 text-xs font-semibold">
            {% for t in [
                {id: 'about', icon: 'tabler:building'},
                {id: 'recruitment', icon: 'tabler:briefcase'},
                {id: 'returns', icon: 'tabler:refresh'},
                {id: 'promotions', icon: 'tabler:tag'},
                {id: 'contact', icon: 'tabler:phone-call'}
            ] %}
                <button type="button" data-info-tab="{{ t.id }}" class="flex shrink-0 items-center gap-1.5 rounded-xl px-3 py-1.5 text-slate-600 transition-all hover:bg-slate-200">
                    {{ ux_icon(t.icon, { class: 'h-3.5 w-3.5' }) }}<span>{{ ('info.tab.' ~ t.id)|trans }}</span>
                </button>
            {% endfor %}
        </div>

        <div class="flex-1 space-y-4 overflow-y-auto p-5 text-xs">

            {# ---- À PROPOS ---- #}
            <div data-info-panel="about" class="hidden space-y-4">
                <div class="space-y-2 rounded-2xl border border-emerald-100 bg-emerald-50 p-4 text-emerald-950">
                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-emerald-700">{{ ux_icon('tabler:sparkles', {class:'h-3 w-3'}) }} {{ 'info.about.badge'|trans }}</span>
                    <h4 class="text-sm font-bold text-emerald-900">{{ 'info.about.title'|trans }}</h4>
                    <p class="text-[11px] leading-relaxed text-emerald-800">{{ 'info.about.text'|trans({'%brand%': '<strong>GoBuy</strong>'})|raw }}</p>
                </div>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div class="space-y-1.5 rounded-2xl border border-slate-100 bg-slate-50 p-3.5">
                        <div class="flex items-center gap-2 text-xs font-bold text-slate-900">{{ ux_icon('tabler:shield-check', {class:'h-4 w-4 text-emerald-600'}) }}<span>{{ 'info.about.cert_title'|trans }}</span></div>
                        <p class="text-[11px] text-slate-600">{{ 'info.about.cert_text'|trans }}</p>
                    </div>
                    <div class="space-y-1.5 rounded-2xl border border-slate-100 bg-slate-50 p-3.5">
                        <div class="flex items-center gap-2 text-xs font-bold text-slate-900">{{ ux_icon('tabler:clock', {class:'h-4 w-4 text-emerald-600'}) }}<span>{{ 'info.about.express_title'|trans }}</span></div>
                        <p class="text-[11px] text-slate-600">{{ 'info.about.express_text'|trans }}</p>
                    </div>
                </div>
                {% if has_company %}
                    <div class="space-y-1 rounded-2xl border border-slate-100 bg-slate-50 p-3.5 text-[11px] text-slate-600">
                        {% if company.address %}<p><strong>{{ 'info.company.address'|trans }}</strong> {{ company.address }}</p>{% endif %}
                        {% if company.nif or company.stat %}<p>{% if company.nif %}<strong>{{ 'info.company.nif'|trans }}</strong> {{ company.nif }}{% endif %}{% if company.nif and company.stat %} / {% endif %}{% if company.stat %}<strong>{{ 'info.company.stat'|trans }}</strong> {{ company.stat }}{% endif %}</p>{% endif %}
                    </div>
                {% endif %}
            </div>

            {# ---- RECRUTEMENT : aucune offre inventée ; candidature spontanée envoyée au support ---- #}
            <div data-info-panel="recruitment" class="hidden space-y-4">
                <div><h4 class="text-sm font-bold text-slate-900">{{ 'info.recruit.title'|trans }}</h4><p class="text-[11px] text-slate-500">{{ 'info.recruit.sub'|trans }}</p></div>
                {% if support_mail %}
                    <form data-support-form="job" class="space-y-3 rounded-2xl border-2 border-emerald-500/30 bg-white p-4">
                        <span class="block text-xs font-bold text-slate-900">{{ 'info.recruit.form_title'|trans }}</span>
                        <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
                            <div><label class="mb-1 block text-[10px] font-bold text-slate-600">{{ 'info.recruit.name'|trans }}</label><input type="text" name="name" required maxlength="100" autocomplete="name" placeholder="{{ 'info.recruit.name_ph'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs focus:border-emerald-500 focus:outline-none"></div>
                            <div><label class="mb-1 block text-[10px] font-bold text-slate-600">{{ 'info.recruit.contact'|trans }}</label><input type="text" name="contact" required maxlength="180" placeholder="{{ 'info.recruit.contact_ph'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs focus:border-emerald-500 focus:outline-none"></div>
                        </div>
                        <div><label class="mb-1 block text-[10px] font-bold text-slate-600">{{ 'info.recruit.experience'|trans }}</label><textarea name="message" required minlength="5" maxlength="2000" rows="3" placeholder="{{ 'info.recruit.experience_ph'|trans }}" class="w-full resize-none rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs focus:border-emerald-500 focus:outline-none"></textarea></div>
                        <p data-support-error role="alert" class="hidden rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-[11px] font-semibold text-rose-700"></p>
                        <button type="submit" class="flex items-center gap-1.5 rounded-xl bg-emerald-600 px-4 py-2 text-xs font-semibold text-white hover:bg-emerald-700 disabled:opacity-60">{{ ux_icon('tabler:send', {class:'h-3.5 w-3.5'}) }}<span>{{ 'info.recruit.submit'|trans }}</span></button>
                        <p data-support-sent role="status" class="hidden flex items-center gap-2 rounded-xl bg-emerald-500 p-3 text-xs font-semibold text-white">{{ ux_icon('tabler:check', {class:'h-4 w-4 shrink-0'}) }}<span data-support-sent-text></span></p>
                    </form>
                {% else %}
                    <p class="rounded-2xl border border-slate-100 bg-slate-50 p-3.5 text-[11px] text-slate-500">{{ 'info.form.unavailable'|trans }}</p>
                {% endif %}
            </div>

            {# ---- RETOURS ---- #}
            <div data-info-panel="returns" class="hidden space-y-4">
                <div class="space-y-2 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-amber-950">
                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-amber-800">{{ ux_icon('tabler:refresh', {class:'h-3 w-3'}) }} {{ 'info.returns.badge'|trans }}</span>
                    <h4 class="text-sm font-bold text-amber-900">{{ 'info.returns.title'|trans }}</h4>
                    <p class="text-[11px] leading-relaxed text-amber-800">{{ 'info.returns.text'|trans({'%days%': 'info.returns.days'|trans})|raw }}</p>
                </div>
                <div class="space-y-2.5">
                    <h5 class="text-xs font-bold text-slate-900">{{ 'info.returns.how'|trans }}</h5>
                    <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-3">
                        {% for n in 1..3 %}
                            <div class="space-y-1 rounded-2xl border border-slate-100 bg-slate-50 p-3"><span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">{{ n }}</span><strong class="block text-[11px] text-slate-800">{{ ('info.returns.s' ~ n ~ '_t')|trans }}</strong><p class="text-[10px] text-slate-500">{{ ('info.returns.s' ~ n ~ '_d')|trans }}</p></div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# ---- PROMOTIONS : aucun code tant qu'il n'existe pas de vrai système de codes promo ---- #}
            <div data-info-panel="promotions" class="hidden space-y-4">
                <div><h4 class="text-sm font-bold text-slate-900">{{ 'info.promo.title'|trans }}</h4><p class="text-[11px] text-slate-500">{{ 'info.promo.sub'|trans }}</p></div>
                <div class="space-y-1 rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-8 text-center text-xs text-slate-400">
                    {{ ux_icon('tabler:tag', { class: 'mx-auto mb-2 h-8 w-8 text-slate-300' }) }}
                    <p class="font-semibold text-slate-700">{{ 'info.promo.empty'|trans }}</p>
                    <p class="text-[11px]">{{ 'info.promo.empty_sub'|trans }}</p>
                </div>
            </div>

            {# ---- CONTACT ---- #}
            <div data-info-panel="contact" class="hidden space-y-4">
                {% if has_whatsapp or support_mail %}
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                        {% if has_whatsapp %}
                            <div class="space-y-2 rounded-2xl border border-slate-100 bg-slate-50 p-3.5">
                                <div class="flex items-center gap-2 text-xs font-bold text-slate-900">{{ ux_icon('tabler:phone-call', {class:'h-4 w-4 text-emerald-600'}) }}<span>{{ 'info.contact.phone_title'|trans }}</span></div>
                                <a href="https://wa.me/{{ support_whatsapp|trim('+', 'left') }}" target="_blank" rel="noreferrer" class="block text-sm font-bold text-emerald-700 hover:underline">+{{ support_whatsapp|trim('+', 'left') }}</a>
                            </div>
                        {% endif %}
                        {% if support_mail %}
                            <div class="space-y-2 rounded-2xl border border-slate-100 bg-slate-50 p-3.5">
                                <div class="flex items-center gap-2 text-xs font-bold text-slate-900">{{ ux_icon('tabler:mail', {class:'h-4 w-4 text-emerald-600'}) }}<span>{{ 'info.contact.email_title'|trans }}</span></div>
                                <a href="mailto:{{ support_mail }}" class="block break-all text-sm font-bold text-emerald-700 hover:underline">{{ support_mail }}</a>
                            </div>
                        {% endif %}
                    </div>
                {% else %}
                    <p class="rounded-2xl border border-slate-100 bg-slate-50 p-3.5 text-[11px] text-slate-500">{{ 'info.contact.soon'|trans }}</p>
                {% endif %}
                {% if support_mail %}
                    <form data-support-form="contact" class="space-y-3 rounded-2xl border border-slate-200 bg-slate-50 p-4">
                        <h5 class="text-xs font-bold text-slate-900">{{ 'info.contact.form_title'|trans }}</h5>
                        <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
                            <div><label class="mb-1 block text-[10px] font-bold text-slate-600">{{ 'info.contact.name'|trans }}</label><input type="text" name="name" required maxlength="100" autocomplete="name" placeholder="{{ 'info.contact.name_ph'|trans }}" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs focus:border-emerald-500 focus:outline-none"></div>
                            <div><label class="mb-1 block text-[10px] font-bold text-slate-600">{{ 'info.contact.contact'|trans }}</label><input type="text" name="contact" required maxlength="180" placeholder="{{ 'info.contact.contact_ph'|trans }}" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs focus:border-emerald-500 focus:outline-none"></div>
                        </div>
                        <div><label class="mb-1 block text-[10px] font-bold text-slate-600">{{ 'info.contact.request'|trans }}</label><textarea name="message" required minlength="5" maxlength="2000" rows="3" placeholder="{{ 'info.contact.request_ph'|trans }}" class="w-full resize-none rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs focus:border-emerald-500 focus:outline-none"></textarea></div>
                        <p data-support-error role="alert" class="hidden rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-[11px] font-semibold text-rose-700"></p>
                        <button type="submit" class="flex items-center gap-1.5 rounded-xl bg-emerald-600 px-4 py-2 text-xs font-semibold text-white hover:bg-emerald-700 disabled:opacity-60">{{ ux_icon('tabler:send', {class:'h-3.5 w-3.5'}) }}<span>{{ 'info.contact.submit'|trans }}</span></button>
                        <p data-support-sent role="status" class="hidden flex items-center gap-2 rounded-xl bg-emerald-500 p-3 text-xs font-semibold text-white">{{ ux_icon('tabler:check', {class:'h-4 w-4 shrink-0'}) }}<span data-support-sent-text></span></p>
                    </form>
                {% endif %}
            </div>

            {# ---- MENTIONS LÉGALES (lien du pied de page uniquement) : seules les informations configurées sont affichées ---- #}
            <div data-info-panel="legal" class="hidden space-y-4 text-xs leading-relaxed text-slate-600">
                <div class="space-y-1.5 rounded-2xl border border-amber-200 bg-amber-50/70 p-4 text-amber-950">
                    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-amber-800">{{ 'info.legal.badge'|trans }}</span>
                    <h4 class="text-base font-bold text-amber-900">GoBuy</h4>
                </div>
                {% if has_company %}
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                        {% if company.address %}
                            <div class="space-y-1 rounded-2xl border border-slate-200/80 bg-slate-50 p-3.5"><span class="text-[10px] font-bold uppercase text-slate-400">{{ 'info.legal.head'|trans }}</span>
                                <p class="font-semibold text-slate-800">{{ company.address }}</p></div>
                        {% endif %}
                        {% if company.rcs or company.nif or company.stat %}
                            <div class="space-y-1 rounded-2xl border border-slate-200/80 bg-slate-50 p-3.5"><span class="text-[10px] font-bold uppercase text-slate-400">{{ 'info.legal.registry'|trans }}</span>
                                {% if company.rcs %}<p class="text-slate-700"><strong>{{ 'info.company.rcs'|trans }}</strong> {{ company.rcs }}</p>{% endif %}
                                {% if company.nif %}<p class="text-slate-700"><strong>{{ 'info.company.nif'|trans }}</strong> {{ company.nif }}</p>{% endif %}
                                {% if company.stat %}<p class="text-slate-700"><strong>{{ 'info.company.stat'|trans }}</strong> {{ company.stat }}</p>{% endif %}</div>
                        {% endif %}
                    </div>
                {% else %}
                    <p class="rounded-2xl border border-slate-100 bg-slate-50 p-3.5 text-[11px] text-slate-500">{{ 'info.company.soon'|trans }}</p>
                {% endif %}
                <div class="space-y-1.5 rounded-2xl border border-slate-200/80 bg-slate-50 p-3.5">
                    <span class="text-[10px] font-bold uppercase text-slate-400">{{ 'info.legal.publication'|trans }}</span>
                    <p class="text-slate-700">{{ 'info.legal.publisher'|trans }}{% if support_mail %}<br><strong>{{ support_mail }}</strong>{% endif %}</p>
                    <p class="border-t border-slate-200 pt-1 text-[11px] text-slate-500">{{ 'info.legal.compliance'|trans }}</p>
                </div>
            </div>

            {# ---- CGV (lien du pied de page uniquement) ---- #}
            <div data-info-panel="cgv" class="hidden space-y-3.5 text-xs leading-relaxed text-slate-600">
                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-3.5"><h4 class="text-sm font-bold text-slate-900">{{ 'info.cgv.title'|trans }}</h4></div>
                <div class="scrollbar-thin max-h-[340px] space-y-3 overflow-y-auto pr-2">
                    {% for n in 1..4 %}
                        <div class="space-y-1"><h5 class="font-bold text-slate-900">{{ ('info.cgv.a' ~ n ~ '_t')|trans }}</h5><p class="text-[11px] text-slate-500">{{ ('info.cgv.a' ~ n ~ '_d')|trans({'%currency%': 'info.cgv.currency'|trans})|raw }}</p></div>
                    {% endfor %}
                </div>
            </div>

            {# ---- CGU (lien du pied de page uniquement) ---- #}
            <div data-info-panel="cgu" class="hidden space-y-3.5 text-xs leading-relaxed text-slate-600">
                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-3.5"><h4 class="text-sm font-bold text-slate-900">{{ 'info.cgu.title'|trans }}</h4><p class="mt-0.5 text-[11px] text-slate-500">{{ 'info.cgu.sub'|trans }}</p></div>
                <div class="scrollbar-thin max-h-[340px] space-y-3 overflow-y-auto pr-2">
                    {% for n in 1..3 %}
                        <div class="space-y-1"><h5 class="font-bold text-slate-900">{{ ('info.cgu.a' ~ n ~ '_t')|trans }}</h5><p class="text-[11px] text-slate-500">{{ ('info.cgu.a' ~ n ~ '_d')|trans }}</p></div>
                    {% endfor %}
                </div>
            </div>

            {# ---- ZONES DE LIVRAISON (lien du pied de page uniquement) : le forfait affiché est celui facturé par le serveur ---- #}
            <div data-info-panel="delivery_zones" class="hidden space-y-4 text-xs leading-relaxed text-slate-600">
                <div class="space-y-1 rounded-2xl border border-emerald-200 bg-emerald-50 p-3.5 text-emerald-950">
                    <h4 class="text-sm font-bold text-emerald-900">{{ 'info.zones.title'|trans }}</h4>
                    <p class="text-xs text-emerald-800">{{ 'info.zones.sub'|trans }}</p>
                </div>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div class="space-y-2 rounded-2xl border border-slate-200 bg-slate-50 p-3.5">
                        <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold uppercase text-emerald-700">{{ 'info.zones.tana'|trans }}</span>
                        <ul class="space-y-1 font-medium text-slate-700">
                            <li>• {{ 'info.zones.tana1'|trans }}</li>
                            <li>• {{ 'info.zones.tana2'|trans }}</li>
                            <li>• {{ 'info.zones.fee'|trans({'%fee%': delivery_fee(1)|format_number(locale: app.request.locale)}) }}</li>
                        </ul>
                    </div>
                    <div class="space-y-2 rounded-2xl border border-slate-200 bg-slate-50 p-3.5">
                        <span class="rounded-full bg-blue-100 px-2 py-0.5 text-[10px] font-bold uppercase text-blue-700">{{ 'info.zones.prov'|trans }}</span>
                        <ul class="space-y-1 font-medium text-slate-700">
                            {% for n in 1..4 %}<li>• {{ ('info.zones.prov' ~ n)|trans }}</li>{% endfor %}
                        </ul>
                    </div>
                </div>
                <p class="text-[11px] text-slate-400">{{ 'info.zones.note'|trans }}</p>
            </div>

            {# ---- FAQ (lien du pied de page uniquement) ---- #}
            <div data-info-panel="faq" class="hidden space-y-3 text-xs leading-relaxed text-slate-600">
                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-3.5"><h4 class="text-sm font-bold text-slate-900">{{ 'info.faq.title'|trans }}</h4><p class="text-[11px] text-slate-500">{{ 'info.faq.sub'|trans }}</p></div>
                <div class="max-h-[340px] space-y-2.5 overflow-y-auto pr-1">
                    {% for n in 1..3 %}
                        <div class="space-y-1 rounded-xl border border-slate-200 bg-slate-50 p-3"><p class="font-bold text-slate-900">{{ ('info.faq.q' ~ n)|trans }}</p><p class="text-[11px] text-slate-500">{{ ('info.faq.a' ~ n)|trans }}</p></div>
                    {% endfor %}
                </div>
            </div>

            {# ---- RÉCLAMATIONS (lien du pied de page uniquement) ---- #}
            <div data-info-panel="claims" class="hidden space-y-4 text-xs leading-relaxed text-slate-600">
                <div class="space-y-1 rounded-2xl border border-rose-200 bg-rose-50 p-3.5 text-rose-950">
                    <h4 class="text-sm font-bold text-rose-900">{{ 'info.claims.title'|trans }}</h4>
                    <p class="text-xs text-rose-800">{{ 'info.claims.text'|trans }}</p>
                </div>
                {% if support_mail %}
                    <form data-support-form="claim" class="space-y-3 rounded-2xl border border-slate-200 bg-slate-50 p-4">
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                            <div><label class="mb-1 block text-[10px] font-bold text-slate-700">{{ 'info.claims.order'|trans }}</label><input type="text" name="order" required maxlength="40" placeholder="{{ 'info.claims.order_ph'|trans }}" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs focus:border-emerald-500 focus:outline-none"></div>
                            <div><label class="mb-1 block text-[10px] font-bold text-slate-700">{{ 'info.claims.reason'|trans }}</label>
                                <select name="reason" required class="w-full rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs focus:border-emerald-500 focus:outline-none">
                                    {% for r in ['damaged', 'delay', 'missing', 'refund', 'other'] %}<option value="{{ r }}">{{ ('info.claims.r_' ~ r)|trans }}</option>{% endfor %}
                                </select></div>
                        </div>
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                            <div><label class="mb-1 block text-[10px] font-bold text-slate-700">{{ 'info.contact.name'|trans }} *</label><input type="text" name="name" required maxlength="100" autocomplete="name" placeholder="{{ 'info.contact.name_ph'|trans }}" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs focus:border-emerald-500 focus:outline-none"></div>
                            <div><label class="mb-1 block text-[10px] font-bold text-slate-700">{{ 'info.claims.contact'|trans }}</label><input type="text" name="contact" required maxlength="180" placeholder="{{ 'info.claims.contact_ph'|trans }}" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs focus:border-emerald-500 focus:outline-none"></div>
                        </div>
                        <div><label class="mb-1 block text-[10px] font-bold text-slate-700">{{ 'info.claims.details'|trans }}</label><textarea name="message" required minlength="5" maxlength="2000" rows="3" placeholder="{{ 'info.claims.details_ph'|trans }}" class="w-full resize-none rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs focus:border-emerald-500 focus:outline-none"></textarea></div>
                        <p data-support-error role="alert" class="hidden rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-[11px] font-semibold text-rose-700"></p>
                        <button type="submit" class="rounded-xl bg-rose-600 px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-rose-700 disabled:opacity-60">{{ 'info.claims.submit'|trans }}</button>
                        <p data-support-sent role="status" class="hidden flex items-center gap-2 rounded-2xl bg-emerald-500 p-4 text-xs font-semibold text-white">{{ ux_icon('tabler:check', {class:'h-5 w-5 shrink-0'}) }}<span data-support-sent-text></span></p>
                    </form>
                {% else %}
                    <p class="rounded-2xl border border-slate-100 bg-slate-50 p-3.5 text-[11px] text-slate-500">{{ 'info.form.unavailable'|trans }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
