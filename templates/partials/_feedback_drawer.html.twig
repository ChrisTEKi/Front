{# Fixed vertical "Feedback" tab on the right edge + drawer with a satisfaction form #}
<button type="button" data-drawer-toggle="feedback-drawer" title="Donner un avis"
        class="fixed right-0 top-1/2 z-40 -translate-y-1/2 select-none rounded-l-md bg-[#1d232a] px-2 py-4 text-xs font-bold tracking-wider text-white shadow-lg transition-all [writing-mode:vertical-rl] hover:bg-black">Feedback</button>

<div id="feedback-drawer" class="pointer-events-none fixed inset-0 z-50">
    <div data-drawer-overlay data-drawer-close class="absolute inset-0 bg-slate-950/40 opacity-0 backdrop-blur-xs transition-opacity duration-200"></div>
    <div data-drawer-panel data-drawer-closed="translate-x-full" class="absolute right-0 top-0 flex h-full w-full max-w-sm translate-x-full flex-col justify-between bg-white shadow-2xl transition-transform duration-200">
        <div>
            <div class="flex items-center justify-between border-b border-slate-100 p-4">
                <div><h3 class="text-sm font-bold text-slate-900">Feedback</h3><p class="text-[11px] text-slate-500">Avis utilisateur</p></div>
                <button type="button" data-drawer-close class="rounded-full p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700">{{ ux_icon('tabler:x', { class: 'h-5 w-5' }) }}</button>
            </div>
            <div class="space-y-3 p-4 text-xs" data-feedback>
                <span class="text-xs font-bold text-slate-900">Donnez votre avis sur le service</span>
                <div data-feedback-done class="hidden space-y-1 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-center text-emerald-800">
                    {{ ux_icon('tabler:check', { class: 'mx-auto h-6 w-6 text-emerald-600' }) }}
                    <p class="text-xs font-bold">Misaotra betsaka !</p>
                    <p class="text-[11px]">Votre avis a bien été transmis à nos équipes à Antananarivo.</p>
                </div>
                <form data-feedback-form class="space-y-3">
                    <div data-mood-group class="flex items-center justify-around rounded-xl border border-stone-200 bg-stone-50 p-2">
                        {% for mood in ['😊', '😐', '🙁'] %}<button type="button" data-mood class="rounded-lg p-1.5 text-2xl opacity-60 transition-transform">{{ mood }}</button>{% endfor %}
                    </div>
                    <textarea rows="3" placeholder="Une remarque, une question sur notre reconditionnement ou un problème technique ?" class="w-full resize-none rounded-xl border border-neutral-200 p-3 text-xs focus:outline-none focus:ring-2 focus:ring-black"></textarea>
                    <button type="submit" class="w-full rounded-full bg-black py-2.5 text-xs font-bold text-white shadow-xs transition-colors hover:bg-neutral-800">Envoyer mon retour</button>
                </form>
                <button type="button" data-drawer-close data-open-modal="how-it-works" class="w-full rounded-xl border border-slate-200 p-3 text-left font-bold text-slate-900 hover:bg-slate-50">Comment ça marche ?</button>
            </div>
        </div>
        <div class="border-t border-slate-200 bg-stone-50 p-4 text-center text-[11px] text-slate-500">GoBuy Madagascar • Reconditionné &amp; Garanti</div>
    </div>
</div>
