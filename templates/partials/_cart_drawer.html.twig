{# ============================================================
   Tiroir du panier (glisse depuis la droite).

   Le panier est mémorisé dans le navigateur (voir assets/cart.js) : ce gabarit ne contient donc que la structure ; le
   JavaScript remplit `data-cart-lines` et les montants. Les montants affichés sont indicatifs : à la commande, le serveur
   recalcule tout depuis le catalogue (OrderService).
============================================================ #}
<div id="cart-drawer" data-cart-view="drawer" class="pointer-events-none fixed inset-0 z-50 overflow-hidden">
    <div data-drawer-overlay data-drawer-close class="absolute inset-0 bg-slate-950/50 opacity-0 backdrop-blur-xs transition-opacity duration-200"></div>
    <div data-drawer-panel data-drawer-closed="translate-x-full" class="absolute right-0 top-0 flex h-full w-full max-w-md translate-x-full flex-col justify-between bg-white shadow-2xl transition-transform duration-200">

        <div class="flex items-center justify-between border-b border-slate-100 p-4 sm:p-5">
            <div>
                <h2 class="text-lg font-bold text-slate-900">{{ 'cart.title'|trans }}</h2>
                <p class="text-xs text-slate-500" data-cart-items-count></p>
            </div>
            <button type="button" data-drawer-close aria-label="{{ 'common.close'|trans }}" class="rounded-full p-2 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700">{{ ux_icon('tabler:x', { class: 'h-5 w-5' }) }}</button>
        </div>

        <div class="flex-1 space-y-4 overflow-y-auto p-4 sm:p-5">
            <div data-cart-empty class="flex h-full flex-col items-center justify-center p-6 text-center">
                <div class="mb-3 flex h-16 w-16 items-center justify-center rounded-full bg-slate-100 text-slate-400">{{ ux_icon('tabler:shopping-bag', { class: 'h-8 w-8' }) }}</div>
                <h3 class="text-sm font-semibold text-slate-800">{{ 'cart.empty_title'|trans }}</h3>
                <p class="mt-1 max-w-xs text-xs text-slate-500">{{ 'cart.empty_text'|trans }}</p>
            </div>
            <div data-cart-lines class="space-y-4"></div>
        </div>

        <div data-cart-filled class="hidden space-y-3 border-t border-slate-200 bg-white p-4 sm:p-5">
            <div class="space-y-1.5 text-xs">
                <div class="flex justify-between text-slate-500"><span>{{ 'cart.subtotal'|trans }}</span><span class="font-mono font-semibold text-slate-800" data-cart-subtotal></span></div>
                <div class="flex justify-between text-slate-500"><span>{{ 'cart.shipping'|trans }}</span><span class="font-mono font-semibold text-slate-800" data-cart-shipping></span></div>
                <div class="flex justify-between border-t border-slate-100 pt-2 text-sm font-black text-slate-950"><span>{{ 'cart.total'|trans }}</span><span class="font-mono text-base" data-cart-total></span></div>
            </div>
            <div class="flex items-center justify-between rounded-xl border border-neutral-200 bg-neutral-50 p-2.5 text-xs">
                <span class="flex items-center gap-1.5 text-[11px] font-medium text-neutral-800"><span class="h-2 w-2 rounded-full bg-gobuy-green"></span><span>{{ 'cart.eligible'|trans|raw }}</span></span>
                <span class="rounded border border-neutral-200 bg-white px-2 py-0.5 font-mono text-[10px] font-bold text-neutral-900">{{ 'cart.from'|trans }} <span data-cart-monthly></span>{{ 'cart.per_month'|trans }}</span>
            </div>
            <a href="{{ path('app_checkout') }}" class="flex w-full items-center justify-center gap-2 rounded-full bg-black px-6 py-4 text-xs font-black uppercase tracking-wider text-white shadow-sm transition-all hover:bg-neutral-800">
                <span>{{ 'cart.checkout'|trans }}</span>{{ ux_icon('tabler:arrow-right', { class: 'h-4 w-4 text-gobuy-green' }) }}
            </a>
        </div>
    </div>
</div>
