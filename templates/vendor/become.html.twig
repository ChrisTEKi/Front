{# Page « Devenir partenaire » : présentation du programme, simulateur de commissions, FAQ, puis assistant de candidature en 4 étapes.
   - Tous les textes viennent de translations/messages.<langue>.yaml (clés « vendor.* ») : FR / EN / ES.
   - L'assistant envoie ses réponses à l'inscription fournisseur (POST /auth/register/supplier, JSON) :
       · les champs obligatoires du compte (nom, e-mail, téléphone, mot de passe, société, adresse) sont tous à l'ÉTAPE 1 ;
       · les autres réponses partent dans l'objet « application » (colonne JSONB supplier_profiles.application) ;
       · ensuite le visiteur vérifie son e-mail puis son téléphone (page /connexion), et un administrateur examine le dossier.
   - Le comportement (étapes, simulateur, envoi) est dans assets/app.js → initVendorForm(). #}
{% extends 'base.html.twig' %}
{% block title %}{{ 'vendor.page_title'|trans }}{% endblock %}

{% block body %}
{# `commissionRates` (barème par rayon) et `proRent` (loyer Pro) viennent de App\Supplier\CommissionSchedule via le contrôleur. #}
{# Numéro WhatsApp du support : le bouton n'apparaît que s'il est configuré (GOBUY_SUPPORT_WHATSAPP). #}
{% set whatsapp = support_whatsapp matches '/^\\+?[0-9]{8,15}$/' ? support_whatsapp|trim('+', 'left') : null %}
{% set inputClass = 'w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2' %}

<div data-vendor-page data-vendor-endpoint="{{ path('auth_register_supplier') }}" data-vendor-next-url="{{ path('app_auth', {view: 'resume'}) }}" class="w-full">

    {# ---------- Présentation ---------- #}
    <div data-vendor-view="landing" class="space-y-16 p-4 pb-20 sm:p-8 lg:p-12">

        <section class="relative overflow-hidden bg-gradient-to-b from-emerald-950 via-slate-900 to-slate-950 px-4 py-16 text-center text-white sm:px-8 sm:py-24">
            <div class="relative z-10 mx-auto max-w-5xl space-y-6">
                <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/20 px-3 py-1 text-xs font-bold uppercase tracking-wider text-emerald-300">{{ ux_icon('tabler:sparkles', {class:'h-3.5 w-3.5 text-emerald-400'}) }}{{ 'vendor.hero.badge'|trans }}</span>
                <h1 class="mx-auto max-w-4xl text-3xl font-black leading-tight tracking-tight sm:text-5xl lg:text-6xl">{{ 'vendor.hero.title_a'|trans }}<span class="text-emerald-400">{{ 'vendor.hero.title_hl'|trans }}</span>{{ 'vendor.hero.title_b'|trans }}</h1>
                <p class="mx-auto max-w-2xl text-sm leading-relaxed text-slate-300 sm:text-base">{{ 'vendor.hero.text'|trans }}</p>
                <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
                    <button type="button" data-vendor-open-form="1" class="flex items-center gap-2 rounded-2xl bg-emerald-500 px-7 py-4 text-sm font-bold text-white shadow-xl shadow-emerald-500/30 transition-all hover:-translate-y-0.5 hover:bg-emerald-600">{{ ux_icon('tabler:sparkles', {class:'h-4 w-4'}) }}<span>{{ 'vendor.hero.cta_start'|trans }}</span>{{ ux_icon('tabler:arrow-right', {class:'h-4 w-4'}) }}</button>
                    <button type="button" data-vendor-open-form="1" class="rounded-2xl border border-white/20 bg-white/10 px-6 py-4 text-sm font-bold text-white backdrop-blur-xs transition-all hover:bg-white/15">{{ 'vendor.hero.cta_file'|trans }}</button>
                    <a href="#simulateur-revenus" class="px-5 py-4 text-xs font-semibold text-slate-300 underline underline-offset-4 transition-colors hover:text-white">{{ 'vendor.hero.cta_calc'|trans }}</a>
                </div>
                <div class="mx-auto grid max-w-4xl grid-cols-2 gap-4 pt-12 md:grid-cols-4">
                    {% for n in 1..4 %}
                        <div class="space-y-1 rounded-2xl border border-white/10 bg-white/5 p-4 text-center backdrop-blur-xs"><div class="text-2xl font-black text-emerald-400">{{ ('vendor.hero.stat' ~ n ~ '_v')|trans }}</div><div class="text-xs font-medium text-slate-300">{{ ('vendor.hero.stat' ~ n ~ '_l')|trans }}</div></div>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="relative z-10 mx-auto -mt-8 max-w-5xl px-4 sm:px-8">
            <div class="space-y-6 rounded-3xl border border-slate-200/90 bg-white p-6 shadow-xl sm:p-8">
                <div class="mx-auto max-w-2xl space-y-2 text-center">
                    <span class="rounded-full bg-emerald-100 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-emerald-800">{{ 'vendor.invite.badge'|trans }}</span>
                    <h2 class="text-xl font-bold text-slate-900 sm:text-2xl">{{ 'vendor.invite.title'|trans }}</h2>
                    <p class="text-xs leading-relaxed text-slate-600 sm:text-sm">{{ 'vendor.invite.text'|trans }}</p>
                </div>
                <div class="grid grid-cols-1 gap-4 pt-2 md:grid-cols-3">
                    <div class="space-y-2 rounded-2xl border border-slate-200/80 bg-slate-50 p-4"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 font-bold text-emerald-800">{{ ux_icon('tabler:trending-up', {class:'h-5 w-5'}) }}</span><h3 class="text-sm font-bold text-slate-900">{{ 'vendor.invite.c1_t'|trans }}</h3><p class="text-xs leading-relaxed text-slate-500">{{ 'vendor.invite.c1_d'|trans }}</p></div>
                    <div class="space-y-2 rounded-2xl border border-slate-200/80 bg-slate-50 p-4"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-100 font-bold text-blue-800">{{ ux_icon('tabler:file-spreadsheet', {class:'h-5 w-5'}) }}</span><h3 class="text-sm font-bold text-slate-900">{{ 'vendor.invite.c2_t'|trans }}</h3><p class="text-xs leading-relaxed text-slate-500">{{ 'vendor.invite.c2_d'|trans }}</p></div>
                    <div class="space-y-2 rounded-2xl border border-slate-200/80 bg-slate-50 p-4"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-100 font-bold text-purple-800">{{ ux_icon('tabler:shield-check', {class:'h-5 w-5'}) }}</span><h3 class="text-sm font-bold text-slate-900">{{ 'vendor.invite.c3_t'|trans }}</h3><p class="text-xs leading-relaxed text-slate-500">{{ 'vendor.invite.c3_d'|trans }}</p></div>
                </div>
                <div class="pt-2 text-center">
                    <button type="button" data-vendor-open-form="1" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-6 py-3 text-xs font-bold text-white shadow-md transition-all hover:bg-emerald-700"><span>{{ 'vendor.invite.cta'|trans }}</span>{{ ux_icon('tabler:arrow-right', {class:'h-4 w-4'}) }}</button>
                </div>
            </div>
        </section>

        {# ---- Simulateur de revenus (calcul réel : voir initVendorForm) ---- #}
        <section id="simulateur-revenus" class="mx-auto max-w-4xl space-y-6 rounded-3xl border border-emerald-100 bg-mint p-6 sm:p-10">
            <div class="text-center">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-[11px] font-black text-emerald-700">{{ ux_icon('tabler:percentage', {class:'h-3.5 w-3.5'}) }} {{ 'vendor.sim.badge'|trans }}</span>
                <h2 class="mt-3 text-xl font-black text-slate-900 sm:text-2xl">{{ 'vendor.sim.title'|trans }}</h2>
                <p class="mt-1 text-xs text-slate-600 sm:text-sm">{{ 'vendor.sim.subtitle'|trans }}</p>
            </div>

            <div data-simulator data-pro-rent="{{ proRent }}" class="space-y-5 rounded-2xl border border-white bg-white/70 p-5">
                <div>
                    <label class="mb-2 block text-xs font-bold text-slate-700">{{ 'vendor.sim.activity'|trans }}</label>
                    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                        {% for c in commissionRates %}
                            <button type="button" data-sim-category data-standard="{{ c.standard }}" data-pro="{{ c.pro }}"
                                    class="rounded-xl border p-2.5 text-left text-xs transition-all {{ loop.first ? 'border-emerald-600 bg-emerald-50 font-bold text-emerald-950 shadow-xs' : 'border-slate-200 bg-slate-50/50 text-slate-600 hover:border-slate-300' }}">
                                <span class="block text-base">{{ c.icon }}</span><span class="block font-semibold">{{ ('vendor.cat.' ~ c.key)|trans }}</span><span class="block text-[10px] text-slate-400">{{ 'vendor.sim.rate'|trans({'%rate%': c.standard}) }}</span>
                            </button>
                        {% endfor %}
                    </div>
                </div>
                <div>
                    <div class="mb-1 flex items-center justify-between text-xs"><label class="font-bold text-slate-700">{{ 'vendor.sim.revenue'|trans }}</label><span data-sim-revenue-label class="font-mono text-sm font-black text-emerald-700">{{ 3000000|format_number }} Ar</span></div>
                    <input type="range" min="500000" max="20000000" step="250000" value="3000000" data-sim-revenue class="w-full accent-emerald-600">
                    <div class="mt-1 flex justify-between text-[10px] text-slate-400"><span>{{ 500000|format_number }} Ar</span><span>{{ 5000000|format_number }} Ar</span><span>{{ 10000000|format_number }} Ar</span><span>{{ 20000000|format_number }} Ar</span></div>
                </div>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div class="space-y-1.5 rounded-2xl border border-slate-200 bg-white p-4 text-xs">
                        <div class="flex items-center justify-between font-bold text-slate-900"><span>{{ 'vendor.sim.standard'|trans }}</span><span data-sim-standard-rate class="font-mono text-slate-500">{{ commissionRates[0].standard }}%</span></div>
                        <div class="flex justify-between text-slate-500"><span>{{ 'vendor.sim.commission'|trans }}</span><span data-sim-standard-commission class="font-mono text-red-500">-0 Ar</span></div>
                        <div class="flex justify-between border-t border-slate-100 pt-1.5 font-black text-slate-950"><span>{{ 'vendor.sim.net'|trans }}</span><span data-sim-standard-net class="font-mono">0 Ar</span></div>
                    </div>
                    <div class="relative space-y-1.5 rounded-2xl border-2 border-emerald-600 bg-white p-4 text-xs shadow-md">
                        <span class="absolute -top-2.5 right-3 rounded-full bg-emerald-600 px-2 py-0.5 text-[9px] font-black text-white">{{ 'vendor.sim.recommended'|trans }}</span>
                        <div class="flex items-center justify-between font-bold text-slate-900"><span>{{ 'vendor.sim.pro'|trans }}</span><span data-sim-pro-rate class="font-mono text-emerald-600">{{ commissionRates[0].pro }}%</span></div>
                        <div class="flex justify-between text-slate-500"><span>{{ 'vendor.sim.commission'|trans }}</span><span data-sim-pro-commission class="font-mono text-red-500">-0 Ar</span></div>
                        <div class="flex justify-between text-slate-500"><span>{{ 'vendor.sim.rent'|trans }}</span><span class="font-mono text-red-500">-{{ proRent|format_number }} Ar</span></div>
                        <div class="flex justify-between border-t border-slate-100 pt-1.5 font-black text-slate-950"><span>{{ 'vendor.sim.net'|trans }}</span><span data-sim-pro-net class="font-mono">0 Ar</span></div>
                        <div data-sim-pro-advantage class="hidden rounded-lg bg-emerald-50 px-2 py-1 text-center text-[10px] font-bold text-emerald-700"></div>
                    </div>
                </div>
            </div>
            <div class="flex flex-col items-center justify-between gap-3 pt-1 text-center sm:flex-row sm:text-left">
                <p class="text-[11px] text-slate-500">{{ 'vendor.sim.no_commit'|trans }}</p>
                <button type="button" data-vendor-open-form="1" class="shrink-0 rounded-full bg-black px-6 py-2.5 text-xs font-black text-white shadow-xs transition-colors hover:bg-neutral-800">{{ 'vendor.sim.cta'|trans }}</button>
            </div>
        </section>

        {# ---- Programme de solidarité ---- #}
        <section class="mx-auto max-w-5xl space-y-6 rounded-3xl border border-amber-200 bg-[#FFF8EC] p-6 sm:p-10">
            <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
                <div class="space-y-2">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-[11px] font-black text-amber-700">{{ ux_icon('tabler:heart-handshake', {class:'h-3.5 w-3.5'}) }} {{ 'vendor.solidarity.badge'|trans }}</span>
                    <h2 class="text-xl font-black text-slate-900 sm:text-2xl">{{ 'vendor.solidarity.title'|trans }}</h2>
                    <p class="max-w-xl text-xs text-slate-600 sm:text-sm">{{ 'vendor.solidarity.text'|trans }}</p>
                </div>
                <button type="button" data-vendor-open-form="4" data-vendor-solidarity="1" class="shrink-0 rounded-full bg-amber-500 px-5 py-2.5 text-xs font-black text-white shadow-xs transition-colors hover:bg-amber-600">{{ 'vendor.solidarity.cta'|trans }}</button>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {% for a in [
                    {n: 1, icon: 'tabler:building-store'},
                    {n: 2, icon: 'tabler:currency-dollar'},
                    {n: 3, icon: 'tabler:package'},
                    {n: 4, icon: 'tabler:user-check'},
                    {n: 5, icon: 'tabler:trending-up'},
                    {n: 6, icon: 'tabler:award'}
                ] %}
                    <div class="space-y-1.5 rounded-2xl border border-amber-100 bg-white p-4"><div class="flex items-center gap-2 font-bold text-slate-900">{{ ux_icon(a.icon, {class:'h-4 w-4 text-amber-600'}) }}<span class="text-xs">{{ ('vendor.solidarity.a' ~ a.n ~ '_t')|trans }}</span></div><p class="text-[11px] text-slate-500">{{ ('vendor.solidarity.a' ~ a.n ~ '_d')|trans }}</p></div>
                {% endfor %}
            </div>
        </section>

        <section class="mx-auto max-w-3xl space-y-6 px-4 py-4 sm:px-8">
            <div class="space-y-1 text-center"><h2 class="text-xl font-bold text-slate-900 sm:text-2xl">{{ 'vendor.faq.title'|trans }}</h2><p class="text-xs text-slate-500">{{ 'vendor.faq.subtitle'|trans }}</p></div>
            <div class="space-y-3">
                {% for n in 1..5 %}
                    <details class="group overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-xs"><summary class="flex cursor-pointer list-none items-center justify-between p-4 text-xs font-bold text-slate-800 marker:content-none group-open:text-emerald-700">{{ ('vendor.faq.q' ~ n)|trans }}{{ ux_icon('tabler:chevron-down', {class:'h-4 w-4 text-slate-400 transition-transform group-open:rotate-180'}) }}</summary><p class="border-t border-slate-100 px-4 pb-4 pt-3 text-xs leading-relaxed text-slate-500">{{ ('vendor.faq.a' ~ n)|trans }}</p></details>
                {% endfor %}
            </div>
        </section>

        <div class="mx-auto max-w-4xl px-4 sm:px-8">
            <div class="flex flex-col items-center justify-between gap-6 rounded-3xl bg-slate-900 p-6 text-white shadow-xl sm:flex-row sm:p-8">
                <div class="space-y-1 text-center sm:text-left"><h4 class="text-base font-bold">{{ 'vendor.final.title'|trans }}</h4><p class="text-xs text-slate-400">{{ 'vendor.final.text'|trans }}</p></div>
                <div class="flex flex-wrap items-center justify-center gap-3">
                    <button type="button" data-vendor-open-form="1" class="flex items-center gap-2 rounded-xl bg-emerald-500 px-6 py-3 text-xs font-bold text-white shadow-md transition-all hover:bg-emerald-600"><span>{{ 'vendor.final.start'|trans }}</span>{{ ux_icon('tabler:arrow-right', {class:'h-4 w-4'}) }}</button>
                    {% if whatsapp %}
                        <a href="https://wa.me/{{ whatsapp }}" target="_blank" rel="noreferrer" class="rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-xs font-bold text-white transition-colors hover:bg-white/15">{{ 'vendor.final.whatsapp'|trans }}</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# ---------- Assistant de candidature en 4 étapes ---------- #}
    <div data-vendor-view="form" class="hidden mx-auto max-w-2xl space-y-6 p-4 pb-20 sm:p-8">
        <button type="button" data-vendor-back class="flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-black">{{ ux_icon('tabler:arrow-left', {class:'h-4 w-4'}) }}{{ 'vendor.form.back'|trans }}</button>

        <div class="flex items-center justify-between text-[11px] font-bold text-slate-400">
            {% for n in 1..4 %}
                <div data-vendor-step-dot="{{ n }}" class="flex flex-1 flex-col items-center gap-1 {{ n == 1 ? 'text-slate-950' : '' }}">
                    <span class="flex h-6 w-6 items-center justify-center rounded-full {{ n == 1 ? 'bg-slate-950 text-white' : 'bg-slate-200 text-slate-500' }} font-mono text-[10px]">{{ n }}</span><span>{{ ('vendor.form.step' ~ n)|trans }}</span>
                </div>
            {% endfor %}
        </div>

        {# « novalidate » : la vérification des champs obligatoires se fait étape par étape en JavaScript (les champs d'une étape masquée ne bloquent pas l'envoi). #}
        <form data-vendor-form novalidate class="space-y-5 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <div data-vendor-error role="alert" class="hidden items-center gap-2 rounded-2xl border border-red-200 bg-red-50 p-3 text-xs text-red-700">{{ ux_icon('tabler:alert-circle', {class:'h-4 w-4 shrink-0'}) }}<span data-vendor-error-text></span></div>

            {# Étape 1 : identité, contact, compte (tous les champs obligatoires du serveur sont ici) #}
            <div data-vendor-step="1" class="space-y-3">
                <h3 class="text-sm font-black text-slate-900">{{ 'vendor.form.s1_title'|trans }}</h3>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <div><label class="mb-1 block font-semibold text-slate-700">{{ 'vendor.form.contact_name'|trans }}</label><input type="text" name="fullName" required autocomplete="name" placeholder="{{ 'vendor.form.contact_name_ph'|trans }}" class="{{ inputClass }}"><p data-field-error="fullName" class="mt-1 hidden text-[11px] text-red-600"></p></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">{{ 'vendor.form.role'|trans }}</label><input type="text" name="contactRole" maxlength="100" placeholder="{{ 'vendor.form.role_ph'|trans }}" class="{{ inputClass }}"></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">{{ 'vendor.form.email'|trans }}</label><input type="email" name="email" required autocomplete="email" placeholder="{{ 'vendor.form.email_ph'|trans }}" class="{{ inputClass }}"><p data-field-error="email" class="mt-1 hidden text-[11px] text-red-600"></p></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">{{ 'vendor.form.phone'|trans }}</label><input type="tel" name="phone" required autocomplete="tel" placeholder="{{ 'vendor.form.phone_ph'|trans }}" class="{{ inputClass }}"><p data-field-error="phone" class="mt-1 hidden text-[11px] text-red-600"></p></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">{{ 'vendor.form.company'|trans }}</label><input type="text" name="companyName" required autocomplete="organization" placeholder="{{ 'vendor.form.company_ph'|trans }}" class="{{ inputClass }}"><p data-field-error="companyName" class="mt-1 hidden text-[11px] text-red-600"></p></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">{{ 'vendor.form.city'|trans }}</label><input type="text" name="city" maxlength="100" autocomplete="address-level2" placeholder="{{ 'vendor.form.city_ph'|trans }}" class="{{ inputClass }}"></div>
                    <div class="col-span-2"><label class="mb-1 block font-semibold text-slate-700">{{ 'vendor.form.address'|trans }}</label><input type="text" name="companyAddress" required autocomplete="street-address" placeholder="{{ 'vendor.form.address_ph'|trans }}" class="{{ inputClass }}"><p data-field-error="companyAddress" class="mt-1 hidden text-[11px] text-red-600"></p></div>
                    <div class="col-span-2"><label class="mb-1 block font-semibold text-slate-700">{{ 'auth.password_required'|trans }}</label><input type="password" name="password" required autocomplete="new-password" placeholder="{{ 'auth.password_placeholder_new'|trans }}" class="{{ inputClass }}"><p data-field-error="password" class="mt-1 hidden text-[11px] text-red-600"></p></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">{{ 'vendor.form.activity_type'|trans }}</label>
                        <select name="activityType" class="{{ inputClass }}"><option value="individual">{{ 'vendor.form.activity.individual'|trans }}</option><option value="company" selected>{{ 'vendor.form.activity.company'|trans }}</option></select></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">{{ 'vendor.form.tax_id'|trans }}</label><input type="text" name="taxId" maxlength="50" placeholder="{{ 'vendor.form.tax_id_ph'|trans }}" class="{{ inputClass }}"></div>
                </div>
                <p class="text-[11px] text-slate-400">{{ 'vendor.form.phone_hint'|trans }}</p>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'vendor.form.category'|trans }}</label>
                    <select name="mainCategory" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs">{% for c in commissionRates %}<option value="{{ c.id }}">{{ ('vendor.cat.' ~ c.key)|trans }}</option>{% endfor %}</select></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'vendor.form.plan_label'|trans }}</label>
                    <div class="grid grid-cols-2 gap-2 text-xs"><label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 p-2.5"><input type="radio" name="plan" value="standard" checked><span>{{ 'vendor.form.plan.standard'|trans }}</span></label><label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 p-2.5"><input type="radio" name="plan" value="pro"><span>{{ 'vendor.form.plan.pro'|trans }}</span></label></div></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'vendor.form.description'|trans }}</label><textarea rows="2" name="companyDescription" maxlength="1000" placeholder="{{ 'vendor.form.description_ph'|trans }}" class="w-full resize-none rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></textarea><p data-field-error="companyDescription" class="mt-1 hidden text-[11px] text-red-600"></p></div>
            </div>

            {# Étape 2 : activité et produits #}
            <div data-vendor-step="2" class="hidden space-y-3">
                <h3 class="text-sm font-black text-slate-900">{{ 'vendor.form.s2_title'|trans }}</h3>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'vendor.form.sector'|trans }}</label><input type="text" name="sector" maxlength="100" placeholder="{{ 'vendor.form.sector_ph'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'vendor.form.product_types'|trans }}</label>
                    <div class="flex flex-wrap gap-2">{% for code in ['electronics', 'fashion', 'grocery', 'home', 'beauty', 'sport', 'toys'] %}<label class="flex cursor-pointer items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-[11px]"><input type="checkbox" name="productTypes" value="{{ code }}"><span>{{ ('vendor.form.product.' ~ code)|trans }}</span></label>{% endfor %}</div></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'vendor.form.sku'|trans }}</label>
                    <select name="skuRange" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"><option value="1-10">1–10</option><option value="11-50">11–50</option><option value="51-200">51–200</option><option value="200+">200+</option></select></div>
            </div>

            {# Étape 3 : logistique et outils #}
            <div data-vendor-step="3" class="hidden space-y-3">
                <h3 class="text-sm font-black text-slate-900">{{ 'vendor.form.s3_title'|trans }}</h3>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'vendor.form.prep_label'|trans }}</label>
                    <select name="prepTime" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs">{% for code in ['under_2h', 'same_day', '24_48h'] %}<option value="{{ code }}">{{ ('vendor.form.prep.' ~ code)|trans }}</option>{% endfor %}</select></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'vendor.form.sales_points'|trans }}</label>
                    <div class="flex flex-wrap gap-2">{% for code in ['shop', 'warehouse', 'online_only', 'market'] %}<label class="flex cursor-pointer items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-[11px]"><input type="checkbox" name="salesPoints" value="{{ code }}"><span>{{ ('vendor.form.sales.' ~ code)|trans }}</span></label>{% endfor %}</div></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'vendor.form.own_delivery'|trans }}</label>
                    <div class="flex gap-2 text-xs"><label class="flex items-center gap-1.5"><input type="radio" name="ownDelivery" value="yes" checked><span>{{ 'vendor.form.own_delivery_yes'|trans }}</span></label><label class="flex items-center gap-1.5"><input type="radio" name="ownDelivery" value="no"><span>{{ 'vendor.form.own_delivery_no'|trans }}</span></label></div></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'vendor.form.stock_tool'|trans }}</label><input type="text" name="stockTool" maxlength="100" placeholder="{{ 'vendor.form.stock_tool_ph'|trans }}" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></div>
            </div>

            {# Étape 4 : solidarité et attentes #}
            <div data-vendor-step="4" class="hidden space-y-3">
                <h3 class="text-sm font-black text-slate-900">{{ 'vendor.form.s4_title'|trans }}</h3>
                <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-amber-800">{{ 'vendor.form.s4_notice'|trans|raw }}</div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'vendor.form.damage'|trans }}</label>
                    <div class="flex gap-2 text-xs"><label class="flex items-center gap-1.5"><input type="radio" name="damage" value="yes" data-damage-yes><span>{{ 'vendor.form.answer_yes'|trans }}</span></label><label class="flex items-center gap-1.5"><input type="radio" name="damage" value="no" data-damage-no checked><span>{{ 'vendor.form.answer_no'|trans }}</span></label></div></div>
                <div data-damage-fields class="hidden space-y-2">
                    <label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'vendor.form.proofs'|trans }}</label>
                    <div class="flex flex-wrap gap-2">{% for code in ['photos', 'police_report', 'assessment'] %}<label class="flex cursor-pointer items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-[11px]"><input type="checkbox" name="proofs" value="{{ code }}"><span>{{ ('vendor.form.proof.' ~ code)|trans }}</span></label>{% endfor %}</div>
                </div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">{{ 'vendor.form.expectations'|trans }}</label><textarea rows="3" name="expectations" maxlength="1000" placeholder="{{ 'vendor.form.expectations_ph'|trans }}" class="w-full resize-none rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></textarea></div>
                <p class="text-[11px] leading-relaxed text-slate-400">{{ 'vendor.form.next_info'|trans }}</p>
            </div>

            <div class="flex items-center justify-between border-t border-slate-100 pt-4">
                <button type="button" data-vendor-prev class="hidden text-xs font-bold text-slate-500 hover:text-black">{{ 'vendor.form.prev'|trans }}</button>
                <div class="ml-auto flex gap-2">
                    <button type="button" data-vendor-next class="rounded-full bg-slate-950 px-5 py-2.5 text-xs font-bold text-white hover:bg-slate-800">{{ 'vendor.form.next'|trans }}</button>
                    <button type="submit" data-vendor-submit class="hidden rounded-full bg-emerald-600 px-5 py-2.5 text-xs font-bold text-white hover:bg-emerald-700 disabled:opacity-60">{{ 'vendor.form.submit'|trans }}</button>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}
