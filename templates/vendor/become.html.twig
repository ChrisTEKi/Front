{% extends 'base.html.twig' %}
{% block title %}Devenir Partenaire — GoBuy{% endblock %}

{% block body %}
{% set commissionRates = [
    {id: 'cat-alim', name: 'Alimentation & Épicerie', standard: 4, pro: 2, icon: '🌾'},
    {id: 'cat-elec', name: 'Appareils & High-Tech', standard: 5, pro: 3, icon: '📱'},
    {id: 'cat-enfants', name: 'Jouets & Enfants', standard: 6, pro: 4, icon: '🧸'},
    {id: 'cat-electromenager', name: 'Électroménager', standard: 6, pro: 4, icon: '⚡'},
    {id: 'cat-maison', name: 'Maison & Déco', standard: 7, pro: 5, icon: '🏠'},
    {id: 'cat-sport', name: 'Sport & Loisirs', standard: 7, pro: 5, icon: '⚽'},
    {id: 'cat-mode', name: 'Vêtements & Mode', standard: 8, pro: 6, icon: '👗'},
    {id: 'cat-beaute', name: 'Beauté & Cosmétique', standard: 8, pro: 6, icon: '✨'},
] %}

<div data-vendor-page class="w-full">

    {# ---------- Landing ---------- #}
    <div data-vendor-view="landing" class="space-y-16 p-4 pb-20 sm:p-8 lg:p-12">

        <section class="relative overflow-hidden bg-gradient-to-b from-emerald-950 via-slate-900 to-slate-950 px-4 py-16 text-center text-white sm:px-8 sm:py-24">
            <div class="relative z-10 mx-auto max-w-5xl space-y-6">
                <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/20 px-3 py-1 text-xs font-bold uppercase tracking-wider text-emerald-300">{{ ux_icon('tabler:sparkles', {class:'h-3.5 w-3.5 text-emerald-400'}) }}Programme Partenaire GoBuy Madagascar 2026</span>
                <h1 class="mx-auto max-w-4xl text-3xl font-black leading-tight tracking-tight sm:text-5xl lg:text-6xl">Vendez vos produits à plus de <span class="text-emerald-400">150 000 clients</span> à Madagascar</h1>
                <p class="mx-auto max-w-2xl text-sm leading-relaxed text-slate-300 sm:text-base">Propulsez votre chiffre d'affaires sans contrainte technique ni risque d'impayé. GoBuy gère le site vitrine, les encaissements sécurisés par Mobile Money et les livraisons à Antananarivo et en provinces.</p>
                <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
                    <button type="button" data-vendor-open-form="1" class="flex items-center gap-2 rounded-2xl bg-emerald-500 px-7 py-4 text-sm font-bold text-white shadow-xl shadow-emerald-500/30 transition-all hover:-translate-y-0.5 hover:bg-emerald-600">{{ ux_icon('tabler:sparkles', {class:'h-4 w-4'}) }}<span>Démarrer ma candidature</span>{{ ux_icon('tabler:arrow-right', {class:'h-4 w-4'}) }}</button>
                    <button type="button" data-vendor-open-form="1" class="rounded-2xl border border-white/20 bg-white/10 px-6 py-4 text-sm font-bold text-white backdrop-blur-xs transition-all hover:bg-white/15">Je dépose mon dossier (2 min)</button>
                    <a href="#simulateur-revenus" class="px-5 py-4 text-xs font-semibold text-slate-300 underline underline-offset-4 transition-colors hover:text-white">Calculer mes commissions &amp; gains</a>
                </div>
                <div class="mx-auto grid max-w-4xl grid-cols-2 gap-4 pt-12 md:grid-cols-4">
                    {% for m in [{v:'0 Ar', l:"Frais d'entrée ou création"}, {v:'48h max', l:'Reversement MVola / Banque'}, {v:'100%', l:'Paiements garantis sécurisés'}, {v:'24h / 48h', l:'Délai moyen de livraison'}] %}
                        <div class="space-y-1 rounded-2xl border border-white/10 bg-white/5 p-4 text-center backdrop-blur-xs"><div class="text-2xl font-black text-emerald-400">{{ m.v }}</div><div class="text-xs font-medium text-slate-300">{{ m.l }}</div></div>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="relative z-10 mx-auto -mt-8 max-w-5xl px-4 sm:px-8">
            <div class="space-y-6 rounded-3xl border border-slate-200/90 bg-white p-6 shadow-xl sm:p-8">
                <div class="mx-auto max-w-2xl space-y-2 text-center">
                    <span class="rounded-full bg-emerald-100 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-emerald-800">Invitation Officielle Vendeurs</span>
                    <h2 class="text-xl font-bold text-slate-900 sm:text-2xl">Rejoignez notre nouveau marketplace GoBuy</h2>
                    <p class="text-xs leading-relaxed text-slate-600 sm:text-sm">Cette plateforme e-commerce innovante vous permettra de vendre directement à nos clients tout en bénéficiant d'un espace de gestion dédié et de solutions personnalisées.</p>
                </div>
                <div class="grid grid-cols-1 gap-4 pt-2 md:grid-cols-3">
                    <div class="space-y-2 rounded-2xl border border-slate-200/80 bg-slate-50 p-4"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 font-bold text-emerald-800">{{ ux_icon('tabler:trending-up', {class:'h-5 w-5'}) }}</span><h3 class="text-sm font-bold text-slate-900">Un marché élargi</h3><p class="text-xs leading-relaxed text-slate-500">Accédez à une nouvelle clientèle et développez vos ventes sans frontières géographiques à Madagascar.</p></div>
                    <div class="space-y-2 rounded-2xl border border-slate-200/80 bg-slate-50 p-4"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-100 font-bold text-blue-800">{{ ux_icon('tabler:file-spreadsheet', {class:'h-5 w-5'}) }}</span><h3 class="text-sm font-bold text-slate-900">Des outils de gestion efficaces</h3><p class="text-xs leading-relaxed text-slate-500">Pilotez vos produits, commandes, prix et stocks depuis une interface intuitive pensée pour votre commerce.</p></div>
                    <div class="space-y-2 rounded-2xl border border-slate-200/80 bg-slate-50 p-4"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-purple-100 font-bold text-purple-800">{{ ux_icon('tabler:shield-check', {class:'h-5 w-5'}) }}</span><h3 class="text-sm font-bold text-slate-900">Un support dédié</h3><p class="text-xs leading-relaxed text-slate-500">Profitez d'une assistance continue et d'un conseiller dédié pour garantir une expérience optimale.</p></div>
                </div>
                <div class="pt-2 text-center">
                    <button type="button" data-vendor-open-form="1" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-6 py-3 text-xs font-bold text-white shadow-md transition-all hover:bg-emerald-700"><span>Je dépose mon dossier maintenant</span>{{ ux_icon('tabler:arrow-right', {class:'h-4 w-4'}) }}</button>
                </div>
            </div>
        </section>

        {# ---- Revenue simulator ---- #}
        <section id="simulateur-revenus" class="mx-auto max-w-4xl space-y-6 rounded-3xl border border-emerald-100 bg-mint p-6 sm:p-10">
            <div class="text-center">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-[11px] font-black text-emerald-700">{{ ux_icon('tabler:percentage', {class:'h-3.5 w-3.5'}) }} Simulateur transparent</span>
                <h2 class="mt-3 text-xl font-black text-slate-900 sm:text-2xl">Calculez vos revenus nets de vente</h2>
                <p class="mt-1 text-xs text-slate-600 sm:text-sm">Découvrez combien vous touchez réellement selon votre chiffre d'affaires mensuel.</p>
            </div>

            <div data-simulator data-pro-rent="49000" class="space-y-5 rounded-2xl border border-white bg-white/70 p-5">
                <div>
                    <label class="mb-2 block text-xs font-bold text-slate-700">Votre rayon d'activité :</label>
                    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                        {% for c in commissionRates %}
                            <button type="button" data-sim-category data-standard="{{ c.standard }}" data-pro="{{ c.pro }}" data-name="{{ c.name }}"
                                    class="rounded-xl border p-2.5 text-left text-xs transition-all {{ loop.first ? 'border-emerald-600 bg-emerald-50 font-bold text-emerald-950 shadow-xs' : 'border-slate-200 bg-slate-50/50 text-slate-600 hover:border-slate-300' }}">
                                <span class="block text-base">{{ c.icon }}</span><span class="block font-semibold">{{ c.name }}</span><span class="block text-[10px] text-slate-400">{{ c.standard }}% com.</span>
                            </button>
                        {% endfor %}
                    </div>
                </div>
                <div>
                    <div class="mb-1 flex items-center justify-between text-xs"><label class="font-bold text-slate-700">Chiffre d'affaires mensuel estimé :</label><span data-sim-revenue-label class="font-mono text-sm font-black text-emerald-700">3 000 000 Ar</span></div>
                    <input type="range" min="500000" max="20000000" step="250000" value="3000000" data-sim-revenue class="w-full accent-emerald-600">
                    <div class="mt-1 flex justify-between text-[10px] text-slate-400"><span>500 000 Ar</span><span>5 000 000 Ar</span><span>10 000 000 Ar</span><span>20 000 000 Ar</span></div>
                </div>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div class="space-y-1.5 rounded-2xl border border-slate-200 bg-white p-4 text-xs">
                        <div class="flex items-center justify-between font-bold text-slate-900"><span>Formule Standard (0 Ar)</span><span data-sim-standard-rate class="font-mono text-slate-500">4%</span></div>
                        <div class="flex justify-between text-slate-500"><span>Commission GoBuy :</span><span data-sim-standard-commission class="font-mono text-red-500">-0 Ar</span></div>
                        <div class="flex justify-between border-t border-slate-100 pt-1.5 font-black text-slate-950"><span>Net versé :</span><span data-sim-standard-net class="font-mono">0 Ar</span></div>
                    </div>
                    <div class="relative space-y-1.5 rounded-2xl border-2 border-emerald-600 bg-white p-4 text-xs shadow-md">
                        <span class="absolute -top-2.5 right-3 rounded-full bg-emerald-600 px-2 py-0.5 text-[9px] font-black text-white">Recommandé</span>
                        <div class="flex items-center justify-between font-bold text-slate-900"><span>Boutique Pro Certifiée</span><span data-sim-pro-rate class="font-mono text-emerald-600">2%</span></div>
                        <div class="flex justify-between text-slate-500"><span>Commission GoBuy :</span><span data-sim-pro-commission class="font-mono text-red-500">-0 Ar</span></div>
                        <div class="flex justify-between text-slate-500"><span>Loyer mensuel Pro :</span><span class="font-mono text-red-500">-49 000 Ar</span></div>
                        <div class="flex justify-between border-t border-slate-100 pt-1.5 font-black text-slate-950"><span>Net versé :</span><span data-sim-pro-net class="font-mono">0 Ar</span></div>
                        <div data-sim-pro-advantage class="hidden rounded-lg bg-emerald-50 px-2 py-1 text-center text-[10px] font-bold text-emerald-700"></div>
                    </div>
                </div>
            </div>
            <div class="flex flex-col items-center justify-between gap-3 pt-1 text-center sm:flex-row sm:text-left">
                <p class="text-[11px] text-slate-500">Aucun engagement de durée. Basculez d'une formule à l'autre à tout moment.</p>
                <button type="button" data-vendor-open-form="1" class="shrink-0 rounded-full bg-black px-6 py-2.5 text-xs font-black text-white shadow-xs transition-colors hover:bg-neutral-800">Démarrer ma candidature</button>
            </div>
        </section>

        {# ---- Solidarity program ---- #}
        <section class="mx-auto max-w-5xl space-y-6 rounded-3xl border border-amber-200 bg-[#FFF8EC] p-6 sm:p-10">
            <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
                <div class="space-y-2">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-[11px] font-black text-amber-700">{{ ux_icon('tabler:heart-handshake', {class:'h-3.5 w-3.5'}) }} Programme spécial relance &amp; solidarité</span>
                    <h2 class="text-xl font-black text-slate-900 sm:text-2xl">Reconstruisons Ensemble 🤝</h2>
                    <p class="max-w-xl text-xs text-slate-600 sm:text-sm">À vos côtés pour renaître et redonner vie à votre commerce après les pertes subies ou les dommages matériels.</p>
                </div>
                <button type="button" data-vendor-open-form="4" data-vendor-solidarity="1" class="shrink-0 rounded-full bg-amber-500 px-5 py-2.5 text-xs font-black text-white shadow-xs transition-colors hover:bg-amber-600">Déposer un dossier de soutien 🤝</button>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {% for a in [
                    {icon: 'tabler:building-store', t: 'Boutique en ligne complète', d: 'Mise en ligne immédiate de votre vitrine avec gestion des fiches produits.'},
                    {icon: 'tabler:currency-dollar', t: '100 000 Ar de publicité offerte', d: 'Campagnes sponsorisées sur les réseaux sociaux financées par GoBuy.'},
                    {icon: 'tabler:package', t: '1 m³ de stockage gratuit', d: 'Entreposage sécurisé de vos marchandises dans nos hubs logistiques.'},
                    {icon: 'tabler:user-check', t: 'Accompagnement commercial', d: 'Conseillers attitrés pour le service client et le suivi des commandes.'},
                    {icon: 'tabler:trending-up', t: 'Visibilité sur les réseaux', d: 'Publications ciblées, bannières et pushs auprès de notre communauté active.'},
                    {icon: 'tabler:award', t: 'Formation à votre back-office', d: 'Session de prise en main guidée pour vous et vos collaborateurs.'}
                ] %}
                    <div class="space-y-1.5 rounded-2xl border border-amber-100 bg-white p-4"><div class="flex items-center gap-2 font-bold text-slate-900">{{ ux_icon(a.icon, {class:'h-4 w-4 text-amber-600'}) }}<span class="text-xs">{{ a.t }}</span></div><p class="text-[11px] text-slate-500">{{ a.d }}</p></div>
                {% endfor %}
            </div>
        </section>

        <section class="mx-auto max-w-3xl space-y-6 px-4 py-4 sm:px-8">
            <div class="space-y-1 text-center"><h2 class="text-xl font-bold text-slate-900 sm:text-2xl">Questions fréquemment posées par les vendeurs</h2><p class="text-xs text-slate-500">Tout ce que vous devez savoir avant de commencer sur GoBuy</p></div>
            <div class="space-y-3">
                {% for qa in [
                    {q: 'Quels sont les frais pour ouvrir ma boutique sur GoBuy ?', a: "Avec la Formule Standard, l'inscription est 100% gratuite et sans aucun loyer mensuel (0 Ar/mois). Vous ne payez une commission que lorsqu'une vente est effectivement conclue et livrée. Pour les marques établies souhaitant une visibilité maximale et une commission réduite de -2%, la Formule Pro est disponible à 49 000 Ar/mois sans engagement de durée."},
                    {q: 'Comment et quand suis-je payé pour mes ventes ?', a: "Vos reversements sont effectués de façon bi-hebdomadaire (tous les mardis et vendredis). L'argent est transféré directement sur votre compte MVola, Orange Money, Airtel Money ou par virement bancaire (BNI, BMOI, Société Générale Madagascar, etc.), déduction faite de la commission convenue."},
                    {q: 'Qui prend en charge la livraison aux clients ?', a: "GoBuy propose une solution logistique intégrée clé en main ! Dès qu'une commande est passée, vous recevez une notification pour préparer le colis. Un coursier GoBuy partenaire passe ensuite le récupérer à votre boutique ou domicile pour le livrer en 24h à Antananarivo ou en provinces. Si vous disposez déjà de votre propre flotte de livraison, vous pouvez également choisir de l'opérer directement."},
                    {q: 'Faut-il obligatoirement une société immatriculée (NIF/STAT) ?', a: "Non ! Les particuliers, créateurs, agriculteurs et artisans indépendants peuvent vendre sous la formule Standard avec une simple pièce d'identité (CIN valide). Pour les entreprises et distributeurs officiels, la soumission du NIF et STAT permet d'obtenir le badge officiel « Entreprise Vérifiée »."},
                    {q: 'En quoi consiste le programme « Reconstruisons Ensemble 🤝 » ?', a: "Ce programme spécial de relance solidaire a été conçu pour soutenir les commerces et entreprises ayant subi des pillages, des dégradations ou des sinistres matériels. GoBuy leur offre une boutique complète, 100 000 MGA de publicité offerte, 1 m³ de stockage gratuit, un accompagnement commercial, des campagnes réseaux sociaux et une formation personnalisée au back-office."}
                ] %}
                    <details class="group overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-xs"><summary class="flex cursor-pointer list-none items-center justify-between p-4 text-xs font-bold text-slate-800 marker:content-none group-open:text-emerald-700">{{ qa.q }}{{ ux_icon('tabler:chevron-down', {class:'h-4 w-4 text-slate-400 transition-transform group-open:rotate-180'}) }}</summary><p class="border-t border-slate-100 px-4 pb-4 pt-3 text-xs leading-relaxed text-slate-500">{{ qa.a }}</p></details>
                {% endfor %}
            </div>
        </section>

        <div class="mx-auto max-w-4xl px-4 sm:px-8">
            <div class="flex flex-col items-center justify-between gap-6 rounded-3xl bg-slate-900 p-6 text-white shadow-xl sm:flex-row sm:p-8">
                <div class="space-y-1 text-center sm:text-left"><h4 class="text-base font-bold">Prêt à vendre sur GoBuy Madagascar ?</h4><p class="text-xs text-slate-400">Déposez votre dossier en 2 minutes. Notre équipe vous accompagne à chaque étape.</p></div>
                <div class="flex flex-wrap items-center justify-center gap-3">
                    <button type="button" data-vendor-open-form="1" class="flex items-center gap-2 rounded-xl bg-emerald-500 px-6 py-3 text-xs font-bold text-white shadow-md transition-all hover:bg-emerald-600"><span>Démarrer</span>{{ ux_icon('tabler:arrow-right', {class:'h-4 w-4'}) }}</button>
                    <a href="https://wa.me/261340000000" target="_blank" rel="noreferrer" class="rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-xs font-bold text-white transition-colors hover:bg-white/15">WhatsApp Support</a>
                </div>
            </div>
        </div>
    </div>

    {# ---------- 4-step application form ---------- #}
    <div data-vendor-view="form" class="hidden mx-auto max-w-2xl space-y-6 p-4 pb-20 sm:p-8">
        <button type="button" data-vendor-back class="flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-black">{{ ux_icon('tabler:arrow-left', {class:'h-4 w-4'}) }}Retour à la présentation</button>

        <div class="flex items-center justify-between text-[11px] font-bold text-slate-400">
            {% for s in [{n:1,l:'Identité'}, {n:2,l:'Activité'}, {n:3,l:'Logistique'}, {n:4,l:'Solidarité'}] %}
                <div data-vendor-step-dot="{{ s.n }}" class="flex flex-1 flex-col items-center gap-1 {{ s.n == 1 ? 'text-slate-950' : '' }}">
                    <span class="flex h-6 w-6 items-center justify-center rounded-full {{ s.n == 1 ? 'bg-slate-950 text-white' : 'bg-slate-200 text-slate-500' }} font-mono text-[10px]">{{ s.n }}</span><span>{{ s.l }}</span>
                </div>
            {% endfor %}
        </div>

        <form data-vendor-form class="space-y-5 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            {# Step 1 #}
            <div data-vendor-step="1" class="space-y-3">
                <h3 class="text-sm font-black text-slate-900">Identification &amp; Contact</h3>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <div><label class="mb-1 block font-semibold text-slate-700">Nom du contact *</label><input type="text" required placeholder="RAKOTOMALALA Jean" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2"></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">Fonction / Rôle</label><input type="text" placeholder="Gérant, Responsable..." class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2"></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">E-mail professionnel *</label><input type="email" required placeholder="contact@entreprise.mg" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2"></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">Téléphone mobile *</label><input type="tel" required placeholder="034 12 345 67" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2"></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">Nom de l'entreprise / Boutique</label><input type="text" placeholder="StylePro Madagascar" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2"></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">Ville</label><input type="text" value="Antananarivo" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2"></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">Type d'activité</label>
                        <select class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2"><option>Particulier</option><option selected>Entreprise</option></select></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">NIF / STAT (si entreprise)</label><input type="text" placeholder="Numéro fiscal" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2"></div>
                </div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Rayon principal</label>
                    <select class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs">{% for c in commissionRates %}<option>{{ c.name }}</option>{% endfor %}</select></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Formule souhaitée</label>
                    <div class="grid grid-cols-2 gap-2 text-xs"><label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 p-2.5"><input type="radio" name="plan" checked><span>Standard (0 Ar)</span></label><label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 p-2.5"><input type="radio" name="plan"><span>Pro (49 000 Ar/mois)</span></label></div></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Présentation de votre activité</label><textarea rows="2" placeholder="Décrivez vos produits, marques, garanties..." class="w-full resize-none rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></textarea></div>
            </div>

            {# Step 2 #}
            <div data-vendor-step="2" class="hidden space-y-3">
                <h3 class="text-sm font-black text-slate-900">Activité &amp; Produits</h3>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Secteur d'activité</label><input type="text" value="Technologie de l'information" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Types de produits proposés</label>
                    <div class="flex flex-wrap gap-2">{% for t in ['Électronique','Mode','Épicerie','Maison','Beauté','Sport','Jouets'] %}<label class="flex cursor-pointer items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-[11px]"><input type="checkbox"><span>{{ t }}</span></label>{% endfor %}</div></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Nombre de références (SKU) estimé</label>
                    <select class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"><option>1–10</option><option>11–50</option><option>51–200</option><option>200+</option></select></div>
            </div>

            {# Step 3 #}
            <div data-vendor-step="3" class="hidden space-y-3">
                <h3 class="text-sm font-black text-slate-900">Logistique &amp; Outils</h3>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Délai de préparation moyen</label>
                    <select class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"><option>Moins de 2h ouvrées</option><option>Le jour même</option><option>24h à 48h</option></select></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Point(s) de vente</label>
                    <div class="flex flex-wrap gap-2">{% for t in ['Boutique physique','Entrepôt','Vente en ligne uniquement','Marché / Étal'] %}<label class="flex cursor-pointer items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-[11px]"><input type="checkbox"><span>{{ t }}</span></label>{% endfor %}</div></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Disposez-vous de votre propre livraison ?</label>
                    <div class="flex gap-2 text-xs"><label class="flex items-center gap-1.5"><input type="radio" name="hasOwnDelivery" checked><span>Oui</span></label><label class="flex items-center gap-1.5"><input type="radio" name="hasOwnDelivery"><span>Non, j'utiliserai les coursiers GoBuy</span></label></div></div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Outil de gestion des stocks utilisé</label><input type="text" placeholder="Ex: Sage, Excel, cahier papier..." class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></div>
            </div>

            {# Step 4 #}
            <div data-vendor-step="4" class="hidden space-y-3">
                <h3 class="text-sm font-black text-slate-900">Solidarité &amp; Attentes</h3>
                <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-amber-800">Cette section permet d'orienter les commerçants sinistrés vers le programme <strong>Reconstruisons Ensemble 🤝</strong>.</div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Avez-vous subi un pillage ou des dommages matériels ?</label>
                    <div class="flex gap-2 text-xs"><label class="flex items-center gap-1.5"><input type="radio" name="damage" data-damage-yes><span>Oui</span></label><label class="flex items-center gap-1.5"><input type="radio" name="damage" data-damage-no checked><span>Non</span></label></div></div>
                <div data-damage-fields class="hidden space-y-2">
                    <label class="mb-1 block text-xs font-semibold text-slate-700">Justificatifs disponibles</label>
                    <div class="flex flex-wrap gap-2">{% for t in ['Photos des dommages','Dépôt de plainte','Constat / rapport'] %}<label class="flex cursor-pointer items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-[11px]"><input type="checkbox"><span>{{ t }}</span></label>{% endfor %}</div>
                </div>
                <div><label class="mb-1 block text-xs font-semibold text-slate-700">Vos attentes vis-à-vis de GoBuy</label><textarea rows="3" placeholder="Qu'attendez-vous de votre partenariat avec GoBuy ?" class="w-full resize-none rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs"></textarea></div>
            </div>

            <div class="flex items-center justify-between border-t border-slate-100 pt-4">
                <button type="button" data-vendor-prev class="hidden text-xs font-bold text-slate-500 hover:text-black">← Précédent</button>
                <div class="ml-auto flex gap-2">
                    <button type="button" data-vendor-next class="rounded-full bg-slate-950 px-5 py-2.5 text-xs font-bold text-white hover:bg-slate-800">Suivant →</button>
                    <button type="submit" data-vendor-submit class="hidden rounded-full bg-emerald-600 px-5 py-2.5 text-xs font-bold text-white hover:bg-emerald-700">Envoyer mon dossier</button>
                </div>
            </div>
        </form>
    </div>

    {# ---------- Success ---------- #}
    <div data-vendor-view="success" class="hidden mx-auto max-w-md space-y-4 p-10 text-center">
        <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">{{ ux_icon('tabler:circle-check', {class:'h-8 w-8'}) }}</span>
        <h2 class="text-lg font-black text-slate-900">Dossier envoyé avec succès !</h2>
        <p class="text-xs text-slate-500">Notre équipe examine votre candidature et revient vers vous sous 48h ouvrées à l'adresse e-mail indiquée.</p>
        <a href="{{ path('app_home') }}" class="inline-block rounded-2xl bg-black px-5 py-2.5 text-xs font-bold text-white hover:bg-neutral-800">Retour à l'accueil</a>
    </div>
</div>
{% endblock %}
