{% extends 'base.html.twig' %}
{% block title %}Mon compte — GoBuy{% endblock %}

{% block body %}
{% if user is null %}
    {# Not logged in #}
    <div class="mx-auto max-w-md space-y-4 p-8 text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">{{ ux_icon('tabler:shield-check', { class: 'h-8 w-8' }) }}</div>
        <div>
            <h2 class="text-base font-bold text-slate-900">Bienvenue sur GoBuy</h2>
            <p class="mt-1 text-xs text-slate-500">Connectez-vous pour accéder à votre espace client, suivre vos commandes ou gérer votre boutique vendeur.</p>
        </div>
        <div class="space-y-2 pt-2">
            <a href="{{ path('app_auth') }}" class="block w-full rounded-2xl bg-emerald-600 py-3 text-xs font-semibold text-white shadow-md transition-all hover:bg-emerald-700">Se connecter</a>
            <a href="{{ path('app_auth', {mode: 'register'}) }}" class="block w-full rounded-2xl border border-slate-200 bg-white py-3 text-xs font-semibold text-slate-700 transition-all hover:bg-slate-50">S'inscrire</a>
        </div>
    </div>
{% else %}
<div data-account data-account-initial="{{ section }}" class="mx-auto max-w-2xl space-y-6 p-4 sm:p-6">

    <div class="flex items-center justify-between rounded-3xl border border-slate-200/80 bg-white p-6 shadow-xs">
        <div class="flex items-center gap-4">
            <div class="relative">
                <span class="flex h-16 w-16 items-center justify-center rounded-full bg-black text-2xl font-black text-gobuy-green ring-4 ring-emerald-500/20">{{ user.fullName|first|upper }}</span>
                {% if user.isEmailVerified %}<span class="absolute bottom-0 right-0 rounded-full bg-emerald-600 p-1 text-white ring-2 ring-white">{{ ux_icon('tabler:circle-check', { class: 'h-3 w-3' }) }}</span>{% endif %}
            </div>
            <div>
                <h2 class="text-base font-bold text-slate-900">{{ user.fullName }}</h2>
                <p class="text-xs text-slate-500">{{ user.email }}</p>
                <div class="mt-1 flex items-center gap-2">
                    <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold uppercase text-emerald-800">Client</span>
                    {% if user.twoFactorEnabled %}<span class="flex items-center gap-0.5 rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-semibold text-indigo-800">{{ ux_icon('tabler:shield-check', { class: 'h-2.5 w-2.5' }) }} 2FA</span>{% endif %}
                </div>
            </div>
        </div>
        <button type="button" data-account-go="info" class="rounded-xl bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-600 transition-colors hover:bg-emerald-100 hover:text-emerald-700">Modifier</button>
    </div>

    {# ---- MAIN ---- #}
    <div data-account-section="main" class="space-y-4">
        <div class="divide-y divide-slate-100 overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xs">
            <button type="button" data-account-go="favorites" class="group flex w-full items-center justify-between p-4 text-left transition-colors hover:bg-slate-50">
                <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-red-50 text-red-500 transition-transform group-hover:scale-105">{{ ux_icon('tabler:heart-filled', { class: 'h-5 w-5' }) }}</span>
                    <div><p class="text-xs font-bold text-slate-900">Mes Favoris</p><p class="text-[11px] text-slate-400">{{ favorites|length == 0 ? 'Aucun coup de cœur enregistré' : favorites|length ~ ' produit(s) sauvegardé(s)' }}</p></div>
                </div>
                {{ ux_icon('tabler:chevron-right', { class: 'h-4 w-4 text-slate-400 group-hover:text-slate-900' }) }}
            </button>
            <button type="button" data-account-go="orders" class="flex w-full items-center justify-between p-4 text-left transition-colors hover:bg-slate-50">
                <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-100 text-slate-700">{{ ux_icon('tabler:package', { class: 'h-5 w-5' }) }}</span>
                    <div><p class="text-xs font-bold text-slate-900">Mes commandes</p><p class="text-[11px] text-slate-400">{{ orders|length }} commande(s) passée(s)</p></div></div>
                {{ ux_icon('tabler:chevron-right', { class: 'h-4 w-4 text-slate-400' }) }}
            </button>
            <button type="button" data-account-go="addresses" class="flex w-full items-center justify-between p-4 text-left transition-colors hover:bg-slate-50">
                <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">{{ ux_icon('tabler:map-pin', { class: 'h-5 w-5' }) }}</span>
                    <div><p class="text-xs font-bold text-slate-900">Mes adresses</p><p class="text-[11px] text-slate-400">{{ user.addresses|length }} adresse(s) enregistrée(s)</p></div></div>
                {{ ux_icon('tabler:chevron-right', { class: 'h-4 w-4 text-slate-400' }) }}
            </button>
            <button type="button" data-account-go="info" class="flex w-full items-center justify-between p-4 text-left transition-colors hover:bg-slate-50">
                <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-amber-50 text-amber-600">{{ ux_icon('tabler:user', { class: 'h-5 w-5' }) }}</span>
                    <div><p class="text-xs font-bold text-slate-900">Mes informations</p><p class="text-[11px] text-slate-400">Coordonnées, téléphone, email</p></div></div>
                {{ ux_icon('tabler:chevron-right', { class: 'h-4 w-4 text-slate-400' }) }}
            </button>
            <button type="button" data-account-go="security" class="flex w-full items-center justify-between p-4 text-left transition-colors hover:bg-slate-50">
                <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">{{ ux_icon('tabler:lock', { class: 'h-5 w-5' }) }}</span>
                    <div><p class="text-xs font-bold text-slate-900">Sécurité &amp; 2FA</p><p class="text-[11px] text-slate-400">{{ user.twoFactorEnabled ? '2FA activée' : 'Renforcer la sécurité' }}</p></div></div>
                {{ ux_icon('tabler:chevron-right', { class: 'h-4 w-4 text-slate-400' }) }}
            </button>
            <div class="flex items-center justify-between p-4 text-left">
                <div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-100 text-slate-600">{{ ux_icon('tabler:help-circle', { class: 'h-5 w-5' }) }}</span>
                    <div><p class="text-xs font-bold text-slate-900">Aide et support</p><p class="text-[11px] text-slate-400">FAQ, contact support 24/7</p></div></div>
                <button type="button" data-open-modal="company-info" data-info-section="faq" class="text-[11px] font-semibold text-emerald-600 hover:underline">Ouvrir l'aide</button>
            </div>
        </div>
        <div class="space-y-2 pt-2">
            <a href="#" class="flex w-full items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white p-3.5 text-xs font-semibold text-red-600 shadow-2xs transition-colors hover:border-red-200 hover:bg-red-50">{{ ux_icon('tabler:logout', { class: 'h-4 w-4' }) }}<span>Se déconnecter</span></a>
            <button type="button" data-open-modal="delete-account" class="flex w-full items-center justify-center gap-1.5 p-3 text-[11px] font-medium text-slate-400 transition-colors hover:text-red-500">{{ ux_icon('tabler:trash', { class: 'h-3.5 w-3.5' }) }}<span>Supprimer définitivement mon compte</span></button>
        </div>
    </div>

    {# ---- FAVORITES ---- #}
    <div data-account-section="favorites" class="hidden space-y-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2"><h3 class="text-base font-black tracking-tight text-slate-900">Mes Favoris</h3><span class="rounded-full bg-slate-950 px-2 py-0.5 font-mono text-[10px] font-bold text-[#00E5A3]">{{ favorites|length }}</span></div>
            <div class="flex items-center gap-2">
                {% if favorites is not empty %}<button type="button" data-clear-favorites class="text-xs text-slate-400 transition-colors hover:text-red-600">Tout vider</button>{% endif %}
                <button type="button" data-account-go="main" class="rounded-xl bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-900 transition-colors hover:bg-slate-200 hover:underline">Retour au profil</button>
            </div>
        </div>
        {% if favorites is empty %}
            <div class="space-y-4 rounded-3xl border border-slate-200 bg-white p-10 text-center">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-red-50 text-red-400">{{ ux_icon('tabler:heart', { class: 'h-7 w-7' }) }}</span>
                <div><h4 class="text-sm font-black text-slate-900">Votre liste d'envies est bien vide...</h4>
                    <p class="mx-auto mt-1 max-w-sm text-xs text-slate-500">Un smartphone reconditionné certifié, un PC portable ou une paire d'écouteurs ? Cliquez sur l'icône cœur sur n'importe quel produit pour le garder sous la main.</p></div>
                <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2 rounded-full bg-black px-5 py-2.5 text-xs font-bold text-white hover:bg-neutral-800"><span>Explorer les pépites reconditionnées</span>{{ ux_icon('tabler:arrow-right', { class: 'h-3.5 w-3.5 text-gobuy-green' }) }}</a>
            </div>
        {% else %}
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">{% for product in favorites %}{{ include('product/_card.html.twig', {product: product}) }}{% endfor %}</div>
        {% endif %}
    </div>

    {# ---- ORDERS ---- #}
    <div data-account-section="orders" class="hidden space-y-4">
        <div class="flex items-center justify-between"><h3 class="text-sm font-bold text-slate-900">Mes commandes</h3><button type="button" data-account-go="main" class="text-xs text-emerald-600 hover:underline">Retour</button></div>
        {% if orders is empty %}
            <div class="rounded-3xl border border-slate-200 bg-white p-12 text-center text-slate-400">
                {{ ux_icon('tabler:package', { class: 'mx-auto mb-2 h-12 w-12 text-slate-300' }) }}
                <p class="text-xs font-semibold text-slate-700">Aucune commande pour le moment</p>
                <p class="mt-1 text-[11px]">Vos commandes apparaîtront ici avec leur suivi étape par étape.</p>
            </div>
        {% else %}
            <div class="space-y-3">
                {% for order in orders %}
                    <a href="{{ path('app_order_tracking', {number: order.orderNumber}) }}" class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white p-4 text-xs transition-all hover:shadow-md">
                        <img src="{{ order.items[0].product.images[0] }}" alt="preview" class="h-12 w-12 rounded-xl border border-slate-100 object-cover">
                        <div class="flex-1"><div class="flex items-center gap-2"><span class="font-bold text-slate-900">#{{ order.orderNumber }}</span>
                                <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-bold uppercase text-emerald-700">{{ order.status == 'delivered' ? 'Livrée' : order.status == 'preparing' ? 'En préparation' : order.status == 'shipped' ? 'Expédiée' : 'En attente' }}</span></div>
                            <p class="mt-0.5 text-[11px] text-slate-500">{{ order.items|length }} article(s) • {{ order.total|number_format(0, ',', ' ') }} Ar</p></div>
                        {{ ux_icon('tabler:chevron-right', { class: 'h-4 w-4 text-slate-400' }) }}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {# ---- INFO ---- #}
    <div data-account-section="info" class="hidden space-y-4">
        <div class="flex items-center justify-between"><h3 class="text-sm font-bold text-slate-900">Mes informations</h3><button type="button" data-account-go="main" class="text-xs text-emerald-600 hover:underline">Retour</button></div>
        <div class="divide-y divide-slate-100 rounded-3xl border border-slate-200 bg-white p-2 text-xs">
            <div class="flex items-center justify-between p-3"><span class="text-slate-500">Nom complet</span><span class="font-bold text-slate-900">{{ user.fullName }}</span></div>
            <div class="flex items-center justify-between p-3"><span class="text-slate-500">Adresse E-mail</span><span class="flex items-center gap-2"><span class="font-bold text-slate-900">{{ user.email }}</span><span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-700">✓ Vérifié</span></span></div>
            <div class="flex items-center justify-between p-3"><span class="text-slate-500">Téléphone mobile</span><span class="flex items-center gap-2"><span class="font-bold text-slate-900">{{ user.phone|default('Non renseigné') }}</span>{% if user.isPhoneVerified %}<span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-700">✓ Vérifié par SMS</span>{% else %}<span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold text-amber-700">Non vérifié</span>{% endif %}</span></div>
        </div>
    </div>

    {# ---- ADDRESSES ---- #}
    <div data-account-section="addresses" class="hidden space-y-4">
        <div class="flex items-center justify-between"><h3 class="text-sm font-bold text-slate-900">Mes adresses</h3><button type="button" data-account-go="main" class="text-xs text-emerald-600 hover:underline">Retour</button></div>
        {% if user.addresses is empty %}
            <div class="rounded-3xl border border-slate-200 bg-white p-10 text-center text-xs text-slate-400">Aucune adresse enregistrée.</div>
        {% else %}
            {% for addr in user.addresses %}
                <div class="space-y-1 rounded-2xl border border-slate-200 bg-white p-4 text-xs"><p class="font-bold text-slate-900">{{ addr.fullName }}</p><p class="text-slate-600">{{ addr.street }}, {{ addr.city }}</p><p class="text-slate-400">Tél: {{ addr.phone }}</p></div>
            {% endfor %}
        {% endif %}
    </div>

    {# ---- SECURITY ---- #}
    <div data-account-section="security" class="hidden space-y-4">
        <div class="flex items-center justify-between"><h3 class="text-sm font-bold text-slate-900">Sécurité du compte &amp; 2FA</h3><button type="button" data-account-go="main" class="text-xs text-emerald-600 hover:underline">Retour</button></div>
        <div class="flex items-center justify-between gap-4 rounded-3xl border border-slate-200 bg-white p-4">
            <div><p class="text-xs font-bold text-slate-900">Authentification à deux facteurs (2FA)</p>
                <p class="mt-0.5 text-[11px] text-slate-500">Exige un code de sécurité (OTP par E-mail ou SMS) lors de chaque tentative de connexion.</p></div>
            <button type="button" data-toggle-2fa class="shrink-0 rounded-full bg-slate-200 px-3 py-1.5 text-xs font-bold text-slate-700 transition-colors hover:bg-slate-300">DÉSACTIVÉ</button>
        </div>
        <button type="button" class="w-full rounded-2xl border border-slate-200 bg-white p-3.5 text-left text-xs font-semibold text-slate-700 hover:bg-slate-50">Changer le mot de passe</button>
    </div>
</div>

{# Delete account confirmation #}
<div data-modal="delete-account" class="pointer-events-none fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/70 p-4 backdrop-blur-xs">
    <div class="pointer-events-auto w-full max-w-sm space-y-4 rounded-3xl border border-slate-200 bg-white p-6 text-center shadow-2xl">
        <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-red-50 text-red-500">{{ ux_icon('tabler:trash', { class: 'h-6 w-6' }) }}</span>
        <div><h3 class="text-sm font-bold text-slate-900">Supprimer définitivement mon compte ?</h3>
            <p class="mt-1 text-xs text-slate-500">Cette action est irréversible. Toutes vos commandes, adresses et préférences seront définitivement effacées de la base de données.</p></div>
        <div class="space-y-1 text-left"><label class="block text-[11px] font-semibold text-slate-700">Tapez "SUPPRIMER" pour valider :</label>
            <input type="text" data-delete-confirm placeholder="SUPPRIMER" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 font-mono text-xs focus:border-red-400 focus:outline-none"></div>
        <div class="space-y-2">
            <button type="button" data-delete-submit disabled class="w-full rounded-xl bg-red-600 py-2.5 text-xs font-bold text-white transition-colors hover:bg-red-700 disabled:opacity-40">Confirmer la suppression définitive</button>
            <button type="button" data-modal-close class="w-full py-2 text-xs text-slate-500 hover:underline">Annuler</button>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
