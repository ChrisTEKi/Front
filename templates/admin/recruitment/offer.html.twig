{# Une offre d'emploi et ses candidats (/admin/recrutement/offres/{id}) : modifier, publier, clôturer, supprimer (seulement sans
   candidature), puis la liste des candidats (filtre d'état, tri par date de candidature, pages).
   Les formulaires [data-admin-form] et boutons [data-account-post] sont gérés par assets/admin-account.js ; le serveur décide de tout.
   Textes : translations/recruitment.<langue>.yaml (FR / EN / ES). #}
{% extends 'base.html.twig' %}
{% trans_default_domain 'recruitment' %}
{% import 'admin/recruitment/_ui.html.twig' as ui %}
{% block title %}{{ offer.title }} — {{ 'admin.page_title'|trans }}{% endblock %}

{% block body %}
{% set inputClass = 'w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs' %}
{% set labelClass = 'mb-1 block text-[11px] font-semibold text-slate-600' %}
{% set id = offer.id.toRfc4122 %}
{% set filters = {order: order}|merge(status ? {status: status.value} : {}) %}

<div data-admin-account data-recruitment-offer="{{ id }}" class="mx-auto max-w-5xl space-y-6 p-4 sm:p-6">
    <div class="space-y-3 rounded-3xl border border-slate-200/80 bg-white p-6 shadow-xs">
        <a href="{{ path('app_admin_recruitment') }}" class="text-[11px] font-semibold text-slate-500 hover:text-black">← {{ 'offer.back'|trans }}</a>
        <div class="flex flex-wrap items-start justify-between gap-2">
            <h1 class="text-xl font-bold text-slate-900">{{ offer.title }}</h1>
            <div class="flex flex-wrap gap-2">
                {{ ui.badge('offer', offer.status.value) }}
                {% if offer.status.value == 'open' and not isOpen %}<span data-offer-expired class="inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold text-amber-800">{{ 'offer.expired'|trans }}</span>{% endif %}
            </div>
        </div>
        <p class="text-[11px] text-slate-500">
            {{ ('contract.' ~ offer.contractType.value)|trans }}{% if offer.location %} · {{ offer.location }}{% endif %}{% if offer.department %} · {{ offer.department }}{% endif %}
            {% if offer.closingDate %} · {{ 'jobs.closing_on'|trans({'%date%': offer.closingDate|format_date('long', locale: app.request.locale, timezone: offer.closingDate.getTimezone().getName())}) }}{% endif %}
        </p>
        {% if isOpen and offer.status.value == 'open' %}
            <p class="text-[11px]"><a href="{{ path('app_job', {id: id}) }}" class="font-semibold text-emerald-700 underline underline-offset-2" target="_blank" rel="noopener">{{ 'offer.public_link'|trans }}</a></p>
        {% endif %}
        {{ ui.tabs('offers', can) }}
    </div>

    <p data-account-notice role="status" class="hidden rounded-2xl border p-3 text-xs"></p>

    {% if can['recruitment.manage'] %}
        <section class="space-y-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <h2 class="text-sm font-bold text-slate-900">{{ 'offer.edit'|trans }}</h2>
                <div class="flex flex-wrap gap-2">
                    {% if offer.status.value != 'open' %}
                        <button type="button" data-account-post="{{ path('admin_api_job_offer_status', {id: id}) }}" data-payload='{"action":"publish"}' data-confirm="{{ 'offer.confirm_publish'|trans }}" class="rounded-xl bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700">{{ 'offer.publish'|trans }}</button>
                    {% else %}
                        <button type="button" data-account-post="{{ path('admin_api_job_offer_status', {id: id}) }}" data-payload='{"action":"close"}' data-confirm="{{ 'offer.confirm_close'|trans }}" class="rounded-xl border border-amber-300 px-3 py-1.5 text-xs font-semibold text-amber-800 hover:bg-amber-50">{{ 'offer.close'|trans }}</button>
                    {% endif %}
                </div>
            </div>
            {{ include('admin/recruitment/_offer_form.html.twig', {offer: offer, prefix: 'edit', endpoint: path('admin_api_job_offer_update', {id: id}), done: 'offer.saved'|trans, submit: 'offer.save'|trans}) }}

            <form data-admin-form method="post" data-endpoint="{{ path('admin_api_job_offer_delete', {id: id}) }}" data-done="{{ 'offer.deleted'|trans }}" data-confirm="{{ 'offer.confirm_delete'|trans }}" class="space-y-2 rounded-2xl border border-rose-200 bg-rose-50/40 p-4" novalidate>
                <h3 class="text-xs font-bold text-rose-800">{{ 'offer.delete'|trans }}</h3>
                <p class="text-[11px] text-rose-900">{{ (all > 0 ? 'offer.delete_blocked' : 'offer.delete_help')|trans({'%count%': all}) }}</p>
                <div class="flex flex-wrap items-end gap-2">
                    <div class="min-w-48 flex-1">
                        <label class="{{ labelClass }}" for="offer-delete-pw">{{ 'confirm.password'|trans }}</label>
                        <input id="offer-delete-pw" type="password" name="password" autocomplete="current-password" required class="{{ inputClass }}" {{ all > 0 ? 'disabled' }}>
                    </div>
                    <button type="submit" {{ all > 0 ? 'disabled' }} class="rounded-xl bg-rose-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-rose-700 disabled:opacity-50">{{ 'offer.delete_submit'|trans }}</button>
                </div>
                <p data-form-message role="alert" class="hidden rounded-xl px-3 py-2 text-xs font-semibold"></p>
            </form>
        </section>
    {% endif %}

    <section class="space-y-3 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-sm font-bold text-slate-900">{{ 'candidates.title'|trans({'%count%': all}) }}</h2>
            <a href="{{ path('app_admin_recruitment_offer', {id: id}|merge(filters)|merge({order: order == 'desc' ? 'asc' : 'desc'})) }}" data-sort-toggle class="rounded-xl border border-slate-200 px-3 py-1.5 text-[11px] font-semibold text-slate-700 hover:bg-slate-50">{{ (order == 'desc' ? 'candidates.sort_newest' : 'candidates.sort_oldest')|trans }} ⇅</a>
        </div>

        <div class="flex flex-wrap gap-1.5 text-[11px] font-semibold">
            <a href="{{ path('app_admin_recruitment_offer', {id: id, order: order}) }}" class="rounded-full px-3 py-1 {{ status is null ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' }}">{{ 'candidates.filter_all'|trans }}</a>
            {% for s in statuses %}
                <a href="{{ path('app_admin_recruitment_offer', {id: id, order: order, status: s.value}) }}" class="rounded-full px-3 py-1 {{ status == s ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' }}">{{ ('status.application.' ~ s.value)|trans }}</a>
            {% endfor %}
        </div>

        {% if items is empty %}
            <p data-no-candidates class="text-xs text-slate-400">{{ 'candidates.none'|trans }}</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full border-collapse text-left text-xs">
                    <thead><tr class="border-b border-slate-200 text-[10px] font-bold uppercase text-slate-400">
                        <th class="px-3 py-2">{{ 'candidates.col.name'|trans }}</th><th class="px-3 py-2">{{ 'candidates.col.applied'|trans }}</th><th class="px-3 py-2">{{ 'candidates.col.status'|trans }}</th><th class="px-3 py-2">{{ 'candidates.col.interviews'|trans }}</th><th class="px-3 py-2">{{ 'candidates.col.contact'|trans }}</th>
                    </tr></thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for a in items %}
                            <tr data-candidate-row="{{ a.id.toRfc4122 }}">
                                <td class="px-3 py-2"><a href="{{ path('app_admin_recruitment_application', {id: a.id.toRfc4122}) }}" class="font-semibold text-slate-900 underline-offset-2 hover:underline">{{ a.fullName }}</a></td>
                                <td class="whitespace-nowrap px-3 py-2 text-slate-500">{{ a.createdAt|format_datetime('medium', 'short', locale: app.request.locale) }}</td>
                                <td class="px-3 py-2">{{ ui.badge('application', a.status.value) }}</td>
                                <td class="px-3 py-2 text-slate-600">{{ a.interviews|filter((i) => i.scheduled)|length }}</td>
                                <td class="px-3 py-2 text-slate-500"><span class="block">{{ a.email }}</span><span class="block">{{ a.phone }}</span></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {{ ui.paging(paging, 'app_admin_recruitment_offer', {id: id}|merge(filters)) }}
        {% endif %}
    </section>
</div>
{% endblock %}
