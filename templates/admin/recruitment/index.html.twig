{# Recrutement (/admin/recrutement) : toutes les offres d'emploi, leur état et le nombre de candidats, plus la création d'une offre.
   Les formulaires [data-admin-form] sont envoyés par assets/admin-account.js ; le serveur décide de tout (droits « recruitment.* »).
   Textes : translations/recruitment.<langue>.yaml (FR / EN / ES). #}
{% extends 'base.html.twig' %}
{% trans_default_domain 'recruitment' %}
{% import 'admin/recruitment/_ui.html.twig' as ui %}
{% block title %}{{ 'admin.page_title'|trans }}{% endblock %}

{% block body %}
<div data-admin-account data-recruitment-offers class="mx-auto max-w-5xl space-y-6 p-4 sm:p-6">
    <div class="space-y-3 rounded-3xl border border-slate-200/80 bg-white p-6 shadow-xs">
        <a href="{{ path('app_admin_dashboard') }}" class="text-[11px] font-semibold text-slate-500 hover:text-black">← {{ 'admin.back'|trans }}</a>
        <h1 class="text-xl font-bold text-slate-900">{{ 'admin.title'|trans }}</h1>
        <p class="max-w-2xl text-xs text-slate-500">{{ 'admin.subtitle'|trans }}</p>
        {{ ui.tabs('offers', can) }}
    </div>

    <p data-account-notice role="status" class="hidden rounded-2xl border p-3 text-xs"></p>

    {% if can['recruitment.manage'] %}
        <details class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xs" {{ rows is empty ? 'open' }}>
            <summary class="cursor-pointer text-sm font-bold text-slate-900">{{ 'offer.new'|trans }}</summary>
            <div class="pt-4">
                {{ include('admin/recruitment/_offer_form.html.twig', {offer: null, prefix: 'new', endpoint: path('admin_api_job_offer_create'), done: 'offer.created'|trans, submit: 'offer.create'|trans}) }}
            </div>
        </details>
    {% endif %}

    <section class="space-y-3 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs">
        <h2 class="text-sm font-bold text-slate-900">{{ 'offer.list'|trans }}</h2>
        {% if rows is empty %}
            <p data-no-offers class="text-xs text-slate-400">{{ 'offer.none'|trans }}</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full border-collapse text-left text-xs">
                    <thead><tr class="border-b border-slate-200 text-[10px] font-bold uppercase text-slate-400">
                        <th class="px-3 py-2">{{ 'offer.col.title'|trans }}</th><th class="px-3 py-2">{{ 'offer.col.contract'|trans }}</th><th class="px-3 py-2">{{ 'offer.col.status'|trans }}</th><th class="px-3 py-2">{{ 'offer.col.closing'|trans }}</th><th class="px-3 py-2 text-right">{{ 'offer.col.applications'|trans }}</th>
                    </tr></thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for row in rows %}
                            {% set offer = row.offer %}
                            <tr data-offer-row="{{ offer.id.toRfc4122 }}">
                                <td class="px-3 py-2"><a href="{{ path('app_admin_recruitment_offer', {id: offer.id.toRfc4122}) }}" class="font-semibold text-slate-900 underline-offset-2 hover:underline">{{ offer.title }}</a></td>
                                <td class="px-3 py-2 text-slate-600">{{ ('contract.' ~ offer.contractType.value)|trans }}</td>
                                <td class="px-3 py-2">{{ ui.badge('offer', offer.status.value) }}</td>
                                <td class="whitespace-nowrap px-3 py-2 text-slate-500">{{ offer.closingDate ? offer.closingDate|format_date('medium', locale: app.request.locale, timezone: offer.closingDate.getTimezone().getName()) : '—' }}</td>
                                <td class="px-3 py-2 text-right text-slate-700">{{ row.total }}{% if row.fresh > 0 %} <span class="ml-1 rounded-full bg-sky-100 px-1.5 py-0.5 text-[10px] font-bold text-sky-800">{{ 'offer.new_count'|trans({'%count%': row.fresh}) }}</span>{% endif %}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
