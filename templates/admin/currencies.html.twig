{# Devises (/admin/devises) : taux de change EUR / USD contre l'Ariary.
   Les formulaires [data-admin-form] sont envoyés par assets/admin-account.js à l'API /admin/api/devises/… ; le serveur décide de tout
   (droit « currency.manage », mot de passe de confirmation, validation du taux). Textes : translations/admin.<langue>.yaml (clés « currencies.* »). #}
{% extends 'base.html.twig' %}
{% trans_default_domain 'admin' %}
{% block title %}{{ 'currencies.page_title'|trans }}{% endblock %}

{% macro badge(text, tone) %}
    {% set tones = {green: 'bg-emerald-100 text-emerald-800', amber: 'bg-amber-100 text-amber-800', red: 'bg-rose-100 text-rose-800', slate: 'bg-slate-100 text-slate-700'} %}
    <span class="inline-flex whitespace-nowrap rounded-full px-2 py-0.5 text-[10px] font-bold {{ tones[tone]|default(tones.slate) }}">{{ text }}</span>
{% endmacro %}
{% import _self as ui %}

{% block body %}
{% set inputClass = 'w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs' %}
{% set labelClass = 'mb-1 block text-[11px] font-semibold text-slate-600' %}

<div data-admin-account data-admin-currencies class="mx-auto max-w-5xl space-y-6 p-4 sm:p-6">
    <div class="flex flex-col justify-between gap-3 rounded-3xl border border-slate-200/80 bg-white p-6 shadow-xs sm:flex-row sm:items-start">
        <div>
            <a href="{{ path('app_admin_dashboard') }}" class="text-[11px] font-semibold text-slate-500 hover:text-black">← {{ 'currencies.back'|trans }}</a>
            <h1 class="mt-1 text-xl font-bold text-slate-900">{{ 'currencies.title'|trans }}</h1>
            <p class="max-w-2xl text-xs text-slate-500">{{ 'currencies.subtitle'|trans }}</p>
        </div>
        <form data-admin-form method="post" data-endpoint="{{ path('admin_api_currency_refresh') }}" data-done="{{ 'currencies.refreshed'|trans }}" class="shrink-0 space-y-2" novalidate>
            <button type="submit" class="flex items-center gap-1.5 rounded-xl bg-indigo-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-indigo-700">{{ ux_icon('tabler:refresh', {class: 'h-3.5 w-3.5'}) }}{{ 'currencies.refresh'|trans }}</button>
            <p data-form-message role="alert" class="hidden rounded-xl px-3 py-1 text-[11px] font-semibold"></p>
        </form>
    </div>

    <p data-account-notice role="status" class="hidden rounded-2xl border p-3 text-xs"></p>

    <p class="rounded-2xl border border-amber-200 bg-amber-50 p-3 text-[11px] text-amber-900">{{ 'currencies.settlement_note'|trans }}</p>

    {% for r in rows %}
        <section class="space-y-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs" data-currency="{{ r.code }}">
            <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
                <div>
                    <h2 class="text-sm font-bold text-slate-900">{{ ('currencies.name.' ~ r.code)|trans }} ({{ r.code }})</h2>
                    {% if r.current %}
                        <p class="mt-1 font-mono text-lg font-black text-slate-950" data-current-rate>1 {{ r.symbol }} = {{ (r.current.rate + 0)|format_number({fraction_digit: 2}, locale: app.request.locale) }} Ar</p>
                        <p class="text-[11px] text-slate-500">
                            {{ ('currencies.source.' ~ r.current.source)|trans }} · {{ 'currencies.since'|trans }} {{ r.current.createdAt|format_datetime('medium', 'short', locale: app.request.locale) }}
                            {% if r.current.manual %}· {{ r.current.validUntil ? 'currencies.until'|trans({'%date%': r.current.validUntil|format_datetime('medium', 'short', locale: app.request.locale)}) : 'currencies.until_released'|trans }}{% endif %}
                        </p>
                    {% else %}
                        <p class="mt-1 text-xs font-semibold text-slate-500" data-no-rate>{{ 'currencies.no_rate'|trans({'%code%': r.code}) }}</p>
                    {% endif %}
                </div>
                <div class="flex flex-wrap gap-2">
                    {% if r.locked %}{{ ui.badge('currencies.badge.manual'|trans, 'amber') }}{% elseif r.current %}{{ ui.badge('currencies.badge.auto'|trans, 'green') }}{% else %}{{ ui.badge('currencies.badge.none'|trans, 'slate') }}{% endif %}
                    {% if r.stale %}{{ ui.badge('currencies.badge.stale'|trans, 'red') }}{% endif %}
                </div>
            </div>

            {% if r.stale %}<p class="rounded-xl bg-rose-50 p-2 text-[11px] text-rose-800">{{ 'currencies.stale_help'|trans }}</p>{% endif %}
            {% if r.locked %}<p class="rounded-xl bg-amber-50 p-2 text-[11px] text-amber-900">{{ 'currencies.locked_help'|trans }}</p>{% endif %}

            <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
                <form data-admin-form method="post" data-endpoint="{{ path('admin_api_currency_manual', {code: r.code}) }}" data-done="{{ 'currencies.saved'|trans }}" class="space-y-3 rounded-2xl border border-slate-200 p-4" novalidate>
                    <h3 class="text-xs font-bold text-slate-900">{{ 'currencies.manual.title'|trans }}</h3>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="col-span-2 sm:col-span-1">
                            <label class="{{ labelClass }}" for="rate-{{ r.code }}">{{ 'currencies.manual.rate'|trans({'%symbol%': r.symbol}) }}</label>
                            <input id="rate-{{ r.code }}" name="rate" inputmode="decimal" required placeholder="5000" class="{{ inputClass }}">
                        </div>
                        <div class="col-span-2 sm:col-span-1">
                            <label class="{{ labelClass }}" for="days-{{ r.code }}">{{ 'currencies.manual.days'|trans }}</label>
                            <input id="days-{{ r.code }}" type="number" name="days" min="1" max="365" class="{{ inputClass }}">
                        </div>
                    </div>
                    <div>
                        <label class="{{ labelClass }}" for="note-{{ r.code }}">{{ 'currencies.manual.note'|trans }}</label>
                        <input id="note-{{ r.code }}" name="note" maxlength="255" class="{{ inputClass }}">
                    </div>
                    <div>
                        <label class="{{ labelClass }}" for="pw-{{ r.code }}">{{ 'currencies.password'|trans }}</label>
                        <input id="pw-{{ r.code }}" type="password" name="password" autocomplete="current-password" required class="{{ inputClass }}">
                    </div>
                    <p class="text-[11px] text-slate-500">{{ 'currencies.manual.help'|trans }}</p>
                    <p data-form-message role="alert" class="hidden rounded-xl px-3 py-2 text-xs font-semibold"></p>
                    <button type="submit" class="rounded-xl bg-slate-900 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-black">{{ 'currencies.manual.submit'|trans }}</button>
                </form>

                <form data-admin-form method="post" data-endpoint="{{ path('admin_api_currency_auto', {code: r.code}) }}" data-done="{{ 'currencies.saved'|trans }}" class="space-y-3 rounded-2xl border border-slate-200 p-4" novalidate>
                    <h3 class="text-xs font-bold text-slate-900">{{ 'currencies.auto.title'|trans }}</h3>
                    <p class="text-[11px] text-slate-500">{{ 'currencies.auto.help'|trans }}</p>
                    <div>
                        <label class="{{ labelClass }}" for="pwa-{{ r.code }}">{{ 'currencies.password'|trans }}</label>
                        <input id="pwa-{{ r.code }}" type="password" name="password" autocomplete="current-password" required class="{{ inputClass }}">
                    </div>
                    <p data-form-message role="alert" class="hidden rounded-xl px-3 py-2 text-xs font-semibold"></p>
                    <button type="submit" class="rounded-xl border border-emerald-300 px-3.5 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-50">{{ 'currencies.auto.submit'|trans }}</button>
                </form>
            </div>

            <div>
                <h3 class="mb-2 text-xs font-bold text-slate-900">{{ 'currencies.history.title'|trans }}</h3>
                {% if r.history is empty %}
                    <p class="text-xs text-slate-400">{{ 'currencies.history.none'|trans }}</p>
                {% else %}
                    <div class="overflow-x-auto">
                        <table class="w-full border-collapse text-left text-xs">
                            <thead><tr class="border-b border-slate-200 text-[10px] font-bold uppercase text-slate-400"><th class="px-3 py-2">{{ 'currencies.history.date'|trans }}</th><th class="px-3 py-2">{{ 'currencies.history.rate'|trans }}</th><th class="px-3 py-2">{{ 'currencies.history.source'|trans }}</th><th class="px-3 py-2">{{ 'currencies.history.by'|trans }}</th><th class="px-3 py-2">{{ 'currencies.history.note'|trans }}</th></tr></thead>
                            <tbody class="divide-y divide-slate-100">
                                {% for h in r.history %}
                                    <tr>
                                        <td class="whitespace-nowrap px-3 py-2 text-slate-500">{{ h.createdAt|format_datetime('short', 'short', locale: app.request.locale) }}</td>
                                        <td class="px-3 py-2 font-mono font-semibold text-slate-900">{{ (h.rate + 0)|format_number({fraction_digit: 2}, locale: app.request.locale) }} Ar</td>
                                        <td class="px-3 py-2 text-slate-700">{{ ('currencies.source.' ~ h.source)|trans }}</td>
                                        <td class="px-3 py-2 text-slate-500">{{ h.createdBy ? h.createdBy.fullName : '—' }}</td>
                                        <td class="max-w-xs truncate px-3 py-2 text-slate-500" title="{{ h.note }}">{{ h.note ?: '—' }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </section>
    {% endfor %}

    <p class="text-center text-[11px] text-slate-400">{{ 'currencies.attribution'|trans }} <a href="https://www.exchangerate-api.com" rel="noopener noreferrer" class="underline hover:text-slate-600">exchangerate-api.com</a></p>
</div>
{% endblock %}
