{# Commissions (/admin/commissions) : taux de commission par rayon.
   Le formulaire [data-admin-form] est envoyé par assets/admin-account.js à POST /admin/api/commissions ; le serveur décide de tout
   (droit « commissions.manage », mot de passe de confirmation, validité de chaque taux). Textes : translations/admin.<langue>.yaml
   (clés « commissions.* »), noms des rayons : translations/messages.<langue>.yaml (clés « vendor.cat.* »). #}
{% extends 'base.html.twig' %}
{% trans_default_domain 'admin' %}
{% block title %}{{ 'commissions.page_title'|trans }}{% endblock %}

{% block body %}
{% set inputClass = 'w-24 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-right font-mono text-sm font-bold' %}
{% set keys = {} %}{% for r in rows %}{% set keys = keys|merge({(r.id): r.key}) %}{% endfor %}

<div data-admin-account class="mx-auto max-w-3xl space-y-6 p-4 sm:p-6">
    <div class="rounded-3xl border border-slate-200/80 bg-white p-6 shadow-xs">
        <a href="{{ path('app_admin_dashboard') }}" class="text-[11px] font-semibold text-slate-500 hover:text-black">← {{ 'commissions.back'|trans }}</a>
        <h1 class="mt-1 text-xl font-bold text-slate-900">{{ 'commissions.title'|trans }}</h1>
        <p class="max-w-2xl text-xs text-slate-500">{{ 'commissions.subtitle'|trans }}</p>
    </div>

    <p data-account-notice role="status" class="hidden rounded-2xl border p-3 text-xs"></p>

    <p class="rounded-2xl border border-amber-200 bg-amber-50 p-3 text-[11px] text-amber-900">{{ 'commissions.note'|trans }}</p>

    <form data-admin-form method="post" data-endpoint="{{ path('admin_api_commissions_save') }}" data-done="{{ 'commissions.saved'|trans }}" class="space-y-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs" novalidate>
        <div class="divide-y divide-slate-100">
            {% for r in rows %}
                <div class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between" data-commission-row="{{ r.id }}">
                    <div class="min-w-0">
                        <label for="rate-{{ r.id }}" class="flex items-center gap-2 text-sm font-bold text-slate-900"><span aria-hidden="true">{{ r.icon }}</span>{{ ('vendor.cat.' ~ r.key)|trans({}, 'messages') }}</label>
                        <p class="text-[11px] text-slate-400">
                            {% if r.updatedAt %}
                                {{ 'commissions.updated'|trans({'%who%': r.updatedBy ? r.updatedBy.fullName : '—', '%date%': r.updatedAt|format_datetime('medium', 'short', locale: app.request.locale)}) }}
                            {% else %}
                                {{ 'commissions.original'|trans({'%rate%': r.default|format_number({max_fraction_digit: 2}, locale: app.request.locale)}) }}
                            {% endif %}
                        </p>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        <input id="rate-{{ r.id }}" name="{{ r.id }}" value="{{ r.rate }}" inputmode="decimal" required autocomplete="off" aria-describedby="rate-help" class="{{ inputClass }}">
                        <span class="text-sm font-bold text-slate-500">%</span>
                    </div>
                </div>
            {% endfor %}
        </div>
        <p id="rate-help" class="text-[11px] text-slate-500">{{ 'commissions.help'|trans({'%max%': max}) }}</p>
        <div class="max-w-xs">
            <label for="commissions-password" class="mb-1 block text-[11px] font-semibold text-slate-600">{{ 'commissions.password'|trans }}</label>
            <input id="commissions-password" type="password" name="password" autocomplete="current-password" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs">
        </div>
        <p data-form-message role="alert" class="hidden rounded-xl px-3 py-2 text-xs font-semibold"></p>
        <button type="submit" class="rounded-xl bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-black">{{ 'commissions.submit'|trans }}</button>
    </form>

    <section class="space-y-3 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs">
        <h2 class="text-sm font-bold text-slate-900">{{ 'commissions.history.title'|trans }}</h2>
        {% if history is empty %}
            <p class="text-xs text-slate-400">{{ 'commissions.history.none'|trans }}</p>
        {% else %}
            <ul class="divide-y divide-slate-100 text-xs">
                {% for h in history %}
                    <li class="space-y-1 py-2.5">
                        <p class="text-slate-500">{{ h.at|format_datetime('medium', 'short', locale: app.request.locale) }} · {{ h.by ?: '—' }}</p>
                        <ul class="space-y-0.5 text-slate-800">
                            {% for c in h.changes %}
                                {% set key = keys[c.category]|default(null) %}
                                <li><strong>{{ key ? ('vendor.cat.' ~ key)|trans({}, 'messages') : c.category }}</strong> : {{ (c.from + 0)|format_number({max_fraction_digit: 2}, locale: app.request.locale) }} % → <span class="font-mono font-bold">{{ (c.to + 0)|format_number({max_fraction_digit: 2}, locale: app.request.locale) }} %</span></li>
                            {% endfor %}
                        </ul>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
</div>
{% endblock %}
