{# Liste noire (/admin/liste-noire) : e-mails, téléphones, noms, raisons sociales et adresses IP interdits d'inscription.
   Les formulaires [data-account-form] sont envoyés par assets/admin-account.js à l'API /admin/api/liste-noire ; le serveur décide de tout
   (droit « blacklist.manage », mot de passe de confirmation, normalisation et règles métier). Textes : translations/sanctions.<langue>.yaml. #}
{% extends 'base.html.twig' %}
{% trans_default_domain 'sanctions' %}
{% block title %}{{ 'blacklist.page_title'|trans }}{% endblock %}

{% block body %}
{% set inputClass = 'w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs' %}
{% set labelClass = 'mb-1 block text-[11px] font-semibold text-slate-600' %}

<div data-admin-account data-admin-blacklist class="mx-auto max-w-5xl space-y-6 p-4 sm:p-6">
    <div class="rounded-3xl border border-slate-200/80 bg-white p-6 shadow-xs">
        <a href="{{ path('app_admin_dashboard') }}" class="text-[11px] font-semibold text-slate-500 hover:text-black">← {{ 'account.back'|trans }}</a>
        <h1 class="mt-1 text-xl font-bold text-slate-900">{{ 'blacklist.title'|trans }}</h1>
        <p class="text-xs text-slate-500">{{ 'blacklist.subtitle'|trans }}</p>
    </div>

    <p data-account-notice role="status" class="hidden rounded-2xl border p-3 text-xs"></p>

    <form data-account-form data-endpoint="{{ path('admin_api_blacklist_add') }}" data-done="{{ 'sanction.done'|trans }}" class="space-y-3 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs" novalidate>
        <h2 class="text-sm font-bold text-slate-900">{{ 'blacklist.add'|trans }}</h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
            <div>
                <label class="{{ labelClass }}" for="bl-kind">{{ 'blacklist.kind'|trans }}</label>
                <select id="bl-kind" name="kind" class="{{ inputClass }}">
                    {% for k in kinds %}<option value="{{ k.value }}">{{ ('sanction.kind.' ~ k.value)|trans }}</option>{% endfor %}
                </select>
            </div>
            <div class="sm:col-span-2">
                <label class="{{ labelClass }}" for="bl-value">{{ 'blacklist.value'|trans }}</label>
                <input id="bl-value" name="value" maxlength="255" required class="{{ inputClass }}">
            </div>
            <div>
                <label class="{{ labelClass }}" for="bl-days">{{ 'blacklist.days'|trans({'%max%': maxIpDays}) }}</label>
                <input id="bl-days" type="number" name="days" min="1" max="3650" class="{{ inputClass }}">
            </div>
        </div>
        <div>
            <label class="{{ labelClass }}" for="bl-reason">{{ 'sanction.reason_internal'|trans }}</label>
            <textarea id="bl-reason" name="reason" rows="2" maxlength="500" required class="{{ inputClass }}"></textarea>
        </div>
        <div>
            <label class="{{ labelClass }}" for="bl-password">{{ 'sanction.password'|trans }}</label>
            <input id="bl-password" type="password" name="password" autocomplete="current-password" required class="{{ inputClass }}">
        </div>
        <p class="text-[11px] text-slate-500">{{ 'blacklist.help'|trans }}</p>
        <p data-form-message role="alert" class="hidden rounded-xl px-3 py-2 text-xs font-semibold"></p>
        <button type="submit" class="rounded-xl bg-rose-600 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-rose-700">{{ 'blacklist.submit'|trans }}</button>
    </form>

    <div class="space-y-3 rounded-3xl border border-slate-200 bg-white p-6 shadow-xs">
        <h2 class="text-sm font-bold text-slate-900">{{ 'blacklist.list'|trans({'%count%': entries|length}) }}</h2>
        {% if entries is empty %}
            <p class="text-xs text-slate-400">{{ 'blacklist.none'|trans }}</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full border-collapse text-left text-xs">
                    <thead><tr class="border-b border-slate-200 text-[10px] font-bold uppercase text-slate-400"><th class="px-3 py-2">{{ 'blacklist.col.kind'|trans }}</th><th class="px-3 py-2">{{ 'blacklist.col.value'|trans }}</th><th class="px-3 py-2">{{ 'blacklist.col.reason'|trans }}</th><th class="px-3 py-2">{{ 'blacklist.col.until'|trans }}</th><th class="px-3 py-2"></th></tr></thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for e in entries %}
                            <tr data-blacklist-entry="{{ e.id }}">
                                <td class="px-3 py-2 font-semibold text-slate-700">{{ ('sanction.kind.' ~ e.kind.value)|trans }}</td>
                                <td class="px-3 py-2 font-mono text-[11px] text-slate-900">{{ e.value }}</td>
                                <td class="max-w-xs truncate px-3 py-2 text-slate-500" title="{{ e.reason }}">{{ e.reason }}</td>
                                <td class="whitespace-nowrap px-3 py-2 text-slate-500">{{ e.expiresAt ? e.expiresAt|format_date('medium', locale: app.request.locale) : 'blacklist.forever'|trans }}</td>
                                <td class="px-3 py-2 text-right">
                                    <form data-account-form data-endpoint="{{ path('admin_api_blacklist_remove', {id: e.id}) }}" data-done="{{ 'sanction.done'|trans }}" data-confirm="{{ 'blacklist.confirm_remove'|trans }}" class="flex flex-wrap items-center justify-end gap-2" novalidate>
                                        <input type="password" name="password" autocomplete="current-password" required placeholder="{{ 'sanction.password_short'|trans }}" aria-label="{{ 'sanction.password'|trans }}" class="w-32 rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 text-[11px]">
                                        <button type="submit" class="rounded-lg border border-slate-300 px-2.5 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-100">{{ 'blacklist.remove'|trans }}</button>
                                        <p data-form-message role="alert" class="hidden w-full rounded-xl px-3 py-1 text-left text-[11px] font-semibold"></p>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
