{% extends 'base.html.twig' %}

{% block title %}{{ product ? 'Modifier un produit' : 'Nouveau produit' }} — Admin GoBuy{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl space-y-5 p-4 sm:p-6">
    <div class="flex items-center justify-between gap-3">
        <div>
            <h1 class="text-xl font-bold text-slate-900">{{ product ? 'Modifier le produit' : 'Créer un produit' }}</h1>
            <p class="mt-1 text-xs text-slate-500">Le produit sera associé à une catégorie et à un fournisseur approuvé.</p>
        </div>
        <a href="{{ path('app_admin_dashboard', {tab: 'products_table'}) }}" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50">Retour au catalogue</a>
    </div>

    {% for error in errors %}
        <div role="alert" class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800">{{ error }}</div>
    {% endfor %}

    <form method="post" class="space-y-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-xs sm:p-6">
        <input type="hidden" name="_token" value="{{ csrf_token('product-save-' ~ (product.id|default('new'))) }}">

        <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-1.5 sm:col-span-2">
                <label for="product-name" class="text-xs font-semibold text-slate-700">Nom du produit</label>
                <input id="product-name" name="name" value="{{ values.name }}" required maxlength="180" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/15">
            </div>

            <div class="space-y-1.5 sm:col-span-2">
                <label for="product-description" class="text-xs font-semibold text-slate-700">Description</label>
                <textarea id="product-description" name="description" rows="4" required class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/15">{{ values.description }}</textarea>
            </div>

            <div class="space-y-1.5">
                <label for="product-price" class="text-xs font-semibold text-slate-700">Prix (Ar)</label>
                <input id="product-price" name="price" type="number" min="0" step="0.01" value="{{ values.price }}" required class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/15">
            </div>

            <div class="space-y-1.5">
                <label for="product-stock" class="text-xs font-semibold text-slate-700">Stock</label>
                <input id="product-stock" name="stock" type="number" min="0" step="1" value="{{ values.stock }}" required class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/15">
            </div>

            <div class="space-y-1.5">
                <label for="product-category" class="text-xs font-semibold text-slate-700">Catégorie</label>
                <select id="product-category" name="category_id" required class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/15">
                    <option value="">Sélectionner une catégorie</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}" {% if values.category_id == category.id %}selected{% endif %}>{{ category.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="space-y-1.5">
                <label for="product-supplier" class="text-xs font-semibold text-slate-700">Fournisseur approuvé</label>
                <select id="product-supplier" name="supplier_id" required class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/15">
                    <option value="">Sélectionner un fournisseur</option>
                    {% for supplier in suppliers %}
                        <option value="{{ supplier.id }}" {% if values.supplier_id == supplier.id %}selected{% endif %}>{{ supplier.shop_name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="space-y-1.5">
                <label for="product-status" class="text-xs font-semibold text-slate-700">Statut</label>
                <select id="product-status" name="status" required class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/15">
                    <option value="draft" {% if values.status == 'draft' %}selected{% endif %}>Brouillon</option>
                    <option value="active" {% if values.status == 'active' %}selected{% endif %}>Actif</option>
                    <option value="archived" {% if values.status == 'archived' %}selected{% endif %}>Archivé</option>
                </select>
            </div>
        </div>

        <div class="flex flex-wrap justify-end gap-2 border-t border-slate-100 pt-4">
            <a href="{{ path('app_admin_dashboard', {tab: 'products_table'}) }}" class="rounded-lg border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50">Annuler</a>
            <button type="submit" class="rounded-lg bg-emerald-600 px-4 py-2 text-xs font-semibold text-white hover:bg-emerald-700">{{ product ? 'Enregistrer les modifications' : 'Créer le produit' }}</button>
        </div>
    </form>
</div>
{% endblock %}
