{#
 | Envoyé quand quelqu'un tente de créer un compte avec une adresse DÉJÀ inscrite.
 | Pourquoi : à l'écran, la réponse est identique pour une adresse nouvelle ou existante (un tiers ne peut pas
 | découvrir qui est client chez nous). Le vrai titulaire de l'adresse, lui, est informé ici et orienté vers
 | « Se connecter » / « Mot de passe oublié ».
 | Variables : login_url, reset_url.
 #}
{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;">{{ 'already_registered.title'|trans({}, 'emails') }}</h1>
    <p style="margin:0 0 12px;">{{ 'greeting'|trans({'%name%': recipient_name}, 'emails') }}</p>
    <p style="margin:0 0 24px;">{{ 'already_registered.intro'|trans({}, 'emails') }}</p>
    <p style="margin:0 0 16px;text-align:center;">
        <a href="{{ login_url }}" style="display:inline-block;background:#06C167;color:#FFFFFF;text-decoration:none;font-weight:700;border-radius:999px;padding:14px 32px;">{{ 'already_registered.login'|trans({}, 'emails') }}</a>
    </p>
    <p style="margin:0 0 12px;text-align:center;"><a href="{{ reset_url }}" style="color:#06C167;font-weight:600;">{{ 'already_registered.reset'|trans({}, 'emails') }}</a></p>
    <p style="margin:0;color:#6B7280;">{{ 'already_registered.ignore'|trans({}, 'emails') }}</p>
{% endblock %}
