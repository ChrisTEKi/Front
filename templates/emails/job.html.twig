{#
 | E-mail de recrutement envoyé à un candidat (accusé de réception, refus, convocation, changement ou annulation d'entretien).
 | Variables : kind (type de message), params (valeurs insérées : %name%, %offer%, %date%, %time%…), note (phrase facultative de l'équipe).
 | Textes : translations/emails.<langue>.yaml → job.<kind>.title / body. Le message est adressé au NOM du candidat.
 #}
{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;">{{ ('job.' ~ kind ~ '.title')|trans(params, 'emails') }}</h1>
    <p style="margin:0 0 12px;">{{ 'greeting'|trans({'%name%': recipient_name}, 'emails') }}</p>
    <p style="margin:0 0 12px;white-space:pre-line;">{{ ('job.' ~ kind ~ '.body')|trans(params, 'emails') }}</p>
    {% if note %}
        <p style="margin:0 0 12px;white-space:pre-line;"><strong>{{ 'job.note_label'|trans({}, 'emails') }}</strong> {{ note }}</p>
    {% endif %}
    <p style="margin:0;color:#6B7280;">{{ 'job.contact'|trans({}, 'emails') }}</p>
{% endblock %}
