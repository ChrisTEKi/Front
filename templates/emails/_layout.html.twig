{#
 | Gabarit de base de TOUS les e-mails GoBuy (HTML).
 |
 | Les clients de messagerie (Outlook, Gmail…) ignorent une grande partie du CSS moderne :
 | on utilise donc des tableaux et des styles « en ligne » (style="…") plutôt que Tailwind.
 | Couleurs = celles de la charte (assets/styles/app.css) : noir #000, vert GoBuy #06C167, gris doux #F6F6F6.
 |
 | Variables disponibles (ajoutées par TransactionalMailer) : locale, recipient_name.
 #}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>{{ app_name }}</title>
</head>
<body style="margin:0;padding:0;background:#F6F6F6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#000000;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#F6F6F6;">
    <tr>
        <td align="center" style="padding:24px 12px;">
            <table role="presentation" width="560" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:560px;background:#FFFFFF;border-radius:16px;overflow:hidden;">
                {# --- En-tête : logo textuel --- #}
                <tr>
                    <td style="background:#000000;padding:20px 28px;font-size:26px;font-weight:900;letter-spacing:-0.5px;">
                        <span style="color:#06C167;">Go</span><span style="color:#FFFFFF;">Buy</span>
                    </td>
                </tr>
                {# --- Contenu propre à chaque e-mail --- #}
                <tr>
                    <td style="padding:28px;font-size:15px;line-height:1.6;color:#111111;">
                        {% block content %}{% endblock %}
                    </td>
                </tr>
                {# --- Pied de page commun --- #}
                <tr>
                    <td style="padding:0 28px 28px;font-size:12px;line-height:1.5;color:#6B7280;">
                        {{ 'layout.footer'|trans({}, 'emails') }}
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
