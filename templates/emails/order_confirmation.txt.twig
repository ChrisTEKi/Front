{{ 'order_confirmation.subtotal'|trans({}, 'emails') }} : {{ money(order.chargedSubtotal, order.currency.value, order.locale) }}
{{ 'order_confirmation.delivery'|trans({}, 'emails') }} : {{ money(order.chargedDeliveryFee, order.currency.value, order.locale) }}
{{ 'order_confirmation.total'|trans({}, 'emails') }} : {{ money(order.chargedTotal, order.currency.value, order.locale) }}
{% if order.foreignCurrency %}{{ 'order_confirmation.settlement'|trans({'%amount%': money(order.total, 'MGA', order.locale), '%rate%': exchange_rate(order.exchangeRate, order.locale), '%symbol%': currency_symbol(order.currency.value)}, 'emails') }}
{% endif %}
{{ 'order_confirmation.address'|trans({}, 'emails') }} :
{{ order.shippingAddress.fullName }}
{{ order.shippingAddress.street }}
{{ order.shippingAddress.city }}{% if order.shippingAddress.postalCode %} {{ order.shippingAddress.postalCode }}{% endif %}


{{ 'order_confirmation.payment'|trans({}, 'emails') }} : {% if order.paymentMethod.value == 'mobile_money' %}{{ 'order_confirmation.method.mobile_money'|trans({'%carrier%': order.paymentCarrier ? order.paymentCarrier.label : ''}, 'emails') }}{% elseif order.paymentMethod.value == 'card' %}{{ 'order_confirmation.method.card'|trans({}, 'emails') }}{% else %}{{ 'order_confirmation.method.cash_on_delivery'|trans({}, 'emails') }}{% endif %}

{% if order.installmentsCount > 1 %}{{ 'order_confirmation.installments'|trans({'%count%': order.installmentsCount, '%amount%': (order.total / order.installmentsCount)|round|number_format(0, ',', ' ')}, 'emails') }}
{% endif %}

