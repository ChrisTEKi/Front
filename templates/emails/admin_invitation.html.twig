{#
 | Invitation d'un nouvel administrateur : lien à usage unique, valable 48 h, pour choisir son mot de passe.
 | Variables : link (URL absolue contenant le jeton secret), days.
 #}
{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;">{{ 'admin_invitation.title'|trans({}, 'emails') }}</h1>
    <p style="margin:0 0 12px;">{{ 'greeting'|trans({'%name%': recipient_name}, 'emails') }}</p>
    <p style="margin:0 0 24px;">{{ 'admin_invitation.intro'|trans({}, 'emails') }}</p>
    <p style="margin:0 0 24px;text-align:center;">
        <a href="{{ link }}" style="display:inline-block;background:#06C167;color:#FFFFFF;text-decoration:none;font-weight:700;border-radius:999px;padding:14px 32px;">{{ 'admin_invitation.button'|trans({}, 'emails') }}</a>
    </p>
    <p style="margin:0 0 12px;">{{ 'admin_invitation.validity'|trans({'%days%': days}, 'emails') }}</p>
    <p style="margin:0 0 12px;color:#6B7280;word-break:break-all;">{{ 'admin_invitation.fallback'|trans({}, 'emails') }}<br>{{ link }}</p>
    <p style="margin:0;color:#6B7280;">{{ 'admin_invitation.ignore'|trans({}, 'emails') }}</p>
{% endblock %}
