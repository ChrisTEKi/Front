{#
 | Décision de l'équipe GoBuy communiquée à un compte (produit retiré, catalogue retiré, dossier réexaminé…).
 | Variables : kind (clé du message), params (valeurs insérées : %detail%, %count%…).
 | Textes : translations/emails.<langue>.yaml → moderation.<kind>.title / body.
 #}
{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;">{{ ('moderation.' ~ kind ~ '.title')|trans(params, 'emails') }}</h1>
    <p style="margin:0 0 12px;">{{ 'greeting'|trans({'%name%': recipient_name}, 'emails') }}</p>
    <p style="margin:0 0 12px;white-space:pre-line;">{{ ('moderation.' ~ kind ~ '.body')|trans(params, 'emails') }}</p>
    <p style="margin:0;color:#6B7280;">{{ 'moderation.contact'|trans({}, 'emails') }}</p>
{% endblock %}
