{#
 | E-mail contenant un code à 6 chiffres à recopier.
 | Variables : purpose (clé de finalité, ex. « email_verification »), code, minutes.
 | Textes : translations/emails.<langue>.yaml → otp.<purpose>.title / intro, otp.validity, otp.never_share, otp.ignore.
 #}
{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;">{{ ('otp.' ~ purpose ~ '.title')|trans({}, 'emails') }}</h1>
    <p style="margin:0 0 12px;">{{ 'greeting'|trans({'%name%': recipient_name}, 'emails') }}</p>
    <p style="margin:0 0 20px;">{{ ('otp.' ~ purpose ~ '.intro')|trans({}, 'emails') }}</p>

    {# Le code, bien visible, avec une police à chasse fixe pour éviter de confondre 0/O ou 1/l. #}
    <p style="margin:0 0 20px;text-align:center;">
        <span style="display:inline-block;background:#EAF7EE;border:2px solid #06C167;border-radius:12px;padding:14px 28px;font-family:'SFMono-Regular',Consolas,'Liberation Mono',Menlo,monospace;font-size:34px;font-weight:700;letter-spacing:8px;color:#000000;">{{ code }}</span>
    </p>

    <p style="margin:0 0 12px;">{{ 'otp.validity'|trans({'%minutes%': minutes}, 'emails') }}</p>
    <p style="margin:0 0 12px;font-weight:600;">{{ 'otp.never_share'|trans({}, 'emails') }}</p>
    <p style="margin:0;color:#6B7280;">{{ 'otp.ignore'|trans({}, 'emails') }}</p>
{% endblock %}
