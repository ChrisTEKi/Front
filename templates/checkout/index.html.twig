{% extends 'base.html.twig' %}
{% block title %}{{ 'checkout.page_title'|trans }}{% endblock %}

{#
   Validation de la commande (réservée aux CLIENTS connectés : règle d'accès /commande ; un visiteur est renvoyé vers /connexion
   puis revient ici).

   Le panier vit dans le navigateur (assets/cart.js) : ce gabarit n'affiche donc que la structure, assets/checkout.js la remplit.
   Règles appliquées AVANT de payer (toutes re-vérifiées par le serveur, voir OrderService) :
     - téléphone mobile du compte vérifié par SMS (obligatoire avant la 1re commande) ;
     - numéro Mobile Money vérifié par SMS (pour 3x/4x par Mobile Money et paiement comptant Mobile Money).
   Aucune donnée de carte bancaire n'est saisie sur ce site : le paiement par carte relève du prestataire de paiement.
#}
{% block body %}
<div class="flex justify-center p-2 sm:p-6">
<div data-checkout data-phone-verified="{{ phoneVerified ? '1' : '0' }}"
     data-endpoints="{{ {phoneSend: path('payment_phone_send'), phoneVerify: path('payment_phone_verify'), momoSend: path('payment_momo_send'), momoVerify: path('payment_momo_verify'), place: path('order_place'), home: path('app_home')}|json_encode }}"
     class="relative flex w-full max-w-xl flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl">

    <div class="flex items-center justify-between border-b border-slate-100 bg-white px-5 py-4">
        <div class="flex items-center gap-2.5">
            <button type="button" data-checkout-back class="hidden rounded-xl p-1.5 text-slate-600 transition-colors hover:bg-slate-100" title="{{ 'checkout.back_address'|trans }}" aria-label="{{ 'checkout.back_address'|trans }}">{{ ux_icon('tabler:arrow-left', { class: 'h-4 w-4' }) }}</button>
            <div>
                <h2 class="text-base font-black text-slate-950">{{ 'checkout.title'|trans }}</h2>
                <p class="text-[11px] text-slate-500">{{ 'checkout.subtitle'|trans }}</p>
            </div>
        </div>
        <a href="{{ path('app_home') }}" aria-label="{{ 'common.close'|trans }}" class="rounded-full p-2 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-900">{{ ux_icon('tabler:x', { class: 'h-5 w-5' }) }}</a>
    </div>

    {# Progress #}
    <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50 px-6 py-2.5 text-xs">
        <div class="flex items-center gap-2 font-bold text-slate-950">
            <span data-step-dot="1" class="flex h-5 w-5 items-center justify-center rounded-full bg-slate-950 font-mono text-[10px] text-white">1</span><span>{{ 'checkout.step_address'|trans }}</span>
        </div>
        <div class="mx-4 h-px flex-1 bg-slate-200"></div>
        <div data-step-label="2" class="flex items-center gap-2 text-slate-400">
            <span data-step-dot="2" class="flex h-5 w-5 items-center justify-center rounded-full bg-slate-200 font-mono text-[10px] text-slate-500">2</span><span>{{ 'checkout.step_payment'|trans }}</span>
        </div>
    </div>

    <div class="space-y-5 p-5">

        {# Panier vide : on garde le simulateur d'échéancier (montant saisi à la main), mais on ne peut pas commander. #}
        <div data-empty-cart class="hidden space-y-2 rounded-2xl border border-amber-200 bg-amber-50 p-3.5 text-xs text-amber-900">
            <div class="flex items-start gap-2">{{ ux_icon('tabler:alert-circle', { class: 'mt-0.5 h-4 w-4 shrink-0 text-amber-600' }) }}<span><strong>{{ 'checkout.empty_title'|trans }}</strong> {{ 'checkout.empty_text'|trans }}</span></div>
            <label class="flex items-center gap-2 pl-6"><span class="font-semibold">{{ 'checkout.amount'|trans }}</span>
                <input type="number" min="0" step="1000" value="0" data-preview-amount class="w-36 rounded-xl border border-amber-200 bg-white px-3 py-1.5 font-mono text-xs text-slate-900 focus:border-slate-950 focus:outline-none"></label>
            <a href="{{ path('app_home') }}" class="ml-6 inline-block font-semibold text-amber-900 underline">{{ 'cart.explore'|trans }}</a>
        </div>

        {# ============ ÉTAPE 1 — ADRESSE ============ #}
        {# `addresses` : le carnet d'adresses du client, l'adresse PAR DÉFAUT en premier. Elle est préremplie ; il peut en choisir une autre ou en saisir une nouvelle. #}
        {% set lastAddress = addresses is empty ? null : addresses[0] %}
        <div data-step="1" class="space-y-4" data-default-name="{{ user.fullName }}">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">{{ ux_icon('tabler:map-pin', { class: 'h-4 w-4 text-slate-900' }) }}<h3 class="text-sm font-bold text-slate-950">{{ 'checkout.delivery_address'|trans }}</h3></div>
                <button type="button" data-address-edit class="text-xs font-semibold text-slate-900 hover:underline">{{ 'checkout.change'|trans }}</button>
            </div>

            {% if addresses is not empty %}
            <div data-saved-addresses class="space-y-2">
                <p class="text-[11px] font-semibold text-slate-500">{{ 'checkout.saved_addresses'|trans }}</p>
                {% for addr in addresses %}
                    <button type="button" data-saved-address="{{ addr|json_encode|e('html_attr') }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}" class="flex w-full items-start gap-2.5 rounded-2xl border p-3 text-left text-xs transition-colors {{ loop.first ? 'border-slate-950 bg-white ring-1 ring-slate-950' : 'border-slate-200 bg-white hover:border-slate-400' }}">
                        <span data-saved-dot class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border {{ loop.first ? 'border-slate-950 bg-slate-950' : 'border-slate-300' }}"><span class="h-1.5 w-1.5 rounded-full bg-white"></span></span>
                        <span class="min-w-0 flex-1">
                            <span class="flex flex-wrap items-center gap-1.5">
                                <span class="font-bold text-slate-950">{{ addr.label ?: addr.fullName }}</span>
                                {% if addr.isDefault %}<span class="rounded-full bg-emerald-100 px-1.5 py-0.5 text-[10px] font-bold text-emerald-700">{{ 'account.addresses.default_badge'|trans }}</span>{% endif %}
                            </span>
                            <span class="mt-0.5 block text-slate-600">{{ addr.street }}, {{ addr.city }}{% if addr.postalCode %} {{ addr.postalCode }}{% endif %}</span>
                        </span>
                    </button>
                {% endfor %}
                <button type="button" data-new-address class="flex w-full items-center justify-center gap-1.5 rounded-2xl border border-dashed border-slate-300 bg-white p-2.5 text-xs font-semibold text-slate-700 transition-colors hover:border-slate-950 hover:text-slate-950">{{ ux_icon('tabler:plus', { class: 'h-3.5 w-3.5' }) }}<span>{{ 'checkout.new_address'|trans }}</span></button>
            </div>
            {% endif %}

            <div data-address-summary class="{{ lastAddress ? '' : 'hidden ' }}space-y-1 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-xs">
                <div class="flex items-center justify-between gap-2">
                    <p class="font-bold text-slate-950" data-sum-name>{{ lastAddress ? lastAddress.fullName : '' }}</p>
                    <span data-phone-badge class="inline-flex shrink-0 items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold {{ phoneVerified ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-200 text-slate-700' }}">{{ phoneVerified ? '✓ ' ~ ('checkout.phone_verified'|trans) : ('checkout.phone_to_verify'|trans) }}</span>
                </div>
                <p class="font-medium text-slate-600" data-sum-street>{{ lastAddress ? lastAddress.street : '—' }}</p>
                <p class="font-medium text-slate-600"><span data-sum-city>{{ lastAddress ? lastAddress.city : 'Antananarivo' }}</span> <span data-sum-postal>{{ (lastAddress and lastAddress.postalCode) ? lastAddress.postalCode : (lastAddress ? '' : '101') }}</span></p>
                <p class="flex items-center gap-1 pt-1 font-mono text-slate-500">{{ ux_icon('tabler:device-mobile', { class: 'h-3.5 w-3.5 text-slate-400' }) }}<span data-sum-phone>{{ (lastAddress and lastAddress.phone) ? lastAddress.phone : (user.phone|default('checkout.no_phone'|trans)) }}</span></p>
            </div>

            <div data-address-form class="{{ lastAddress ? 'hidden ' : '' }}space-y-3 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-xs">
                <div><label class="mb-1 block font-semibold text-slate-700">{{ 'checkout.f_name'|trans }}</label>
                    <input type="text" name="fullName" autocomplete="name" maxlength="150" value="{{ lastAddress ? lastAddress.fullName : user.fullName }}" placeholder="{{ 'checkout.f_name_ph'|trans }}" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-xs text-slate-900 focus:border-slate-950 focus:outline-none"></div>
                <div><label class="mb-1 block font-semibold text-slate-700">{{ 'checkout.f_phone'|trans }}</label>
                    <input type="tel" name="phone" autocomplete="tel" value="{{ (lastAddress and lastAddress.phone) ? lastAddress.phone : user.phone }}" placeholder="{{ 'checkout.f_phone_ph'|trans }}" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 font-mono text-xs text-slate-900 focus:border-slate-950 focus:outline-none"></div>
                <div><label class="mb-1 block font-semibold text-slate-700">{{ 'checkout.f_street'|trans }}</label>
                    <input type="text" name="street" autocomplete="street-address" maxlength="255" value="{{ lastAddress ? lastAddress.street : '' }}" placeholder="{{ 'checkout.f_street_ph'|trans }}" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-xs text-slate-900 focus:border-slate-950 focus:outline-none"></div>
                <div class="grid grid-cols-2 gap-2">
                    <div><label class="mb-1 block font-semibold text-slate-700">{{ 'checkout.f_city'|trans }}</label>
                        <input type="text" name="city" maxlength="100" value="{{ lastAddress ? lastAddress.city : 'Antananarivo' }}" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-xs text-slate-900 focus:border-slate-950 focus:outline-none"></div>
                    <div><label class="mb-1 block font-semibold text-slate-700">{{ 'checkout.f_postal'|trans }}</label>
                        <input type="text" name="postalCode" maxlength="10" value="{{ (lastAddress and lastAddress.postalCode) ? lastAddress.postalCode : (lastAddress ? '' : '101') }}" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-xs text-slate-900 focus:border-slate-950 focus:outline-none"></div>
                </div>
                <div><label class="mb-1 block font-semibold text-slate-700">{{ 'checkout.f_note'|trans }}</label>
                    <textarea rows="2" name="courierNote" maxlength="500" placeholder="{{ 'checkout.f_note_ph'|trans }}" class="w-full resize-none rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-xs text-slate-900 focus:border-slate-950 focus:outline-none">{{ lastAddress ? lastAddress.instructions : '' }}</textarea></div>
            </div>

            {# Options de la NOUVELLE adresse saisie (cachées quand on utilise une adresse déjà enregistrée). #}
            <div data-save-options class="{{ lastAddress ? 'hidden ' : '' }}space-y-2 text-xs">
                <label class="flex items-center gap-2.5 rounded-xl border border-slate-200 bg-white p-3 font-semibold text-slate-800"><input type="checkbox" name="saveAddress" checked class="h-4 w-4 rounded border-slate-300 text-slate-950"><span>{{ 'checkout.save_address'|trans }}</span></label>
                <label class="flex items-center gap-2.5 rounded-xl border border-slate-200 bg-white p-3 font-semibold text-slate-800"><input type="checkbox" name="makeDefaultAddress" {{ lastAddress ? '' : 'checked' }} class="h-4 w-4 rounded border-slate-300 text-slate-950"><span>{{ 'checkout.make_default'|trans }}</span></label>
            </div>

            <p data-address-error role="alert" class="hidden rounded-xl border border-red-100 bg-red-50 p-3 text-xs text-red-700"></p>

            <div data-phone-reminder class="{{ phoneVerified ? 'hidden ' : '' }}flex cursor-pointer items-start gap-2.5 rounded-2xl border border-slate-200 bg-slate-100 p-3 text-xs text-slate-700">
                {{ ux_icon('tabler:alert-circle', { class: 'mt-0.5 h-4 w-4 shrink-0 text-slate-900' }) }}
                <div><span class="font-bold text-slate-950">{{ 'checkout.sms_required'|trans }}</span> {{ 'checkout.sms_required_text'|trans }}</div>
            </div>

            <button type="button" data-step1-next class="flex w-full items-center justify-center gap-2 rounded-2xl bg-slate-950 px-6 py-3.5 text-xs font-bold text-white shadow-sm transition-all hover:bg-slate-800">
                <span>{{ 'checkout.continue'|trans }}</span>{{ ux_icon('tabler:arrow-right', { class: 'h-4 w-4' }) }}
            </button>
        </div>

        {# ============ ÉTAPE 2 — PAIEMENT ============ #}
        <div data-step="2" class="hidden space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="text-sm font-black text-slate-950">{{ 'checkout.payment_method'|trans }}</h3>
                <span class="font-mono text-[11px] text-slate-500">{{ 'checkout.secure'|trans }}</span>
            </div>

            {# --- Option 1 : 3x / 4x --- #}
            <div data-pay="installments" class="cursor-pointer rounded-2xl border-2 border-slate-950 bg-white p-4 shadow-sm ring-1 ring-slate-950 transition-all">
                <div class="flex items-start justify-between gap-3">
                    <div class="flex items-start gap-3">
                        <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-950 text-[#00E5A3]">{{ ux_icon('tabler:stack-2', { class: 'h-5 w-5' }) }}</span>
                        <div>
                            <div class="flex flex-wrap items-center gap-2">
                                <p class="text-xs font-black text-slate-950">{{ 'checkout.inst_title'|trans }}</p>
                                <span class="rounded-md bg-slate-950 px-2 py-0.5 font-mono text-[10px] font-bold text-[#00E5A3]">{{ 'checkout.inst_zero'|trans }}</span>
                                <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-700">{{ 'checkout.recommended'|trans }}</span>
                            </div>
                            <p class="mt-0.5 text-[11px] text-slate-500">{{ 'checkout.inst_text'|trans }}</p>
                        </div>
                    </div>
                    <span data-radio class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-950 bg-slate-950"><span class="h-2 w-2 rounded-full bg-[#00E5A3]"></span></span>
                </div>

                <div data-pay-body class="mt-4 cursor-default space-y-4 border-t border-slate-200 pt-4">
                    <div>
                        <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-500">{{ 'checkout.inst_choose'|trans }}</label>
                        <div class="grid grid-cols-2 gap-2.5">
                            {% for n in [3, 4] %}
                                <button type="button" data-installments="{{ n }}" class="rounded-xl border p-3 text-left transition-all {{ n == 3 ? 'border-slate-950 bg-slate-950 text-white shadow-xs' : 'border-slate-200 bg-slate-50 text-slate-800 hover:bg-slate-100' }}">
                                    <div class="flex items-center justify-between"><span class="text-xs font-black">{{ 'checkout.in_n_times'|trans({'%n%': n}) }}</span>
                                        <span data-inst-badge class="rounded px-1.5 py-0.5 font-mono text-[10px] {{ n == 3 ? 'bg-white/15 text-[#00E5A3]' : 'bg-slate-200 text-slate-700' }}">{{ 'checkout.zero_fees'|trans }}</span></div>
                                    <div class="mt-1 font-mono text-sm font-bold"><span data-inst-monthly="{{ n }}">0</span> Ar <span class="text-[10px] font-normal opacity-80">{{ 'checkout.per_month'|trans }}</span></div>
                                </button>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="space-y-3 rounded-2xl border border-slate-200 bg-slate-50 p-3.5">
                        <div class="flex items-center justify-between text-xs">
                            <span class="flex items-center gap-1.5 font-black text-slate-950">{{ ux_icon('tabler:calendar', { class: 'h-3.5 w-3.5 text-slate-700' }) }}<span data-schedule-title></span></span>
                            <span class="font-mono text-[10px] font-bold text-slate-500">{{ 'checkout.taeg'|trans }}</span>
                        </div>
                        <div data-schedule class="space-y-2 pt-1"></div>
                        <div class="flex items-center justify-between border-t border-slate-200/70 pt-2 text-[11px] font-medium text-slate-600">
                            <span>{{ 'checkout.total_financing'|trans }}</span><span class="font-mono font-bold text-slate-950"><span data-total-text>0</span> Ar</span>
                        </div>
                    </div>

                    <div class="space-y-2.5">
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500">{{ 'checkout.channel'|trans }}</label>
                        <div class="grid grid-cols-2 gap-2">
                            <button type="button" data-channel="mobile_money" class="flex items-center justify-center gap-2 rounded-xl border border-slate-950 bg-slate-950 px-3 py-2 text-xs font-bold text-white transition-all">{{ ux_icon('tabler:device-mobile', { class: 'h-3.5 w-3.5' }) }}<span>{{ 'checkout.mobile_money'|trans }}</span></button>
                            <button type="button" data-channel="card" class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700 transition-all hover:bg-slate-50">{{ ux_icon('tabler:credit-card', { class: 'h-3.5 w-3.5' }) }}<span>{{ 'checkout.card'|trans }}</span></button>
                        </div>
                        <div data-channel-panel="mobile_money" class="space-y-2 rounded-xl border border-slate-200 bg-slate-50 p-3">
                            <label class="block text-[11px] font-semibold text-slate-700">{{ 'checkout.momo_label'|trans }}</label>
                            <div class="relative">
                                <input type="text" inputmode="tel" data-momo-input="installments" placeholder="{{ 'checkout.momo_ph'|trans }}" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 font-mono text-xs font-medium text-slate-900 focus:border-slate-950 focus:outline-none">
                                <span data-momo-badge class="absolute right-3 top-1/2 hidden -translate-y-1/2 rounded bg-slate-950 px-2 py-0.5 font-mono text-[10px] font-bold text-[#00E5A3]"></span>
                            </div>
                            <p data-momo-msg class="text-[11px] text-slate-500">{{ 'checkout.momo_hint'|trans }}</p>
                        </div>
                        <div data-channel-panel="card" class="hidden space-y-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
                            <div class="flex items-center justify-between font-semibold text-slate-700"><span>{{ 'checkout.card_inst_title'|trans }}</span><span class="font-mono text-[10px] text-slate-500">Visa / Mastercard</span></div>
                            <p class="text-[11px] text-slate-500">{{ 'checkout.card_note'|trans }}</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-2 border-t border-slate-200/80 pt-2 text-[11px] text-slate-600 sm:grid-cols-3">
                        {% for c in ['checkout.perk1', 'checkout.perk2', 'checkout.perk3'] %}
                            <div class="flex items-center gap-1.5">{{ ux_icon('tabler:check', { class: 'h-3.5 w-3.5 shrink-0 text-slate-900' }) }}<span>{{ c|trans }}</span></div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# --- Option 2 : Mobile Money comptant --- #}
            <div data-pay="mobile_money" class="cursor-pointer rounded-2xl border-2 border-slate-200 bg-white p-4 transition-all hover:border-slate-300">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 text-slate-800">{{ ux_icon('tabler:device-mobile', { class: 'h-5 w-5' }) }}</span>
                        <div><p class="text-xs font-bold text-slate-950">{{ 'checkout.momo_title'|trans }}</p><p class="text-[11px] text-slate-500">{{ 'checkout.momo_sub'|trans }}</p></div>
                    </div>
                    <span data-radio class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-300"></span>
                </div>
                <div data-pay-body class="mt-4 hidden cursor-default space-y-2 border-t border-slate-200 pt-3">
                    <label class="block text-[11px] font-semibold text-slate-700">{{ 'checkout.momo_direct'|trans }}</label>
                    <div class="relative">
                        <input type="text" inputmode="tel" data-momo-input="mobile_money" placeholder="{{ 'checkout.momo_ph'|trans }}" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 font-mono text-xs font-medium text-slate-900 focus:border-slate-950 focus:outline-none">
                        <span data-momo-badge class="absolute right-3 top-1/2 hidden -translate-y-1/2 rounded bg-slate-950 px-2 py-0.5 font-mono text-[10px] font-bold text-[#00E5A3]"></span>
                    </div>
                    <p data-momo-msg class="text-[11px] text-slate-500">{{ 'checkout.momo_enter'|trans }}</p>
                </div>
            </div>

            {# --- Option 3 : Carte (aucune donnée de carte n'est saisie sur ce site) --- #}
            <div data-pay="card" class="cursor-pointer rounded-2xl border-2 border-slate-200 bg-white p-4 transition-all hover:border-slate-300">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 text-slate-800">{{ ux_icon('tabler:credit-card', { class: 'h-5 w-5' }) }}</span>
                        <div><p class="text-xs font-bold text-slate-950">{{ 'checkout.card_title'|trans }}</p><p class="text-[11px] text-slate-500">{{ 'checkout.card_sub'|trans }}</p></div>
                    </div>
                    <span data-radio class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-300"></span>
                </div>
                <div data-pay-body class="mt-3 hidden border-t border-slate-200 pt-3"><p class="text-[11px] text-slate-500">{{ 'checkout.card_note'|trans }}</p></div>
            </div>

            {# --- Option 4 : Cash --- #}
            <div data-pay="cash_on_delivery" class="cursor-pointer rounded-2xl border-2 border-slate-200 bg-white p-4 transition-all hover:border-slate-300">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 text-slate-800">{{ ux_icon('tabler:cash', { class: 'h-5 w-5' }) }}</span>
                        <div><p class="text-xs font-bold text-slate-950">{{ 'checkout.cash_title'|trans }}</p><p class="text-[11px] text-slate-500">{{ 'checkout.cash_sub'|trans }}</p></div>
                    </div>
                    <span data-radio class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-300"></span>
                </div>
            </div>

            {# --- Récap --- #}
            <div class="space-y-2 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-xs">
                <div class="flex justify-between text-slate-500"><span data-sum-items-label></span><span class="font-mono"><span data-sum-subtotal>0</span> Ar</span></div>
                <div class="flex justify-between text-slate-500"><span>{{ 'checkout.shipping_fee'|trans }}</span><span class="font-mono"><span data-sum-shipping>0</span> Ar</span></div>
                <div class="flex justify-between border-t border-slate-200 pt-2 text-sm font-bold text-slate-950"><span>{{ 'checkout.order_total'|trans }}</span><span class="font-mono"><span data-sum-total>0</span> Ar</span></div>
                <div data-installment-recap class="space-y-1 rounded-xl border bg-white p-2.5">
                    <div class="flex justify-between text-xs font-bold text-slate-950"><span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-[#00E5A3]"></span>{{ 'checkout.debited_today'|trans }}</span><span class="font-mono text-sm" data-first-payment>0 Ar</span></div>
                    <div class="flex justify-between text-[11px] text-slate-500"><span>{{ 'checkout.remaining'|trans }}</span><span class="font-mono" data-remaining>—</span></div>
                </div>
            </div>

            <p data-checkout-notice role="alert" class="hidden rounded-xl border border-red-100 bg-red-50 p-3 text-xs text-red-700"></p>

            <button type="button" data-confirm-order class="flex w-full items-center justify-center gap-2 rounded-2xl bg-slate-950 px-6 py-4 text-xs font-bold text-white shadow-md transition-all hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50">
                {{ ux_icon('tabler:shield-check', { class: 'h-4 w-4 text-[#00E5A3]' }) }}<span data-confirm-label>{{ 'checkout.confirm'|trans }}</span>
            </button>
        </div>
    </div>

    {# Fenêtre de vérification par SMS : sert au téléphone du compte ET au numéro Mobile Money (data-verify-kind). #}
    <div data-verify-modal class="pointer-events-none fixed inset-0 z-[60] hidden items-center justify-center bg-slate-950/70 p-4 backdrop-blur-xs">
        <div class="pointer-events-auto w-full max-w-sm space-y-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-2xl" role="dialog" aria-modal="true" aria-labelledby="verify-title">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-slate-900">{{ ux_icon('tabler:phone-call', { class: 'h-6 w-6' }) }}</div>
            <div class="text-center"><h3 id="verify-title" class="text-sm font-bold text-slate-950" data-verify-title></h3>
                <p class="mt-1 text-xs text-slate-500" data-verify-text></p></div>

            <div data-verify-step="send" class="space-y-3">
                <label class="block text-[11px] font-semibold text-slate-700"><span data-verify-number-label></span>
                    <input type="tel" data-verify-number autocomplete="tel" class="mt-1 w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-center font-mono text-sm focus:border-slate-950 focus:outline-none">
                </label>
                <button type="button" data-verify-send class="w-full rounded-xl bg-slate-950 py-3 text-xs font-bold text-white shadow-sm transition-colors hover:bg-slate-800 disabled:opacity-50">{{ 'checkout.otp_get'|trans }}</button>
                <button type="button" data-verify-cancel class="w-full py-2 text-xs text-slate-500 hover:underline">{{ 'checkout.otp_cancel'|trans }}</button>
            </div>

            <div data-verify-step="code" class="hidden space-y-3">
                <div class="rounded-xl border border-slate-200 bg-slate-100 p-2.5 text-center text-[11px] font-medium text-slate-800" data-verify-sent></div>
                <div><label class="mb-1 block text-[11px] font-semibold text-slate-700">{{ 'checkout.otp_code'|trans }}</label>
                    <input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" data-verify-code placeholder="123456" class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2 text-center font-mono text-lg tracking-widest focus:border-slate-950 focus:outline-none"></div>
                <button type="button" data-verify-confirm class="w-full rounded-xl bg-slate-950 py-3 text-xs font-bold text-white shadow-sm transition-colors hover:bg-slate-800 disabled:opacity-50" data-label-phone="{{ 'checkout.otp_confirm_phone'|trans }}" data-label-momo="{{ 'checkout.otp_confirm_momo'|trans }}"></button>
                <button type="button" data-verify-resend class="w-full text-[11px] font-semibold text-emerald-600 hover:underline disabled:cursor-not-allowed disabled:text-slate-400 disabled:no-underline">{{ 'otp.resend'|trans({}, 'js') }}</button>
                <button type="button" data-verify-cancel class="w-full py-1 text-xs text-slate-500 hover:underline">{{ 'checkout.otp_cancel'|trans }}</button>
            </div>
            <p data-verify-error role="alert" class="hidden rounded-xl border border-red-100 bg-red-50 p-2.5 text-center text-[11px] text-red-700"></p>
        </div>
    </div>
</div>
</div>
{% endblock %}
