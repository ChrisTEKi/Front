# =============================================================================
# .env — valeurs PAR DÉFAUT (versionnées). Aucun vrai secret ici.
# Les vraies valeurs (secrets, mots de passe, clés API) vont dans .env.local
# (non versionné) ou dans les secrets Symfony : `php bin/console secrets:set NOM`.
# =============================================================================

###> symfony/framework-bundle ###
# dev | test | prod
APP_ENV=dev
# Secret aléatoire (>= 32 caractères) : signe CSRF, cookies, liens signés.
# Générer : php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=changeme_generate_a_real_secret
# IP/CIDR des reverse-proxys de confiance (ex: 10.0.0.0/8) pour lire la vraie IP client.
# Vide = on ne fait confiance à aucun en-tête X-Forwarded-*.
TRUSTED_PROXIES=
###< symfony/framework-bundle ###

# URL publique du site (liens dans les e-mails, URLs de retour Google/Apple).
DEFAULT_URI=http://localhost:8000

###> doctrine/doctrine-bundle ###
# PostgreSQL. Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HÔTE:PORT/BASE?serverVersion=16&charset=utf8
# (correspond au docker-compose.yml fourni — à changer en production !)
DATABASE_URL="postgresql://postgres:1412@127.0.0.1:5432/DoMada?serverVersion=15&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Serveur SMTP. En dev : Mailpit (docker-compose) — interface web sur http://localhost:8025
# En prod : smtp://USER:PASS@smtp.exemple.com:587  (ou ses://, sendgrid://, mailgun://…)
MAILER_DSN="smtp://445f968a7c9e24:0aead9c2d0232f@sandbox.smtp.mailtrap.io:2525"
# Expéditeur des e-mails (OTP, confirmation de commande…).
MAILER_FROM_EMAIL=craharison3@gmail.com
MAILER_FROM_NAME=GoBuy
###< symfony/mailer ###

###> symfony/notifier (SMS) ###
# Passerelle SMS. null://null = aucun SMS réellement envoyé (dev). Les codes sont alors
# visibles dans les logs (voir APP_OTP_LOG_CODES).
# Exemples : twilio://SID:TOKEN@default?from=+1555XXXXXXX
#            infobip://TOKEN@HOST?from=GoBuy   (nécessite le pont symfony/infobip-notifier)
TEXTER_DSN=null://null
###< symfony/notifier ###

###> Connexion rapide Google / Apple (laisser vide = bouton désactivé) ###
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple : "Services ID" (client id), Team ID, Key ID et chemin du fichier .p8 (clé privée).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
###< Connexion rapide Google / Apple ###

###> Sécurité de l'espace administrateur ###
# Liste d'IP/CIDR autorisées à accéder à /admin, séparées par des virgules.
# Vide = aucune restriction. Ex : 41.204.0.0/16,203.0.113.7
ADMIN_ALLOWED_IPS=
###< Sécurité de l'espace administrateur ###

###> Support ###
# Numéro WhatsApp du support GoBuy, chiffres uniquement avec l'indicatif (ex. 261XXXXXXXXX). Vide = le lien WhatsApp est masqué.
GOBUY_SUPPORT_WHATSAPP=
# Adresse e-mail du support GoBuy : reçoit les messages du formulaire de contact, les réclamations, les candidatures spontanées
# et les avis du site. Vide = ces formulaires sont masqués (on n'affiche jamais un formulaire qui n'enverrait rien).
GOBUY_SUPPORT_EMAIL=
# Identité légale de l'éditeur, affichée dans « Centre d'information » (À propos / Mentions légales).
# Chaque ligne vide est simplement masquée : aucune valeur n'est inventée. À renseigner avec les VRAIES informations de la société.
GOBUY_COMPANY_ADDRESS=
GOBUY_COMPANY_NIF=
GOBUY_COMPANY_STAT=
GOBUY_COMPANY_RCS=
###< Support ###

###> OTP ###
# 1 = écrire les codes OTP en clair dans les logs (DEV UNIQUEMENT, jamais en production).
APP_OTP_LOG_CODES=1
###< OTP ###
