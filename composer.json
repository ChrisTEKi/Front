{
    "type": "project",
    "license": "proprietary",
    "description": "GoBuy — front-end web (Symfony 8 / Twig / Tailwind CSS / JavaScript)",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3",
        "symfony/asset": "8.*",
        "symfony/asset-mapper": "8.*",
        "symfony/console": "8.*",
        "symfony/doctrine-messenger": "8.*",
        "symfony/dotenv": "8.*",
        "symfony/expression-language": "8.*",
        "symfony/flex": "^2",
        "symfony/form": "8.*",
        "symfony/framework-bundle": "8.*",
        "symfony/http-client": "8.*",
        "symfony/intl": "8.*",
        "symfony/mailer": "8.*",
        "symfony/mime": "8.*",
        "symfony/monolog-bundle": "^3.0|^4.0",
        "symfony/notifier": "8.*",
        "symfony/process": "8.*",
        "symfony/property-access": "8.*",
        "symfony/property-info": "8.*",
        "symfony/runtime": "8.*",
        "symfony/security-bundle": "8.*",
        "symfony/serializer": "8.*",
        "symfony/stimulus-bundle": "^3.5",
        "symfony/string": "8.*",
        "symfony/translation": "8.*",
        "symfony/twig-bundle": "8.*",
        "symfony/ux-icons": "*",
        "symfony/ux-turbo": "^3.5",
        "symfony/validator": "8.*",
        "symfony/web-link": "8.*",
        "symfony/yaml": "8.*",
        "symfonycasts/tailwind-bundle": "*",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^2.12|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "symfony/browser-kit": "8.*",
        "symfony/css-selector": "8.*",
        "symfony/debug-bundle": "8.*",
        "symfony/maker-bundle": "^1.0",
        "symfony/stopwatch": "8.*",
        "symfony/web-profiler-bundle": "8.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "tailwind:build": "symfony-cmd"
        },
        "post-install-cmd": ["@auto-scripts"],
        "post-update-cmd": ["@auto-scripts"]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.*"
        }
    }
}
