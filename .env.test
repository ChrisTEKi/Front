# Environnement de tests automatisés (phpunit).
# La base de tests est celle de DATABASE_URL (.env) + le suffixe « _test » (voir config/packages/doctrine.yaml) :
# gobuy → gobuy_test. Elle est vidée/recréée par les tests : ne jamais y mettre de données utiles.
APP_ENV=test
APP_SECRET=test_secret_test_secret_test_secret_test_secret
MAILER_DSN=null://null
TEXTER_DSN=null://null
APP_OTP_LOG_CODES=0
ADMIN_ALLOWED_IPS=
GOOGLE_CLIENT_ID=test-google-client
GOOGLE_CLIENT_SECRET=test-google-secret
# Apple de test : clé EC jetable générée pour les tests (ne protège rien, aucun accès réel).
APPLE_CLIENT_ID=test-apple-service
APPLE_TEAM_ID=TESTTEAM01
APPLE_KEY_ID=TESTKEY001
APPLE_PRIVATE_KEY_PATH=tests/Fixtures/apple_test_key.p8
GOBUY_SUPPORT_EMAIL=support@gobuy.test
GOBUY_COMPANY_ADDRESS=
GOBUY_COMPANY_NIF=
GOBUY_COMPANY_STAT=
GOBUY_COMPANY_RCS=
